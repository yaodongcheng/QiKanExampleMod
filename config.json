{
  // ══════════════════════════════════════════════════════════════
  // 玩法键位配置（键名 = 玩法 ID；删行/改值即改键，控制台 custom.input_reload 热重载生效）
  //
  // ── Gamepad 用"逻辑键"命名（Xbox 惯例），PS 玩家对照表：──────
  //    Y  = △ 三角     A  = ✕ 叉       X  = □ 方块     B  = ○ 圆圈
  //    LB = L1         RB = R1         LT = L2          RT = R2
  //    L3 = 左摇杆按下  R3 = 右摇杆按下
  //    DUp/DDown/DLeft/DRight = 十字键 上 / 下 / 左 / 右
  //    View = 触控板    Menu = Options
  //    PS 玩家也可直接写 PS 名（Triangle / Cross / Square / Circle
  //    / L1 / R1 / L2 / R2 / Options…），与 Xbox 名等价；显示时按当前
  //    手柄自动切换字形（配置写 Y，Xbox 显示 Y、PS 显示 △）。
  //
  // ── PressMode：Short=短按（快速按下松开即触发）/ Long=长按（按住蓄力，
  //    进度框满后变金色待命，松手才执行——可等目标转身/目击者走开再出手）
  // ── HoldMs：可选，单独调该玩法的长按阈值（毫秒）；0 或省略 = 用全局
  //    LongPressDurationMs
  // ══════════════════════════════════════════════════════════════
  "ShowDebugMessages": false,
  "WitnessSystemEnabled": true,
  // ══════════════════════════════════════════════════════════════
  // 顶部罗盘（MCM「显示罗盘」总开关在游戏内 Mod 选项里改，这里只配置任务图标）：
  //   ShowCompassIcons  罗盘任务图标开关（默认 true）：false = 只留刻度带与方向字母，
  //                     不带重要人物（有任务）图标与距离文本。MCM 不提供此项（2026-08-20
  //                     用户裁定跟随罗盘总开关），高级玩家改这里。
  // ══════════════════════════════════════════════════════════════
  "ShowCompassIcons": true,
  // ══════════════════════════════════════════════════════════════
  // IM 传讯系统（聊天面板，热键 M，2026-08-23 O→M）数值配置
  //
  // ImGroupFollowUpChance  群聊跟随回复概率（0~1）：主回复者之外第二人跟一句的概率，默认 0.06
  // ImBounceChance         斗嘴往返概率（0~1）：跟随者回应后主回复者再回一句的概率，默认 0.25
  // ImReplyCooldownSeconds 单 NPC 回复冷却（墙钟秒）：防连发刷爆 LLM 限流，默认 5
  // ImHeatHotThreshold     互动热度分档阈值：热度 ≥ 此值 = 高频互动 → 该 NPC 记忆容量最大档
  // ImHeatNormalThreshold  互动热度分档阈值：热度 ≥ 此值 = 普通档（现状容量）；以下 = 冷门小容量
  // ImHeatDecayPerDay      每游戏日热度衰减量（互动多者保持档位，久不互动自然降档）
  // AutonomyProposalEnabled  NPC 自主行动提议开关（默认 false）：玩家对 NPC 说话后，NPC 可能主动
  //   提议「我想去…」（巡逻/望风/讨账等）→ 卡片批准后走计划管线。默认关闭（体验易出戏，
  //   2026-08-13 用户裁定）；开启后仍有纯寒暄门控——命令/计划消息不会触发提议。
  // ══════════════════════════════════════════════════════════════
  "ImGroupFollowUpChance": 0.06,
  "ImBounceChance": 0.25,
  "ImReplyCooldownSeconds": 5,
  "ImHeatHotThreshold": 10,
  "ImHeatNormalThreshold": 3,
  "ImHeatDecayPerDay": 1,
  "AutonomyProposalEnabled": false,
  // ══════════════════════════════════════════════════════════════
  // 友方定义（玩家改这里）——修改后保存即生效（下次启动读取）
  //
  // MCM「允许对友方使用敌意互动」开关（默认开启，保持原行为）**关闭**后，
  // 击晕/偷窃/搜刮/主动攻击 将不能作用于被定义为「友方」的角色。
  // 此列表定义什么是「友方」，可组合多个：
  //   "Party"   = 同队伍（随从、玩家部队成员）
  //   "Clan"    = 同家族（家族成员）
  //   "Kingdom" = 同王国（本国子民/友军）
  // 默认 = 同队伍 + 同家族。示例：
  //   连同王国的人也不能碰 → ["Party", "Clan", "Kingdom"]
  //   只想保护随从         → ["Party"]
  //   不想要任何保护       → 到游戏内 MCM 打开开关（而不是清空此列表）
  //
  // 另外：无论此开关状态，友方看到你对别人（非友方）犯罪都会无动于衷——
  // 不加警戒、不围观质问、不告发作证、不帮忙护外人；只有你侵害友方本人时
  // 他们才会有反应。玩家与非友方战斗时，友方会一致对外帮忙。
  // ══════════════════════════════════════════════════════════════
  "FriendlyRelationCriteria": ["Party", "Clan"],
  // 好感度友方阈值（数值自己设）：对你好感 >= 此值的角色也视为友方（仅对有名有姓的
  // 英雄生效；模板士兵/村民无个人好感值）。默认 50；好感上限 100，
  // 不需要此规则时设 101（永远达不到，等于关闭）。
  // 与其他条件为「或」关系：任意一条满足就算友方——比如别的王国的英雄
  // 但只要对你好感够，同样算友方。
  "FriendlyRelationThreshold": 50,
  "DisabledInteractionMissionModes": ["Conversation", "Battle", "Duel", "Tournament", "Stealth", "Barter", "Deployment", "Replay", "CutScene", "Benchmark"],
  "Interactions": {
    "Talk":            { "Keyboard": "F",     "Gamepad": "Y",  "PressMode": "Short" },
    "Loot":            { "Keyboard": "F",     "Gamepad": "Y",  "PressMode": "Long" },
    "Knockout":        { "Keyboard": "F",     "Gamepad": "Y",  "PressMode": "Long" },
    "Pickpocket":      { "Keyboard": "F",     "Gamepad": "Y",  "PressMode": "Long" },
    "StealAnimal":     { "Keyboard": "F",     "Gamepad": "Y",  "PressMode": "Long" },
    "Lockpick":        { "Keyboard": "F",     "Gamepad": "Y",  "PressMode": "Long" },
    "PlayerSurrender": { "Keyboard": "F",     "Gamepad": "Y",  "PressMode": "Long" },
    "AcceptSurrender": { "Keyboard": "Q",     "Gamepad": "LB", "PressMode": "Long" },
    "Inspect":         { "Keyboard": "H",     "Gamepad": "R3", "PressMode": "Short" },
    "StealAttempt":    { "Keyboard": "Space", "Gamepad": "A",  "PressMode": "Short" },
    "StealLeave":      { "Keyboard": "Tab",   "Gamepad": "B",  "PressMode": "Short" },
    // 密令：Plot（对随从下自然语言命令）/ StopPlan（对执行中的随从喊停），同键互斥显示
    //   ——空闲随从旁显示 Plot，执行中的随从旁显示 StopPlan；入口还受 MCM「Action Orders」开关控制（默认关）
    "Plot":            { "Keyboard": "G",     "Gamepad": "LB", "PressMode": "Long" },
    "StopPlan":        { "Keyboard": "G",     "Gamepad": "LB", "PressMode": "Long" },
    // IM 传讯：打开聊天面板（战场/对话中禁开；打开后关闭用 ESC / 手柄 B / 点面板外或关闭按钮——
    // 注意 M 只负责打开，避免打字时误关。手柄 ↑ 十字短按 = 面板外唯一呼出键（2026-08-17）。
    // 🔴 2026-08-23（用户裁定：O→M）：O=原版 Cheer（口哨），M 全分类零绑定（唯一空闲字母键，
    // BannerlordGameKeys.xml 逐分类核查）；长按不用 = O/↑ 长按弹原版表情菜单无法拦截。
    // 定居点菜单内：手柄 ↑ 自动屏蔽（菜单导航键冲突，显示+触发双屏蔽），键盘 M 照常。
    "IM":              { "Keyboard": "M",     "Gamepad": "LUp", "PressMode": "Short" }
    // 可选：单独调阈值，如击晕想更久： "Knockout": { ..., "HoldMs": 600 }
  },
  "LongPressDurationMs": 650
}
