<?xml version="1.0" encoding="utf-8"?>
<Module>
  <Name value="Living World NPCs"/>
  <Id value="LivingWorldNpcs"/>
  <Version value="v1.1.0.1"/>
  <SingleplayerModule value="true"/>
  <MultiplayerModule value="false"/>
  <DependedModules>
    <DependedModule Id="Native"/>
    <DependedModule Id="SandBoxCore"/>
    <DependedModule Id="Sandbox"/>
    <DependedModule Id="CustomBattle"/>
    <DependedModule Id="StoryMode"/>
    <DependedModule Id="Bannerlord.Harmony"/>
    <DependedModule Id="Bannerlord.ButterLib"/>
    <DependedModule Id="Bannerlord.UIExtenderEx"/>
    <DependedModule Id="Bannerlord.MBOptionScreen"/>
  </DependedModules>
  <SubModules>
    <SubModule>
      <Name value="LivingWorldNpcs"/>
      <DLLName value="LivingWorldNpcs.dll"/>
      <SubModuleClassType value="LivingWorldNpcs.MySubModule"/>
      <Tags>
        <Tag key="DedicatedServerType" value="none"/>
        <Tag key="IsNoRenderModeElement" value="false"/>
      </Tags>
    </SubModule>
  </SubModules>
  <!-- 🔴 2026-10-09 新增：通用玩法的物品定义段（钩索 2 件）。

       ⚠️ 2026-10-23：**混天绫（`items/ribbon`）已取消注册** —— 布料模拟没做通，
          它不再是一件物品（文件已删）。飞行开关改回 MCM Mod 选项（`Settings.FlightEnabled`）。

       🔴 2026-10-12 改法：**逐文件列出**（原来是整目录 `<XmlName id="Items" path="items"/>`）——
          引擎遇到"目录"会把该目录下每个 `*.xml` 都当物品**无条件**加载（反编译实锤：
          `MBObjectManager.GetMergedXmlForManaged` 里是 `GetFiles("*.xml")`），
          而**法术体系的 7 件物品（`items/spells.xml`）未发布、默认关**，必须做到"引擎压根看不见它"。
          ⇒ 所以这里**故意不列 `items/spells`**：开关打开时改由 C# 现场注册
            （`ExampleModVS/ExampleMod/ExampleMod/Combat/SpellSystemGate.cs`，开关 = config.json 的
             `SpellSystemEnabled`，默认 false）。
          ⚠️ **以后往 `ModuleData/items/` 加文件，必须回来加一行** —— 漏了 = 文件在磁盘上、游戏里没有。
             这条有脚本把守：`python Scripts/check_module_registration.py`（"孤儿数据文件"那条）。

       🔴 故意**不写 IncludedGameTypes** —— 两条理由：
         ① 本模块是 `<SingleplayerModule value="true"/>`，多人局根本不会加载它，
            所以"无白名单 = 所有 GameType"不会污染联机物品表；
         ② 将来接新内容包（三国…）时**不用回来改这里**。写白名单就得把 TaikouCampaign* 一族
            乃至未来所有战役类名都列进来，那是把内容包的名字焊进基座。
       反例记档：Taikou 的 BannerIcons 段也是这么处理的（那边是因为加载时机更早、判不出 GameType）。
       判据（首次实机核这条）：进游戏 `custom.grapple equip` 能发出钩索 = 段被加载。 -->
  <Xmls>
    <!-- 路径不带扩展名：引擎按 `<模块>/ModuleData/<path>.xml` 解析（与 Native 的 `path="items/items"` 同款） -->
    <XmlNode>
      <XmlName id="Items" path="items/grapple" />
    </XmlNode>
    <!-- ⚠️ `items/spells` 故意不在这 —— 法术体系未发布、默认关，由 SpellSystemGate 按需注册（见上） -->
  </Xmls>
</Module>
