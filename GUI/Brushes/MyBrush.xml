	<!-- 🔴 2026-08-15（密信通知）：密信图标（阴谋任务插图），与忍者（back_alley）区分；
	     外层装饰环 = BlankWhiteCircleOutlined 暗金（ImSecretNotify.xml） -->
	<!-- 🔴 2026-08-15（缩略模式）：缩略/放大图标笔刷（用户裁定资源：StdAssets minus/plus_button_*，77x77）。
	     🔴 2026-08-15 修复（图标暗沉灰/hover 无反应）：改用单 layer + Style 换 Sprite 模式
	     （Brush_CircleButton_NinjaReport 验证过——Style 里可以换 Sprite；多 layer 写法样式切换不可靠） -->
	<Brush Name="LWN_Btn_Collapse">
        <Layers>
            <BrushLayer Name="Default" Sprite="StdAssets\minus_button_default"/>
        </Layers>
        <Styles>
            <Style Name="Default"><BrushLayer Name="Default"/></Style>
            <Style Name="Hovered"><BrushLayer Name="Default" Sprite="StdAssets\minus_button_hover"/></Style>
            <Style Name="Pressed"><BrushLayer Name="Default" Sprite="StdAssets\minus_button_pressed"/></Style>
        </Styles>
    </Brush>
	<Brush Name="LWN_Btn_Expand">
        <Layers>
            <BrushLayer Name="Default" Sprite="StdAssets\plus_button_default"/>
        </Layers>
        <Styles>
            <Style Name="Default"><BrushLayer Name="Default"/></Style>
            <Style Name="Hovered"><BrushLayer Name="Default" Sprite="StdAssets\plus_button_hover"/></Style>
            <Style Name="Pressed"><BrushLayer Name="Default" Sprite="StdAssets\plus_button_pressed"/></Style>
        </Styles>
    </Brush>
	<!-- 🔴 2026-08-15（缩略模式频道下拉项底色）：自绘下拉项笔刷——原版 Standard.DropdownItem
	     Default 透明（用户裁定要有深色底）。状态层由按钮 UpdateChildrenStates 传播
	     （ButtonWidget.RefreshState：Disabled/Selected/Pressed/Hovered/Default）：
	     深蓝灰底 → hover 提亮 → pressed 更亮 → 选中暗金。 -->
	<Brush Name="LWN_DropdownItem">
        <Layers>
            <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9"/>
        </Layers>
        <Styles>
            <Style Name="Default"><BrushLayer Name="Default" Color="#2A2A3AEE"/></Style>
            <Style Name="Hovered"><BrushLayer Name="Default" Color="#465A8AEE"/></Style>
            <Style Name="Pressed"><BrushLayer Name="Default" Color="#5E72B0EE"/></Style>
            <Style Name="Selected"><BrushLayer Name="Default" Color="#8A6A2BEE"/></Style>
            <Style Name="Disabled"><BrushLayer Name="Default" Color="#2A2A3A66"/></Style>
        </Styles>
    </Brush>
