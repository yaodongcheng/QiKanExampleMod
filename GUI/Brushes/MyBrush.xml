	            <BrushLayer Name="Default"
	                        Sprite="StdAssets\close_button_hover"></BrushLayer>
	        </Layers>
	        <Styles>
	            <Style Name="Default">
	                <BrushLayer Name="Default"
	                            Color="#333333FF"/>
	            </Style>
	            <Style Name="Hovered">
	                <BrushLayer Name="Default"
	                            Color="#888888FF" Sprite="StdAssets\close_button_hover" />
	            </Style>
	            <Style Name="Pressed">
