		<Brush Name="Brush_CircleButton_NinjaReport">
	        <Layers>
	            <BrushLayer Name="Default"
	                        Sprite="SPGeneral\MapNotification\notification_illustration_back_alley"></BrushLayer>
	        </Layers>
	        <Styles>
	            <Style Name="Default">
	                <BrushLayer Name="Default"
	                            Color="#888888FF"/>
	            </Style>
	            <Style Name="Hovered">
	                <BrushLayer Name="Default"
	                            Color="#888888FF" />
	            </Style>
	            <Style Name="Pressed">
	                <BrushLayer Name="Default"
	                            ColorFactor="0.8" />
	            </Style>
	            <Style Name="Selected">
	                <BrushLayer Name="Default"
	                            Sprite="order_popup_card_selected_9"/>
	            </Style>
	        </Styles>
	    </Brush>
			<Brush Name="Brush_CircleButton_Close">
