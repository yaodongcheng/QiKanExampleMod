	                   FontColor="#B8860BFF"
	                   TextOutlineAmount="0.3"
	                   TextOutlineColor="#000000FF"
	                   TextGlowRadius="0"
	                   TextBlur="0"
	                   TextShadowOffset="0.1"
	                   TextShadowAngle="60"
					   FontSize="22"
	                    />
	        </Styles>
	    </Brush>

