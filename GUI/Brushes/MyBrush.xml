                   TextOutlineAmount="0.1"
                   TextOutlineColor="#000000FF"
                   TextGlowRadius="0"
                   TextBlur="0"
                   TextShadowOffset="1"
                   TextShadowAngle="60"
				   FontSize="15"
                    />
            <Style Name="Perfect" FontColor="#55CC55FF" />
            <Style Name="Normal"  FontColor="#E8C55AFF" />
            <Style Name="Fail"    FontColor="#E06055FF" />
        </Styles>
    </Brush>

