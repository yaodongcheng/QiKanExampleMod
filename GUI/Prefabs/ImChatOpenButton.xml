<Prefab>
  <Window Id="LWN">
    <!-- 🔴 Q5（2026-08-17）：IM 常驻呼出按钮层（层序 350，GUI/Prefabs/ImChatOpenButton.xml）。
         🔴 零输入限制纪律：本层不调 SetInputRestrictions——全屏根 DoNotAcceptEvents=true 穿透，
         点击靠引擎 hit-test 门控（层只在鼠标位于层内 DoNotAcceptEvents=false 的 widget 矩形时
         获得鼠标输入）。常驻层任何输入拦截 = 常驻拦输入 = pitfalls 灾难（2026-08-11 拦鼠标教训）。
         交互全部由 C# 驱动（ImChatOpenButtonManager：点击/hover/徽标/跳动动画），无 VM 绑定。 -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            DoNotAcceptEvents="true">
      <Children>

        <!-- 🔴 按钮：右缘下部（VerticalAlignment=Bottom + MarginBottom 140，56×56）——
             避让右缘中部的密信通知圆环带（ImSecretNotify.xml 实锤：右缘垂直居中 + MarginRight 20，
             130×130）与 NinjaReport 金环，不重叠/不遮挡。
             样式 = Party.TalkSlot.Background 槽位底 + conversation_icon 对话图标（2026-08-17 用户裁定：
             与队伍屏/家族屏密信注入按钮同一视觉语言——conversation_icon = 「打开消息」语义，
             不用 Brush_CircleButton_SecretLetter 阴谋插图——那是「有密信来了」的通知语义）。
             🔴 2026-08-17（用户反馈：键帽放按钮右侧）：MarginRight 20→58——给右侧键帽让位
             （键帽贴右缘 MarginRight 20，组内顺序 = [按钮][键帽]）。 -->
        <ButtonWidget Id="LWN_ImChatOpenButton" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="56" SuggestedHeight="56"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      MarginRight="58" MarginBottom="140"
                      Brush="Party.TalkSlot.Background"
                      DoNotPassEventsToChildren="true"
                      UpdateChildrenStates="true">
          <Children>
            <!-- 对话图标（与注入密信按钮同款：SPGeneral\GameMenu\conversation_icon） -->
            <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                         SuggestedWidth="32" SuggestedHeight="32"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Sprite="SPGeneral\GameMenu\conversation_icon"
                         DoNotAcceptEvents="true"/>
            <!-- 未读徽标：按钮右上角小圆底 + 数字（总未读口径，ImChatStore.GetTotalUnread）。
                 0 → 隐藏；>99 → 「99+」；新消息 → 3s 正弦脉冲跳动（C# 驱动 PositionYOffset + Alpha）。 -->
            <Widget Id="LWN_ImChatOpenBadge" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="22" SuggestedHeight="22"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    PositionXOffset="8" PositionYOffset="-6"
                    Sprite="BlankWhiteCircle" Color="#CC2222FF"
                    IsVisible="false"
                    DoNotAcceptEvents="true">
              <Children>
                <TextWidget Id="LWN_ImChatOpenBadgeText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Brush="MyBrush_18_White" Brush.FontSize="12" Brush.FontColor="#FFFFFFFF"
                            Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center"
                            Text=""
                            DoNotAcceptEvents="true"/>
              </Children>
            </Widget>
          </Children>
        </ButtonWidget>

        <!-- 🔴 2026-08-17（按键绑定提示）：键帽 [O]/[↑] **按钮右侧紧邻**（用户反馈：左侧是错的；
             无动作名文字——只一个键帽字形）。组内顺序 = [按钮][键帽]，组贴右缘：键帽 MarginRight 20
             （贴屏幕右缘）、按钮 MarginRight 58（让位）。字形经 ModInput.Glyph 按设备动态
             （键盘 [O] / 手柄 [↑]，config 改绑自动跟随）；垂直对齐 = MarginBottom 153
             （= 按钮 140 + (56-30)/2，与按钮垂直居中）。C# 驱动可见性（随按钮）。 -->
        <Widget Id="LWN_ImChatOpenButtonPadHint" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="30" SuggestedHeight="30"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                MarginRight="20" MarginBottom="153"
                IsVisible="false"
                DoNotAcceptEvents="true">
          <Children>
            <!-- 键帽底：近白底纹（InteractArea 键帽同款） -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="BlankWhiteSquare_9" Color="#E8E8E8FF" />
            <!-- 键名字形（@KeyText——VM 绑定自动求值，键盘 [O] / 手柄 [↑]，设备切换 VM Refresh 驱动） -->
            <TextWidget Id="LWN_ImChatOpenButtonPadHintKey" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Text="@KeyText" Brush="MyBrush_24" TextColor="#000000FF"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        DoNotAcceptEvents="true"/>
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
