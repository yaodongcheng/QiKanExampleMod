<Prefab>
  <Window Id="LWN">
    <!-- 🔴 Q5（2026-08-17）：IM 常驻呼出按钮层（层序 350，GUI/Prefabs/ImChatOpenButton.xml）。
         🔴 零输入限制纪律：本层不调 SetInputRestrictions——全屏根 DoNotAcceptEvents=true 穿透，
         点击靠引擎 hit-test 门控（层只在鼠标位于层内 DoNotAcceptEvents=false 的 widget 矩形时
         获得鼠标输入）。常驻层任何输入拦截 = 常驻拦输入 = pitfalls 灾难（2026-08-11 拦鼠标教训）。
         交互全部由 C# 驱动（ImChatOpenButtonManager：点击/hover/徽标/跳动动画），无 VM 绑定。 -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            DoNotAcceptEvents="true">
      <Children>

        <!-- 🔴 2026-08-19（高度隔离整体移动，用户裁定）：按钮 + 键帽包进公共组容器——
             组容器贴底右对齐，MarginBottom 绑 @MarginBottom（InteractArea 可见时整体上移）。
             原两兄弟各自贴底对齐（按钮 140 / 键帽 153）——只改按钮 = 键帽原地不动、两者分离（实机用户反馈）。 -->
        <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                MarginRight="20" MarginBottom="@MarginBottom"
                DoNotAcceptEvents="true">
          <Children>
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                       StackLayout.LayoutMethod="HorizontalLeftToRight"
                       DoNotAcceptEvents="true">
              <Children>
                <!-- 🔴 按钮：组内左侧（MarginRight 8 = 与键帽间隙；原 58 是组外贴右缘的让位，组内归零）。
                     样式 = Party.TalkSlot.Background 槽位底 + conversation_icon 对话图标（2026-08-17 用户裁定：
                     与队伍屏/家族屏密信注入按钮同一视觉语言——conversation_icon = 「打开消息」语义，
                     不用 Brush_CircleButton_SecretLetter 阴谋插图——那是「有密信来了」的通知语义）。 -->
                <ButtonWidget Id="LWN_ImChatOpenButton" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="56" SuggestedHeight="56"
                              MarginRight="8"
                              Brush="Party.TalkSlot.Background"
                              DoNotPassEventsToChildren="true"
                              UpdateChildrenStates="true">
                  <Children>
                    <!-- 对话图标（与注入密信按钮同款：SPGeneral\GameMenu\conversation_icon） -->
                    <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                 SuggestedWidth="32" SuggestedHeight="32"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Sprite="SPGeneral\GameMenu\conversation_icon"
                                 DoNotAcceptEvents="true"/>
                    <!-- 未读徽标：按钮右上角小圆底 + 数字（总未读口径，ImChatStore.GetTotalUnread）。
                         0 → 隐藏；>99 → 「99+」；新消息 → 3s 正弦脉冲跳动（C# 驱动 PositionYOffset + Alpha）。 -->
                    <Widget Id="LWN_ImChatOpenBadge" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                            SuggestedWidth="22" SuggestedHeight="22"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            PositionXOffset="8" PositionYOffset="-6"
                            Sprite="BlankWhiteCircle" Color="#CC2222FF"
                            IsVisible="false"
                            DoNotAcceptEvents="true">
                      <Children>
                        <TextWidget Id="LWN_ImChatOpenBadgeText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="MyBrush_18_White" Brush.FontSize="12" Brush.FontColor="#FFFFFFFF"
                                    Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center"
                                    Text=""
                                    DoNotAcceptEvents="true"/>
                      </Children>
                    </Widget>
                  </Children>
                </ButtonWidget>

                <!-- 🔴 2026-08-17（按键绑定提示）：键帽 [O]/[↑] **按钮右侧紧邻**（组内第二位，VerticalAlignment
                     Center 与 56 高按钮垂直居中；原 MarginBottom 153 的垂直偏移归组容器管）。字形经
                     ModInput.Glyph 按设备动态（键盘 [O] / 手柄 [↑]，config 改绑自动跟随）。
                     C# 驱动可见性（随按钮）。
                     🔴 2026-08-23（用户裁定：IM 呼出改长按）：键帽升级为 InteractArea 同款长按进度环——
                     底纹 @KeycapColor（按法区分）、四周边+进度填充 @RequiresHold/@SegFillWidth0..3/@SegColor
                     （蓄力中绿→完成金，满框待命后松手触发），VM 每帧驱动（ImChatOpenButtonManager.Tick）。 -->
                <Widget Id="LWN_ImChatOpenButtonPadHint" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="30" SuggestedHeight="30"
                        VerticalAlignment="Center"
                        IsVisible="false"
                        DoNotAcceptEvents="true">
                  <Children>
                    <!-- 键帽底：按按法区分——Short 纯白（无四边）、Long 近白（+四边），一眼看出交互方式（InteractArea 同款） -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare_9" Color="@KeycapColor" />
                    <!-- 四周边 + 填充（Long 玩法常显；短按项整体 IsVisible=false，RequiresHold 由 PressMode==Long 推导）。
                         结构照抄 InteractArea.xml 键帽四边（顺时针闭环：上条 Left+Top → 右条 Right+Top →
                         下条 Right+Bottom → 左条 Left+Bottom；Gauntlet 双轴独立，每条必须显式写
                         HorizontalAlignment + VerticalAlignment）。进度填充条 = 绿→金（声明在灰白边之后
                         渲染在上层），长度绑 VM 每帧算好的像素值（满长 30 = 键帽边长）。 -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@RequiresHold">
                      <Children>
                        <!-- 上：左→右 -->
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="3" MarginTop="0" MarginLeft="0" HorizontalAlignment="Left" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="#CCCCCCFF" />
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@SegFillWidth0" SuggestedHeight="3" MarginTop="0" MarginLeft="0" HorizontalAlignment="Left" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="@SegColor" />
                        <!-- 右：上→下 -->
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="3" SuggestedHeight="30" MarginTop="0" MarginRight="0" HorizontalAlignment="Right" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="#CCCCCCFF" />
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="3" SuggestedHeight="@SegFillHeight1" MarginTop="0" MarginRight="0" HorizontalAlignment="Right" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="@SegColor" />
                        <!-- 下：右→左 -->
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="3" MarginRight="0" MarginBottom="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare_9" Color="#CCCCCCFF" />
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@SegFillWidth2" SuggestedHeight="3" MarginRight="0" MarginBottom="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare_9" Color="@SegColor" />
                        <!-- 左：下→上 -->
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="3" SuggestedHeight="30" MarginBottom="0" MarginLeft="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare_9" Color="#CCCCCCFF" />
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="3" SuggestedHeight="@SegFillHeight3" MarginBottom="0" MarginLeft="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare_9" Color="@SegColor" />
                      </Children>
                    </Widget>
                    <!-- 键名字形（@KeyText——VM 绑定自动求值，键盘 [O] / 手柄 [↑]，设备切换 VM Refresh 驱动） -->
                    <TextWidget Id="LWN_ImChatOpenButtonPadHintKey" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Text="@KeyText" Brush="MyBrush_24" TextColor="#000000FF"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                DoNotAcceptEvents="true"/>
                  </Children>
                </Widget>
              </Children>
            </ListPanel>
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
