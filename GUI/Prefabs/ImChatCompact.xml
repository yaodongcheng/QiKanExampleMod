<Prefab>
  <Window Id="LWN">
    <!-- 根：全屏透明容器，不接收事件——缩略模式的核心：玩家看场景/操作场景，
         面板矩形外的点击/滚轮/键盘全部穿透到游戏（引擎 hit-test 门控） -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            DoNotAcceptEvents="true">
      <Children>

        <!-- ══════════ 缩略面板：贴底居中（StealBar 同款默认位），可拖动（把手 = 标题行）══════════
             🔴 DoNotAcceptEvents=false（2026-08-15 审查 P0-2）：半模态岛——面板矩形内点击被层吞
             不穿透场景（点气泡文本不会挥刀），矩形外放行；全屏根保持 true。
             🔴 CoverChildren 高：1 条消息 ~165px / 2 条 ~210px，贴底向上增长不抖动（Bottom 锚定）。 -->
        <Widget Id="LWN_ImChat_CompactPanel" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                SuggestedWidth="560"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="70"
                Sprite="StdAssets\Popup\canvas_dark"
                DoNotAcceptEvents="false">
          <Children>

            <!-- 竖向主体（LWN 惯例：VerticalBottomToTop + 子元素按屏幕从上到下书写） -->
            <ListPanel Id="LWN_ImChat_CompactBody" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                       StackLayout.LayoutMethod="VerticalBottomToTop"
                       DoNotAcceptEvents="true">
              <Children>

                <!-- ═══ 标题行（2026-08-15 用户裁定恢复）：频道名 + 放大图标 + 关闭（不承担拖动）═══ -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34"
                        Sprite="BlankWhiteSquare_9" Color="#000000B3"
                        DoNotAcceptEvents="true">
                  <Children>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                               StackLayout.LayoutMethod="HorizontalLeftToRight"
                               DoNotAcceptEvents="true">
                      <Children>
                        <!-- 频道名（金色，左对齐） -->
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Text="@Title" Brush="MyBrush_18_White" Brush.FontSize="16" Brush.FontColor="#FFD75EFF"
                                    Brush.TextHorizontalAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    MarginLeft="14" ClipContents="true"
                                    DoNotAcceptEvents="true"/>
                        <!-- 放大按钮（回完整模式；图标 = plus_button_*，2026-08-15 用户裁定） -->
                        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="26"
                                      VerticalAlignment="Center" MarginLeft="6"
                                      Brush="LWN_Btn_Expand"
                                      Command.Click="ExecuteExpand"/>
                        <!-- 关闭按钮 -->
                        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="26"
                                      VerticalAlignment="Center" MarginLeft="4" MarginRight="10"
                                      Brush="Popup.CloseButton"
                                      Command.Click="ExecuteClose"/>
                      </Children>
                    </ListPanel>
                  </Children>
                </Widget>

                <!-- ═══ 行 A：未决锚点卡（含按钮行）。🔴 2026-08-15 用户裁定：与最新消息共存时
                     显示 2 条紧凑排布——行 A = 锚点卡（可操作），行 B = 最新消息（可读）。
                     DataSource="{CompactAnchor}" 单条 VM 绑定（ImMessageVM 实例 = _vm.Messages 同一实例，
                     广播路径天然覆盖——审查 P1-2）。按钮行照完整模式同构（IsCardAnchor 驱动）。
                     🔴 2026-08-15 实机修复：IsVisible 必须绑在外层容器——DataSource 在同一 widget 上时，
                     自身属性绑定在子上下文（ImMessageVM）解析，HasCompactAnchor 不存在 → 恒 false 行隐藏。 -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        IsVisible="@HasCompactAnchor"
                        MarginLeft="10" MarginRight="10" MarginTop="6"
                        DoNotAcceptEvents="true">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                            DataSource="{CompactAnchor}"
                            DoNotAcceptEvents="true">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                Sprite="BlankWhiteSquare_9" Color="#1A1A3AEE"
                                DoNotAcceptEvents="true">
                          <Children>
                            <ListPanel Id="LWN_ImChat_CompactCard" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       StackLayout.LayoutMethod="VerticalBottomToTop"
                                       DoNotAcceptEvents="true">
                              <Children>
                                <!-- 名字行（发送者成员色） -->
                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                                           HorizontalAlignment="Left"
                                           MarginLeft="10" MarginTop="6"
                                           DoNotAcceptEvents="true">
                              <Children>
                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                            Text="@SenderName" Brush="MyBrush_18_White" Brush.FontSize="14" Brush.FontColor="@NameColor"
                                            HorizontalAlignment="Left"
                                            DoNotAcceptEvents="true"/>
                              </Children>
                            </ListPanel>
                            <!-- 修改版徽标（Q2） -->
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="@ModifiedBadgeText" Brush="MyBrush_16_Left" Brush.FontSize="12" Brush.FontColor="#E8C55AFF"
                                        HorizontalAlignment="Left"
                                        IsVisible="@IsModifiedPlan"
                                        MarginLeft="10" MarginTop="4"
                                        DoNotAcceptEvents="true"/>
                            <!-- 正文：紧凑单行截断（CompactContent，完整内容在完整模式看） -->
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        Text="@CompactContent" Brush="MyBrush_16_Left" Brush.FontSize="14" Brush.TextHorizontalAlignment="Left"
                                        HorizontalAlignment="Left"
                                        MarginLeft="10" MarginRight="10" MarginTop="4"
                                        DoNotAcceptEvents="true"/>
                            <!-- 通用按钮行·横排（照完整模式同构：IsCardAnchor 驱动可见性，数据驱动按钮集） -->
                            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                       StackLayout.LayoutMethod="HorizontalLeftToRight"
                                       HorizontalAlignment="Right"
                                       IsVisible="@IsHorizontalButtons"
                                       DataSource="{CardButtons}"
                                       MarginRight="8" MarginBottom="6" MarginTop="4"
                                       DoNotAcceptEvents="true">
                              <ItemTemplate>
                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="86" SuggestedHeight="28"
                                              Brush="Test.Button3"
                                              Command.Click="Execute"
                                              IsEnabled="@IsEnabled" MarginRight="6">
                                  <Children>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                Text="@Text" Brush="MyBrush_18_White" Brush.FontSize="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                DoNotAcceptEvents="true"/>
                                  </Children>
                                </ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                            <!-- 通用按钮行·竖排（长文本按钮；数据互斥 VerticalCardButtons；LWN 前缀走 swap patch） -->
                            <ListPanel Id="LWN_ImChat_CompactCardButtonsV" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                       StackLayout.LayoutMethod="VerticalBottomToTop"
                                       HorizontalAlignment="Right"
                                       IsVisible="@IsVerticalButtonsVisible"
                                       DataSource="{VerticalCardButtons}"
                                       MarginRight="8" MarginBottom="6" MarginTop="4"
                                       DoNotAcceptEvents="true">
                              <ItemTemplate>
                                <ButtonWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="34"
                                              Brush="Test.Button3"
                                              HorizontalAlignment="Right"
                                              Command.Click="Execute"
                                              IsEnabled="@IsEnabled" MarginTop="4" MarginBottom="4">
                                  <Children>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                Text="@Text" Brush="MyBrush_18_White" Brush.FontSize="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                DoNotAcceptEvents="true"/>
                                  </Children>
                                </ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>
                      </Children>
                    </Widget>
                  </Children>
                </Widget>

                <!-- ═══ 行 B：最近 1~2 条消息迷你气泡（用户裁定 2026-08-15：有 2 条显示 2 条，
                     给回复提供基础上下文；无按钮；与锚点卡共存时也显示。锚点消息本身不进本列表——
                     它在行 A 有完整形态。🔴 IsVisible 绑外层容器（DataSource 同 widget 自身绑定失效）═══ -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        IsVisible="@HasCompactLatest"
                        MarginLeft="10" MarginRight="10" MarginTop="6"
                        DoNotAcceptEvents="true">
                  <Children>
                    <ListPanel Id="LWN_ImChat_CompactLatestList" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                               DataSource="{CompactLatestMessages}"
                               StackLayout.LayoutMethod="VerticalBottomToTop"
                               DoNotAcceptEvents="true">
                      <ItemTemplate>
                        <!-- 迷你气泡：名字 + 单行截断正文 -->
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                Sprite="BlankWhiteSquare_9" Color="#FFFFFF1A" MarginBottom="4"
                                DoNotAcceptEvents="true">
                          <Children>
                            <ListPanel Id="LWN_ImChat_CompactLatestRow" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       StackLayout.LayoutMethod="VerticalBottomToTop"
                                       DoNotAcceptEvents="true">
                              <Children>
                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                                           HorizontalAlignment="Left"
                                           MarginLeft="10" MarginTop="4"
                                           DoNotAcceptEvents="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                Text="@SenderName" Brush="MyBrush_18_White" Brush.FontSize="14" Brush.FontColor="@NameColor"
                                                HorizontalAlignment="Left"
                                                DoNotAcceptEvents="true"/>
                                  </Children>
                                </ListPanel>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            Text="@CompactContent" Brush="MyBrush_16_Left" Brush.FontSize="14" Brush.TextHorizontalAlignment="Left"
                                            HorizontalAlignment="Left"
                                            MarginLeft="10" MarginRight="10" MarginTop="2" MarginBottom="5"
                                            DoNotAcceptEvents="true"/>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </ItemTemplate>
                    </ListPanel>
                  </Children>
                </Widget>

<!-- ═══ 输入行：频道下拉（原版 Options 控件，上开式）+ 输入框 + 发送（2026-08-15 用户裁定：同一行）═══
     🔴 上开式改造：DoNotHandleDropdownListPanel=true（列表不 reparent 不自动定位，留在 clip 内）；
     dropdown 高度 Fixed=56（列表打开时不撑高输入行 → 布局稳定）；
     DropdownClipWidget VerticalAlignment=Bottom + MarginBottom=58 → 列表浮在按钮上方向上展开
     （盖住消息区，不越屏）。列表项点击的选中/收起仍由原版控件处理（Radio + SelectedIndex 双向绑定）。 -->
<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="62"
        Sprite="BlankWhiteSquare_9" Color="#00000088"
        DoNotAcceptEvents="true">
  <Children>
    <!-- 分隔线：输入行与消息区边界 -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2"
            VerticalAlignment="Top"
            Sprite="BlankWhiteSquare_9" Color="#FFFFFF33"
            DoNotAcceptEvents="true"/>
    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
               StackLayout.LayoutMethod="HorizontalLeftToRight"
               DoNotAcceptEvents="true">
      <Children>
        <!-- 频道三件套（DataSource 只包这里：箭头命令与 CurrentSelectedIndex 解析到 SelectorVM；
             输入框/发送保持在主 VM 上下文） -->
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                   DataSource="{ChannelSelector}"
                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                   DoNotAcceptEvents="true">
          <Children>
            <!-- 左箭头：上一个频道 -->
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="46" SuggestedHeight="56"
                          Brush="SPOptions.Dropdown.Left.Button"
                          Command.Click="ExecuteSelectPreviousItem"
                          VerticalAlignment="Center" MarginLeft="8" MarginRight="2"/>
            <!-- 原版下拉中心（列表上开式）。
                 🔴 2026-08-15 实机修复（上拉不生效根因）：必须用 DropdownWidget（基类，ClanPartyRoleDropdown
                 同款）——AnimatedDropdownWidget 不是它的子类，其 DropdownClipWidget setter 强制
                 VerticalAlignment=Top + reparent 到 RelativeRoot，上开式布局被覆盖成下开；
                 DoNotHandleDropdownListPanel 在 AnimatedDropdownWidget 上不存在（静默忽略）。
                 DropdownWidget + DoNotHandleDropdownListPanel=true：列表不 reparent 不自动定位，
                 留在 clip 内由 XML 布局（VerticalAlignment=Bottom + MarginBottom=58 向上展开）；
                 选中/收起/文本刷新仍由控件处理。 -->
            <DropdownWidget Id="LWN_ImChat_CompactDropdown" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                            SuggestedWidth="150" SuggestedHeight="56" HorizontalAlignment="Center" VerticalAlignment="Center"
                            DoNotHandleDropdownListPanel="true"
                            ListPanel="DropdownClipWidget\DropdownContainerWidget\ScrollablePanel\ClipRect\LWN_ImChat_ChannelSelectorList"
                            Button="DropdownButtonContainer\DropdownButton"
                            CurrentSelectedIndex="@SelectedIndex"
                            TextWidget="DropdownButtonContainer\DropdownButton\SelectedTextWidget">
              <Children>
                <!-- 中心按钮（原版 Options 下拉中心笔刷） -->
                <Widget Id="DropdownButtonContainer" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                        SuggestedHeight="56" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Children>
                    <ButtonWidget Id="DropdownButton" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                  DoNotPassEventsToChildren="true" Brush="SPOptions.Dropdown.Center">
                      <Children>
                        <TextWidget Id="SelectedTextWidget" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" PositionYOffset="1"
                                    Brush="SPOptions.Dropdown.Center.Text" ClipContents="true"/>
                      </Children>
                    </ButtonWidget>
                  </Children>
                </Widget>
                <!-- 下拉列表浮层（🔴 上开式：底部对齐按钮上方 58px，向上溢出 dropdown 的 56px 盒子；
                     高度随内容自适应：WidgetToCopyHeightFrom 复制 ScrollablePanel 高度） -->
                <Widget Id="DropdownClipWidget" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="58"
                        ClipContents="true" WidgetToCopyHeightFrom="DropdownContainerWidget\ScrollablePanel">
                  <Children>
                    <BrushWidget Id="DropdownContainerWidget" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                 VerticalAlignment="Bottom" SuggestedWidth="330" SuggestedHeight="380"
                                 HorizontalAlignment="Center" Brush="SPOptions.Dropdown.Extension">
                      <Children>
                        <ScrollablePanel Id="ScrollablePanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                         AutoHideScrollBars="true" ClipRect="ClipRect" MarginBottom="20" VerticalAlignment="Bottom"
                                         InnerPanel="ClipRect\LWN_ImChat_ChannelSelectorList"
                                         VerticalScrollbar="..\VerticalScrollbar">
                          <Children>
                            <Widget Id="ClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    ClipContents="true" MaxHeight="348">
                              <Children>
                                <ListPanel Id="LWN_ImChat_ChannelSelectorList" DataSource="{ItemList}"
                                           WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                           HorizontalAlignment="Center" StackLayout.LayoutMethod="VerticalBottomToTop"
                                           DoNotAcceptEvents="true">
                                  <ItemTemplate>
                                    <!-- 项：原版单选结构（SoundBrush + Radio + UpdateChildrenStates 驱动
                                         内层 ImageWidget 的 Hovered 高亮） -->
                                    <ButtonWidget Id="DropdownItemButton" DoNotPassEventsToChildren="true"
                                                  WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="29"
                                                  MarginLeft="10" MarginRight="10" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                  ButtonType="Radio" UpdateChildrenStates="true" IsEnabled="@CanBeSelected"
                                                  Command.Click="ExecuteSelect"
                                                  Brush="Standard.DropdownItem.SoundBrush">
                                      <Children>
                                        <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                     MarginLeft="5" MarginRight="5"
                                                     Brush="Standard.DropdownItem"
                                                     DoNotAcceptEvents="true"/>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    HorizontalAlignment="Center" MarginLeft="7" MarginRight="7" VerticalAlignment="Center"
                                                    Brush="SPOptions.Dropdown.Item.Text" Text="@StringItem"
                                                    IsVisible="@CanBeSelected" ClipContents="true"
                                                    DoNotAcceptEvents="true"/>
                                      </Children>
                                    </ButtonWidget>
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </Widget>
                          </Children>
                        </ScrollablePanel>
                        <ScrollbarWidget Id="VerticalScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                         SuggestedWidth="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         MarginTop="8" MarginBottom="18" MarginRight="5" AlignmentAxis="Vertical"
                                         Handle="VerticalScrollbarHandle" IsVisible="false" MaxValue="100" MinValue="0">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4"
                                    HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" AlphaFactor="0.2" Color="#5A4033FF"
                                    DoNotAcceptEvents="true"/>
                            <ImageWidget Id="VerticalScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                         SuggestedWidth="8" SuggestedHeight="10" HorizontalAlignment="Center"
                                         Brush="FaceGen.Scrollbar.Handle"/>
                          </Children>
                        </ScrollbarWidget>
                      </Children>
                    </BrushWidget>
                  </Children>
                </Widget>
              </Children>
            </DropdownWidget>
            <!-- 右箭头：下一个频道 -->
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="46" SuggestedHeight="56"
                          Brush="SPOptions.Dropdown.Right.Button"
                          Command.Click="ExecuteSelectNextItem"
                          VerticalAlignment="Center" MarginLeft="2" MarginRight="6"/>
          </Children>
        </ListPanel>
        <!-- 输入框（与完整模式同字段：切模式草稿保留） -->
        <EditableTextWidget Id="LWN_ImChat_CompactInput" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Text="@InputText" DefaultSearchText="@PlaceholderText"
                            TextColor="#FFFFFFFF" Brush="MyBrush_16_Left" Brush.FontSize="16"
                            MarginRight="6" VerticalAlignment="Center"/>
        <!-- 发送按钮 -->
        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="64" SuggestedHeight="34"
                      Brush="Test.Button3"
                      Command.Click="ExecuteSend"
                      IsEnabled="@CanSend"
                      VerticalAlignment="Center" MarginRight="8">
          <Children>
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                        Text="@SendText" Brush="MyBrush_18_White" Brush.FontSize="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        DoNotAcceptEvents="true"/>
          </Children>
        </ButtonWidget>
      </Children>
    </ListPanel>
  </Children>
</Widget>



              </Children>
            </ListPanel>

            <!-- 🔴 2026-08-15 修复：不加 frame_9 边框——StretchToParent 子元素在 CoverChildren 面板里
                 按父级 measure spec（全屏）测量，会把面板撑成全屏高（DefaultLayout.MeasureChildren
                 反编译证实），内容全挤到屏幕顶部。canvas_dark 底图 + 标题/输入深色条已够分层。 -->

          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
