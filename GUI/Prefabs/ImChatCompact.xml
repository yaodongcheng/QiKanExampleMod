<Prefab>
  <Window Id="LWN">
    <!-- 根：全屏透明容器，不接收事件——缩略模式的核心：玩家看场景/操作场景，
         面板矩形外的点击/滚轮/键盘全部穿透到游戏（引擎 hit-test 门控） -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            DoNotAcceptEvents="true">
      <Children>

        <!-- ══════════ 缩略面板：贴底居中（StealBar 同款默认位），可拖动（把手 = 标题行）══════════
             🔴 DoNotAcceptEvents=false（2026-08-15 审查 P0-2）：半模态岛——面板矩形内点击被层吞
             不穿透场景（点气泡文本不会挥刀），矩形外放行；全屏根保持 true。
             🔴 CoverChildren 高：1 条消息 ~165px / 2 条 ~210px，贴底向上增长不抖动（Bottom 锚定）。 -->
        <Widget Id="LWN_ImChat_CompactPanel" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                SuggestedWidth="560"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="70"
                Sprite="StdAssets\Popup\canvas_dark"
                DoNotAcceptEvents="false">
          <Children>

            <!-- 🔴 2026-08-18（实机三连击根因修复）：NavigationScopeTargeter 已删除（同完整模式——
                 引擎 scope 自动夺焦点 + 光标瞬移中心 → 手动导航停摆；手柄导航 = ImChatView 手动导航独占）。 -->

            <!-- 竖向主体（LWN 惯例：VerticalBottomToTop + 子元素按屏幕从上到下书写） -->
            <ListPanel Id="LWN_ImChat_CompactBody" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                       StackLayout.LayoutMethod="VerticalBottomToTop"
                       DoNotAcceptEvents="true">
              <Children>

<!-- ═══ 标题行（2026-08-15 用户裁定：频道切换进标题，标题不放文字）：
     频道三件套（◀ 原版箭头 / 中心原版笔刷 + 上开列表 / ▶）+ 放大/关闭图标 ═══
     🔴 下拉点不开修复（2026-08-15）：放弃原版 DropdownWidget 控件（Animated 强制 clip
     顶对齐、Dropdown 点击链路在自定义层失效）——中心按钮 = 普通 ButtonWidget +
     Command.Click 直连 VM 显隐（ExecuteToggleChannelList），列表 IsVisible=@IsChannelListOpen，
     外观/笔刷/Radio 项全部保持原版。 -->
<Widget Id="LWN_ImChat_CompactTitleRow" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56"
        Sprite="BlankWhiteSquare_9" Color="#000000B3"
        DoNotAcceptEvents="true">
  <Children>
    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
               StackLayout.LayoutMethod="HorizontalLeftToRight"
               DoNotAcceptEvents="true">
      <Children>
        <!-- 频道三件套（DataSource 包这里：箭头命令解析到 SelectorVM；中心按钮 Command 同样）
             中心按钮文本 = SelectedChannelText（VM 维护，含未读数） -->
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                   DataSource="{ChannelSelector}"
                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                   DoNotAcceptEvents="true">
          <Children>
            <!-- 左箭头：上一个频道（Id 2026-08-18 手柄手动导航：K1 焦点项 widget 定位） -->
            <ButtonWidget Id="LWN_BtnPrev" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="46" SuggestedHeight="50"
                          Brush="SPOptions.Dropdown.Left.Button"
                          Command.Click="ExecuteSelectPreviousItem"
                          GamepadNavigationIndex="1"
                          VerticalAlignment="Center" MarginLeft="8" MarginRight="2"/>
            <!-- 中心按钮：显示当前频道，点击切换列表显隐（🔴 自定义直连，不再用原版控件点击机制；
                 Id 2026-08-18：K2 焦点项 widget 定位） -->
            <ButtonWidget Id="LWN_BtnCenter" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="50"
                          Brush="SPOptions.Dropdown.Center"
                          Command.Click="ExecuteToggleChannelList"
                          GamepadNavigationIndex="2"
                          VerticalAlignment="Center" MarginLeft="2" MarginRight="2">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Text="@SelectedChannelText" Brush="SPOptions.Dropdown.Center.Text" Brush.FontSize="15"
                            Brush.TextHorizontalAlignment="Center"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MarginLeft="10" MarginRight="10" ClipContents="true"
                            DoNotAcceptEvents="true"/>
              </Children>
            </ButtonWidget>
            <!-- 右箭头：下一个频道（Id 2026-08-18 手柄手动导航：K3 焦点项 widget 定位） -->
            <ButtonWidget Id="LWN_BtnNext" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="46" SuggestedHeight="50"
                          Brush="SPOptions.Dropdown.Right.Button"
                          Command.Click="ExecuteSelectNextItem"
                          GamepadNavigationIndex="3"
                          VerticalAlignment="Center" MarginLeft="2" MarginRight="6"/>
          </Children>
        </ListPanel>
        <!-- 占位拉伸（频道区与图标区之间的空隙） -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                DoNotAcceptEvents="true"/>
        <!-- 放大按钮（回完整模式；plus_button_* 图标，用户裁定；Id 2026-08-18：K4 焦点项 widget 定位） -->
        <ButtonWidget Id="LWN_BtnExpand" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32"
                      VerticalAlignment="Center" MarginLeft="4"
                      Brush="LWN_Btn_Expand"
                      GamepadNavigationIndex="4"
                      Command.Click="ExecuteExpand"/>
        <!-- 关闭按钮（Id 2026-08-18 手柄手动导航：K5 焦点项 widget 定位） -->
        <ButtonWidget Id="LWN_BtnCloseC" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32"
                      VerticalAlignment="Center" MarginLeft="4" MarginRight="10"
                      Brush="Popup.CloseButton"
                      GamepadNavigationIndex="5"
                      Command.Click="ExecuteClose"/>
      </Children>
    </ListPanel>
    <!-- 频道列表（🔴 上开式：标题行内底部对齐按钮上方 52px，向上溢出标题行/面板盖住上方区域；
         高度随项数自适应 @ChannelListHeight；原版 Extension 底 + 项 Radio 视觉 + 增量数据）
         🔴 2026-08-15 绑定作用域修复：列表是 {ChannelSelector} 作用域外的兄弟节点，
         根 VM 上没有 ItemList/IsChannelListOpen/ChannelListHeight（都在 ImChannelSelectorVM），
         必须自包一层 DataSource="{ChannelSelector}" 让 IsVisible/高度/项数据在 SelectorVM 上解析；
         自身属性绑定 = 同 widget DataSource 子上下文（同 HasCompactAnchor 坑的反向利用）。
         🔴 2026-08-15（根级方案回退）：列表不能放 Window 根级——FindWidgetById 从
         UIContext.Root 找不到根级 child（Window 是 CustomWidgetType，树链不可靠），
         显示/切换全断。浮出面板的列表收不到引擎事件（祖先矩形门控），交互走手动命中
         （HandleManualScroll 同款：HandleCompactInput 里按坐标算行号，hover/pressed 视觉 +
         点选派发）。 -->
    <Widget Id="LWN_ImChat_ChannelList" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
            SuggestedWidth="330" SuggestedHeight="@ChannelListHeight"
            VerticalAlignment="Bottom" MarginBottom="52" HorizontalAlignment="Left" MarginLeft="8"
            Brush="SPOptions.Dropdown.Extension"
            DataSource="{ChannelSelector}"
            IsVisible="@IsChannelListOpen"
            DoNotAcceptEvents="true">
      <Children>
        <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                         AutoHideScrollBars="true"
                         ClipRect="LWN_ImChat_ChannelClip" InnerPanel="LWN_ImChat_ChannelClip\LWN_ImChat_ChannelListInner"
                         VerticalScrollbar="..\LWN_ImChat_ChannelScrollbar"
                         MarginLeft="8" MarginRight="10" MarginTop="8" MarginBottom="8">
          <Children>
            <Widget Id="LWN_ImChat_ChannelClip" ClipContents="true"
                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    DoNotAcceptEvents="true">
              <Children>
                <ListPanel Id="LWN_ImChat_ChannelListInner" DataSource="{ItemList}"
                           WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                           StackLayout.LayoutMethod="VerticalBottomToTop"
                           DoNotAcceptEvents="true">
                  <ItemTemplate>
                    <!-- 项：Radio + UpdateChildrenStates 驱动 hover/pressed 高亮（引擎正常路径）；
                         引擎事件被门控时由 HandleCompactInput 手动 SetState 驱动（互不冲突）。
                         选中态 = IsSelected 绑定（RefreshChannelOptions 维护）；
                         点击 = Command.Click 直连 ExecuteSelect（引擎路径）/ 手动点选派发。
                         🔴 2026-08-15：ImageWidget 用自绘 LWN_DropdownItem（Default 深色底，
                         原版 Standard.DropdownItem Default 透明 → 用户裁定要有底色） -->
                    <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30"
                                  ButtonType="Radio" UpdateChildrenStates="true" IsSelected="@IsSelected"
                                  IsEnabled="@CanBeSelected"
                                  Command.Click="ExecuteSelect"
                                  Brush="Standard.DropdownItem.SoundBrush"
                                  MarginLeft="4" MarginRight="4" MarginTop="2" MarginBottom="2">
                      <Children>
                        <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                     MarginLeft="5" MarginRight="5"
                                     Brush="LWN_DropdownItem"
                                     DoNotAcceptEvents="true"/>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Text="@StringItem" Brush="SPOptions.Dropdown.Item.Text" Brush.FontSize="14"
                                    Brush.TextHorizontalAlignment="Left"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    MarginLeft="10" MarginRight="10" ClipContents="true"
                                    IsVisible="@CanBeSelected"
                                    DoNotAcceptEvents="true"/>
                      </Children>
                    </ButtonWidget>
                  </ItemTemplate>
                </ListPanel>
              </Children>
            </Widget>
          </Children>
        </ScrollablePanel>
        <ScrollbarWidget Id="LWN_ImChat_ChannelScrollbar" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                         AlignmentAxis="Vertical" Handle="LWN_ImChat_ChannelScrollbarHandle"
                         HorizontalAlignment="Right" MarginRight="2" MarginTop="4" MarginBottom="4"
                         MaxValue="100" MinValue="0">
          <Children>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2"
                    HorizontalAlignment="Center"
                    Sprite="BlankWhiteSquare_9" Color="#A37434FF" MarginTop="5" MarginBottom="5" AlphaFactor="0.7"
                    DoNotAcceptEvents="true"/>
            <ImageWidget Id="LWN_ImChat_ChannelScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                         MinHeight="15" SuggestedHeight="10" SuggestedWidth="14"
                         HorizontalAlignment="Center" Brush="SPChatlog.Scrollbar.Handle"/>
          </Children>
        </ScrollbarWidget>
      </Children>
    </Widget>
  </Children>
</Widget>

                <!-- ═══ 行 B：最近 1~2 条消息迷你气泡（用户裁定 2026-08-15：有 2 条显示 2 条，
                     给回复提供基础上下文；无按钮；与锚点卡共存时也显示。锚点消息本身不进本列表——
                     它在行 A 有完整形态。🔴 IsVisible 绑外层容器（DataSource 同 widget 自身绑定失效）═══
                     🔴 2026-08-17 用户裁定（时间顺序）：行 B 在上、行 A（锚点卡）在下——
                     新询问/新卡片成为锚点后按时间出现在最底部，不再跳到顶部盖住旧卡。 -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        IsVisible="@HasCompactLatest"
                        MarginLeft="10" MarginRight="10" MarginTop="6"
                        DoNotAcceptEvents="true">
                  <Children>
                    <ListPanel Id="LWN_ImChat_CompactLatestList" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                               DataSource="{CompactLatestMessages}"
                               StackLayout.LayoutMethod="VerticalBottomToTop"
                               DoNotAcceptEvents="true">
                      <ItemTemplate>
                        <!-- 迷你气泡：名字 + 单行截断正文 -->
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                Sprite="BlankWhiteSquare_9" Color="#FFFFFF1A" MarginBottom="4"
                                DoNotAcceptEvents="true">
                          <Children>
                            <ListPanel Id="LWN_ImChat_CompactLatestRow" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       StackLayout.LayoutMethod="VerticalBottomToTop"
                                       DoNotAcceptEvents="true">
                              <Children>
                                <!-- 名字行（发送者成员色；🔴 2026-08-17 用户裁定：系统消息不显示
                                     「System」发件人——硬编码英文不符合本地化纪律，完整模式本来就是居中灰字无发件人） -->
                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                                           HorizontalAlignment="Left"
                                           IsVisible="@ShowCompactSenderName"
                                           MarginLeft="10" MarginTop="4"
                                           DoNotAcceptEvents="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                Text="@DisplaySenderNameCompact" Brush="MyBrush_18_White" Brush.FontSize="14" Brush.FontColor="@NameColor"
                                                HorizontalAlignment="Left"
                                                DoNotAcceptEvents="true"/>
                                  </Children>
                                </ListPanel>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            Text="@CompactContent" Brush="MyBrush_16_Left" Brush.FontSize="14" Brush.TextHorizontalAlignment="Left"
                                            HorizontalAlignment="Left"
                                            MarginLeft="10" MarginRight="10" MarginTop="2" MarginBottom="5"
                                            DoNotAcceptEvents="true"/>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </ItemTemplate>
                    </ListPanel>
                  </Children>
                </Widget>

                <!-- ═══ 行 A：未决锚点卡（含按钮行）。🔴 2026-08-15 用户裁定：与最新消息共存时
                     显示 2 条紧凑排布——锚点卡（可操作）+ 最近消息（可读）。
                     DataSource="{CompactAnchor}" 单条 VM 绑定（ImMessageVM 实例 = _vm.Messages 同一实例，
                     广播路径天然覆盖——审查 P1-2）。按钮行照完整模式同构（IsCardAnchor 驱动）。
                     🔴 2026-08-15 实机修复：IsVisible 必须绑在外层容器——DataSource 在同一 widget 上时，
                     自身属性绑定在子上下文（ImMessageVM）解析，HasCompactAnchor 不存在 → 恒 false 行隐藏。
                     🔴 2026-08-17 用户裁定（时间顺序）：锚点卡移到行 B 之下、贴输入行上方——
                     新卡按时间出现在最底部（与完整模式消息流语义一致）。 -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        IsVisible="@HasCompactAnchor"
                        MarginLeft="10" MarginRight="10" MarginTop="6"
                        DoNotAcceptEvents="true">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                            DataSource="{CompactAnchor}"
                            DoNotAcceptEvents="true">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                Sprite="BlankWhiteSquare_9" Color="#1A1A3AEE"
                                DoNotAcceptEvents="true">
                          <Children>
                            <ListPanel Id="LWN_ImChat_CompactCard" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       StackLayout.LayoutMethod="VerticalBottomToTop"
                                       DoNotAcceptEvents="true">
                              <Children>
                                <!-- 名字行（发送者成员色） -->
                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                                           HorizontalAlignment="Left"
                                           MarginLeft="10" MarginTop="6"
                                           DoNotAcceptEvents="true">
                              <Children>
                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                            Text="@DisplaySenderNameCompact" Brush="MyBrush_18_White" Brush.FontSize="14" Brush.FontColor="@NameColor"
                                            HorizontalAlignment="Left"
                                            DoNotAcceptEvents="true"/>
                              </Children>
                            </ListPanel>
                            <!-- 修改版徽标（Q2） -->
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="@ModifiedBadgeText" Brush="MyBrush_16_Left" Brush.FontSize="12" Brush.FontColor="#E8C55AFF"
                                        HorizontalAlignment="Left"
                                        IsVisible="@IsModifiedPlan"
                                        MarginLeft="10" MarginTop="4"
                                        DoNotAcceptEvents="true"/>
                            <!-- 正文：紧凑单行截断（CompactContent，完整内容在完整模式看） -->
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                        Text="@CompactContent" Brush="MyBrush_16_Left" Brush.FontSize="14" Brush.TextHorizontalAlignment="Left"
                                        HorizontalAlignment="Left"
                                        MarginLeft="10" MarginRight="10" MarginTop="4"
                                        DoNotAcceptEvents="true"/>
                            <!-- 通用按钮行·横排（照完整模式同构：IsCardAnchor 驱动可见性，数据驱动按钮集） -->
                            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                       StackLayout.LayoutMethod="HorizontalLeftToRight"
                                       HorizontalAlignment="Right"
                                       IsVisible="@IsHorizontalButtons"
                                       DataSource="{CardButtons}"
                                       MarginRight="8" MarginBottom="6" MarginTop="4"
                                       DoNotAcceptEvents="true">
                              <ItemTemplate>
                                <!-- 🔴 2026-08-19（用户反馈：选项高度窄/宽不包文本）：高 28→56（扩大一倍）、
                                     固定宽 86 改 CoverChildren + MinWidth 96 + MaxWidth 240 + WordWrapping——
                                     长文本折行后按钮跟着长高、绝不溢出底纹；短文本保底 96 宽（对齐完整模式手感）；
                                     MarginRight 6→4（选项间空隙收紧）。
                                     🔴 2026-08-20（用户反馈：按钮高度远高于文字大小）：MinHeight 56→26
                                     （文字 14px，26 = 文字 + 上下 4px padding；长文本折行时 CoverChildren 仍会撑高）。 -->
                                <ButtonWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                              MinHeight="26" MinWidth="96" MaxWidth="240"
                                              Brush="LWN_Btn_Message"
                                              Command.Click="Execute"
                                              IsEnabled="@IsEnabled" MarginRight="4">
                                  <Children>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                MaxWidth="220"
                                                Text="@Text" Brush="MyBrush_18_White" Brush.FontSize="14"
                                                WordWrapping="Wrap"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                DoNotAcceptEvents="true"/>
                                  </Children>
                                </ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                            <!-- 通用按钮行·竖排（长文本按钮；数据互斥 VerticalCardButtons；LWN 前缀走 swap patch） -->
                            <ListPanel Id="LWN_ImChat_CompactCardButtonsV" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       StackLayout.LayoutMethod="VerticalBottomToTop"
                                       IsVisible="@IsVerticalButtonsVisible"
                                       DataSource="{VerticalCardButtons}"
                                       MarginLeft="10" MarginRight="10" MarginBottom="6" MarginTop="4"
                                       DoNotAcceptEvents="true">
                              <ItemTemplate>
                                <!-- 🔴 2026-08-20（竖排按钮改为 Fixed 高度 + 零 Margin——无缝衔接）：
                                     引擎机制（反编译 TaleWorlds.GauntletUI.dll 实证）：
                                     · Widget.Measure：HeightSizePolicy=Fixed → 高度直接 = SuggestedHeight，不参与任何测量链
                                       （CoverChildren 高度 = 子内容高度，受文本折行/字体行高影响，此前间隔全由它产生）；
                                     · LayoutLinearVertical：VerticalBottomToTop 下逐项紧贴，num6 均分间距只在
                                       VerticalSpaced 消费 → 项间距 = 按钮高 + Margin，Margin=0 → 完全无缝。
                                     全宽（StretchToParent）+ 文本居中折行：右对齐参差/水平溢出同时消除。
                                     🔴 2026-08-20（第二次调整）：高度 40→26（用户反馈：按钮高度远高于文字大小，
                                     14px 文字行高约 18px，26px = 文字 + 上下各 4px padding）。
                                     候选项条数上限由 ImCommandFlow.CollectTargetCandidates(maxCount:3) 截断。 -->
                                <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                              Brush="LWN_Btn_Message"
                                              Command.Click="Execute"
                                              IsEnabled="@IsEnabled" MarginTop="0" MarginBottom="0">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                Text="@Text" Brush="MyBrush_18_White" Brush.FontSize="14"
                                                Brush.TextHorizontalAlignment="Center"
                                                WordWrapping="Wrap"
                                                MarginLeft="8" MarginRight="8"
                                                DoNotAcceptEvents="true"/>
                                  </Children>
                                </ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>
                      </Children>
                    </Widget>
                  </Children>
                </Widget>

                <!-- 🔴 Q4（2026-08-17 手柄提示行）：输入行上方灰字（仅手柄设备；字形动态拼）。
                     声明在输入行之前（LWN 惯例：VerticalBottomToTop + 子元素按屏幕从上到下书写）。 -->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                            Text="@PadHintText" Brush="MyBrush_18_White" Brush.FontSize="12" Brush.FontColor="#888888CC"
                            HorizontalAlignment="Left" MarginLeft="12" MarginTop="2" MarginBottom="2"
                            IsVisible="@HasPadHint"
                            DoNotAcceptEvents="true"/>

                <!-- ═══ 输入行：输入框 + 发送（2026-08-15 用户裁定：频道切换在标题行，输入行独占最宽）═══ -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50"
                        Sprite="BlankWhiteSquare_9" Color="#00000088"
                        DoNotAcceptEvents="true">
                  <Children>
                    <!-- 分隔线：输入行与消息区边界 -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2"
                            VerticalAlignment="Top"
                            Sprite="BlankWhiteSquare_9" Color="#FFFFFF33"
                            DoNotAcceptEvents="true"/>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                               StackLayout.LayoutMethod="HorizontalLeftToRight"
                               DoNotAcceptEvents="true">
                      <Children>
                        <!-- 输入框（与完整模式同字段：切模式草稿保留） -->
                        <EditableTextWidget Id="LWN_ImChat_CompactInput" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                            Text="@InputText" DefaultSearchText="@PlaceholderText"
                                            TextColor="#FFFFFFFF" Brush="MyBrush_16_Left" Brush.FontSize="16"
                                            GamepadNavigationIndex="6"
                                            MarginRight="6" VerticalAlignment="Center"/>
                        <!-- 发送按钮（Id 2026-08-18 手柄手动导航：KS 焦点项 widget 定位） -->
