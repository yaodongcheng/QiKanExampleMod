<Prefab>
  <Window Id="LWN_HeroSelect">
    <!-- 选人界面（对标 StartAsAnyone 的选人思路，但用我们自己的布局，不用它的 GUI）：
         左列王国 → 中列家族 → 右列英雄（点上级刷新下级）；右上「自定义英雄」走现有建号；
         右下「返回」回选剧本、「确认」用当前选中英雄开局。
         命令绑定：Command.Click / Command.HoverBegin → 各 ItemVM 的 ExecutePick。
         🔴 与选剧本界面同款自建 Screen 方案（不改主菜单列表——MCM 会崩，见 Knowledge/骑砍2主菜单与自定义UI层.md）。 -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            Sprite="BlankWhiteSquare_9" Color="#0A0A12E6"
            DoNotAcceptEvents="false">
      <Children>

        <!-- 标题（左上） -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="420" SuggestedHeight="56"
                HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="70" MarginTop="46"
                Sprite="StdAssets\Popup\canvas_dark" DoNotAcceptEvents="true">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Text="@TitleText" Brush="Popup.Title.Text" Brush.TextHorizontalAlignment="Center"
                        Brush.FontSize="30" VerticalAlignment="Center"
                        DoNotAcceptEvents="true"/>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="frame_9" ExtendLeft="14" ExtendTop="14" ExtendRight="14" ExtendBottom="14"
                    IsEnabled="false" DoNotAcceptEvents="true"/>
          </Children>
        </Widget>

        <!-- 右上：自定义英雄（走现有建号流程） -->
        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="240" SuggestedHeight="52"
                      HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="90" MarginTop="46"
                      Brush="Test.Button3" Command.Click="ExecuteCustomHero">
          <Children>
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                        Text="@CustomHeroText" Brush="MyBrush_24" Brush.FontSize="22"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        DoNotAcceptEvents="true"/>
          </Children>
        </ButtonWidget>

        <!-- ============ 三列：王国 / 家族 / 英雄 ============ -->
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                   DoNotAcceptEvents="true">
          <Children>

            <!-- ① 王国列 -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="380" SuggestedHeight="560"
                    Sprite="StdAssets\Popup\canvas_dark" MarginRight="24" DoNotAcceptEvents="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40"
                            Text="@KingdomHeader" Brush="Popup.Title.Text" Brush.TextHorizontalAlignment="Center"
                            Brush.FontSize="24" VerticalAlignment="Top" MarginTop="10"
                            DoNotAcceptEvents="true"/>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="470"
                           VerticalAlignment="Bottom" MarginBottom="20" MarginLeft="16" MarginRight="16"
                           StackLayout.LayoutMethod="VerticalBottomToTop"
                           DataSource="{Kingdoms}">
                  <ItemTemplate>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="348" SuggestedHeight="52"
                                  Brush="Test.Button3" MarginTop="8"
                                  Command.Click="ExecutePick">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    Text="@Name" Brush="MyBrush_18_White" Brush.FontSize="20"
                                    Brush.FontColor="@TextColor"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    DoNotAcceptEvents="true"/>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Sprite="frame_9" ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                                IsVisible="@IsSelected" IsEnabled="false" DoNotAcceptEvents="true"/>
                      </Children>
                    </ButtonWidget>
                  </ItemTemplate>
                </ListPanel>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="frame_9" ExtendLeft="14" ExtendTop="14" ExtendRight="14" ExtendBottom="14"
                        IsEnabled="false" DoNotAcceptEvents="true"/>
              </Children>
            </Widget>

            <!-- ② 家族列 -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="380" SuggestedHeight="560"
                    Sprite="StdAssets\Popup\canvas_dark" MarginRight="24" DoNotAcceptEvents="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40"
                            Text="@ClanHeader" Brush="Popup.Title.Text" Brush.TextHorizontalAlignment="Center"
                            Brush.FontSize="24" VerticalAlignment="Top" MarginTop="10"
                            DoNotAcceptEvents="true"/>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="470"
                           VerticalAlignment="Bottom" MarginBottom="20" MarginLeft="16" MarginRight="16"
                           StackLayout.LayoutMethod="VerticalBottomToTop"
                           DataSource="{Clans}">
                  <ItemTemplate>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="348" SuggestedHeight="52"
                                  Brush="Test.Button3" MarginTop="8"
                                  Command.Click="ExecutePick">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    Text="@Name" Brush="MyBrush_18_White" Brush.FontSize="20"
                                    Brush.FontColor="@TextColor"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    DoNotAcceptEvents="true"/>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Sprite="frame_9" ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                                IsVisible="@IsSelected" IsEnabled="false" DoNotAcceptEvents="true"/>
                      </Children>
                    </ButtonWidget>
                  </ItemTemplate>
                </ListPanel>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="frame_9" ExtendLeft="14" ExtendTop="14" ExtendRight="14" ExtendBottom="14"
                        IsEnabled="false" DoNotAcceptEvents="true"/>
              </Children>
            </Widget>

            <!-- ③ 英雄列（带身份小字：族长/国王/领主） -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="380" SuggestedHeight="560"
                    Sprite="StdAssets\Popup\canvas_dark" DoNotAcceptEvents="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40"
                            Text="@HeroHeader" Brush="Popup.Title.Text" Brush.TextHorizontalAlignment="Center"
                            Brush.FontSize="24" VerticalAlignment="Top" MarginTop="10"
                            DoNotAcceptEvents="true"/>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="470"
                           VerticalAlignment="Bottom" MarginBottom="20" MarginLeft="16" MarginRight="16"
                           StackLayout.LayoutMethod="VerticalBottomToTop"
                           DataSource="{Heroes}">
                  <ItemTemplate>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="348" SuggestedHeight="56"
                                  Brush="Test.Button3" MarginTop="8"
                                  Command.Click="ExecutePick">
                      <Children>
                        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   DoNotAcceptEvents="true">
                          <Children>
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="@Name" Brush="MyBrush_18_White" Brush.FontSize="20"
                                        Brush.FontColor="@TextColor" VerticalAlignment="Center" MarginRight="14"
                                        DoNotAcceptEvents="true"/>
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="@Role" Brush="MyBrush_18_White" Brush.FontSize="16"
                                        VerticalAlignment="Center"
                                        DoNotAcceptEvents="true"/>
                          </Children>
                        </ListPanel>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Sprite="frame_9" ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                                IsVisible="@IsSelected" IsEnabled="false" DoNotAcceptEvents="true"/>
                      </Children>
                    </ButtonWidget>
                  </ItemTemplate>
                </ListPanel>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="frame_9" ExtendLeft="14" ExtendTop="14" ExtendRight="14" ExtendBottom="14"
                        IsEnabled="false" DoNotAcceptEvents="true"/>
              </Children>
            </Widget>

          </Children>
        </ListPanel>

        <!-- 底部：将扮演谁（左）+ 返回/确认（右） -->
        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                    Text="@SelectedHeroText" Brush="MyBrush_18_White" Brush.FontSize="22"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" MarginLeft="90" MarginBottom="60"
                    DoNotAcceptEvents="true"/>

        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="90" MarginBottom="50">
          <Children>
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="56"
                          Brush="Test.Button3" MarginRight="24" Command.Click="ExecuteBack">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            Text="@BackText" Brush="MyBrush_24" Brush.FontSize="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            DoNotAcceptEvents="true"/>
              </Children>
            </ButtonWidget>
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="56"
                          Brush="Test.Button3" IsEnabled="@CanConfirm" Command.Click="ExecuteConfirm">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            Text="@ConfirmText" Brush="MyBrush_24" Brush.FontSize="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            DoNotAcceptEvents="true"/>
              </Children>
            </ButtonWidget>
          </Children>
        </ListPanel>

      </Children>
    </Widget>
  </Window>
</Prefab>
