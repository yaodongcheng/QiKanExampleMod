<Prefab>
  <Window Id="LWN_HeroSelect">
    <!-- 选人界面（**建世界之前**，配 CampaignMode/HeroSelectScreen.cs）：
         树模式 = 左列王国 → 中列家族 → 右列领主（点上级刷新下级，点人名开详情页）；
         推荐模式 = 一整列推荐人卡（IsRecommendedMode）。
         右下「返回」回选剧本页。
         🔴 数据全来自**静态表**（HeroCatalogRegistry / HeroProfileRegistry / 立绘表），
            不读 Campaign.Current——所以能在长 loading 之前显示（见 plan §十）。
         🔴 根底色**全不透明**（FF）：界面下面压着主菜单屏，半透明会透出来。
         🔴 与选剧本界面同款自建 Screen 方案（不改主菜单列表——MCM 会崩，
            见 Knowledge/骑砍2主菜单与自定义UI层.md）。 -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            Sprite="BlankWhiteSquare_9" Color="#0A0A12FF"
            DoNotAcceptEvents="false">
      <Children>

        <!-- 标题（左上） -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="420" SuggestedHeight="56"
                HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="70" MarginTop="46"
                Sprite="StdAssets\Popup\canvas_dark" DoNotAcceptEvents="true">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Text="@TitleText" Brush="Popup.Title.Text" Brush.TextHorizontalAlignment="Center"
                        Brush.FontSize="30" VerticalAlignment="Center"
                        DoNotAcceptEvents="true"/>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="frame_9" ExtendLeft="14" ExtendTop="14" ExtendRight="14" ExtendBottom="14"
                    IsEnabled="false" DoNotAcceptEvents="true"/>
          </Children>
        </Widget>

        <!-- ============ 三列：王国 / 家族 / 英雄（树模式）============ -->
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   StackLayout.LayoutMethod="HorizontalLeftToRight"
                   IsVisible="@IsTreeMode"
                   DoNotAcceptEvents="true">
          <Children>

            <!-- ⓪ 身份筛档列（最左）：全部 + 内容包配的各档（武将/商人/忍者/海贼/其他）。
                 数据来自目录 <RealmType>，标签是内容包自有键（基座不认识这些词）。
                 档数固定很小，滚动三件套只为「内容包配了很多档」兜底（AutoHideScrollBars：
                 不超限就自动不显示）。 -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="208" SuggestedHeight="560"
                    Sprite="StdAssets\Popup\canvas_dark" MarginRight="24" DoNotAcceptEvents="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40"
                            Text="@IdentityHeader" Brush="Popup.Title.Text" Brush.TextHorizontalAlignment="Center"
                            Brush.FontSize="24" VerticalAlignment="Top" MarginTop="10"
                            DoNotAcceptEvents="true"/>
                <ScrollablePanel Id="LWN_HeroSelect_IdentityScroll"
                                 WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="470"
                                 VerticalAlignment="Bottom" MarginBottom="20" MarginLeft="14" MarginRight="14"
                                 AutoHideScrollBars="true"
                                 ClipRect="LWN_HeroSelect_IdentityClip"
                                 InnerPanel="LWN_HeroSelect_IdentityClip\LWN_HeroSelect_IdentityInner"
                                 VerticalScrollbar="..\LWN_HeroSelect_IdentityScrollbarHolder\LWN_HeroSelect_IdentityScrollbar">
                  <Children>
                    <Widget Id="LWN_HeroSelect_IdentityClip" ClipContents="true"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            DoNotAcceptEvents="true">
                      <Children>
                        <ListPanel Id="LWN_HeroSelect_IdentityInner" WidthSizePolicy="StretchToParent"
                                   HeightSizePolicy="CoverChildren"
                                   StackLayout.LayoutMethod="VerticalBottomToTop"
                                   DataSource="{Filters}">
                          <ItemTemplate>
                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                          SuggestedWidth="180" SuggestedHeight="52"
                                          Brush="Test.Button3" MarginTop="8"
                                          Command.Click="ExecutePick">
                              <Children>
                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                            Text="@Name" Brush="MyBrush_18_White" Brush.FontSize="20"
                                            Brush.FontColor="@TextColor"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            DoNotAcceptEvents="true"/>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        Sprite="frame_9" ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                                        IsVisible="@IsSelected" IsEnabled="false" DoNotAcceptEvents="true"/>
                              </Children>
                            </ButtonWidget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <!-- 滚动条 holder（🔴 与 ScrollablePanel 同级，理由同王国列注释） -->
                <Widget Id="LWN_HeroSelect_IdentityScrollbarHolder"
                        WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="470"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        MarginBottom="20" MarginRight="4" DoNotAcceptEvents="true">
                  <Children>
                    <ScrollbarWidget Id="LWN_HeroSelect_IdentityScrollbar"
                                     WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                     AlignmentAxis="Vertical" Handle="LWN_HeroSelect_IdentityScrollbarHandle"
                                     MaxValue="100" MinValue="0">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2"
                                HorizontalAlignment="Center"
                                Sprite="BlankWhiteSquare_9" Color="#A37434FF" MarginTop="5" MarginBottom="5" AlphaFactor="0.7"
                                DoNotAcceptEvents="true"/>
                        <ImageWidget Id="LWN_HeroSelect_IdentityScrollbarHandle"
                                     WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                     MinHeight="15" SuggestedHeight="10" SuggestedWidth="14"
                                     HorizontalAlignment="Center" Brush="SPChatlog.Scrollbar.Handle" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="frame_9" ExtendLeft="14" ExtendTop="14" ExtendRight="14" ExtendBottom="14"
                        IsEnabled="false" DoNotAcceptEvents="true"/>
              </Children>
            </Widget>

            <!-- ① 王国列 -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="380" SuggestedHeight="560"
                    Sprite="StdAssets\Popup\canvas_dark" MarginRight="24" DoNotAcceptEvents="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40"
                            Text="@KingdomHeader" Brush="Popup.Title.Text" Brush.TextHorizontalAlignment="Center"
                            Brush.FontSize="24" VerticalAlignment="Top" MarginTop="10"
                            DoNotAcceptEvents="true"/>
                <ScrollablePanel Id="LWN_HeroSelect_RealmScroll"
                                 WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="470"
                                 VerticalAlignment="Bottom" MarginBottom="20" MarginLeft="16" MarginRight="16"
                                 AutoHideScrollBars="true"
                                 ClipRect="LWN_HeroSelect_RealmClip"
                                 InnerPanel="LWN_HeroSelect_RealmClip\LWN_HeroSelect_RealmInner"
                                 VerticalScrollbar="..\LWN_HeroSelect_RealmScrollbarHolder\LWN_HeroSelect_RealmScrollbar">
                  <Children>
                    <Widget Id="LWN_HeroSelect_RealmClip" ClipContents="true"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            DoNotAcceptEvents="true">
                      <Children>
                        <ListPanel Id="LWN_HeroSelect_RealmInner" WidthSizePolicy="StretchToParent"
                                   HeightSizePolicy="CoverChildren"
                                   StackLayout.LayoutMethod="VerticalBottomToTop"
                                   DataSource="{Realms}">
                          <ItemTemplate>
                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                          SuggestedWidth="348" SuggestedHeight="52"
                                          Brush="Test.Button3" MarginTop="8"
                                          Command.Click="ExecutePick">
                              <Children>
                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                            Text="@Name" Brush="MyBrush_18_White" Brush.FontSize="20"
                                            Brush.FontColor="@TextColor"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            DoNotAcceptEvents="true"/>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        Sprite="frame_9" ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                                        IsVisible="@IsSelected" IsEnabled="false" DoNotAcceptEvents="true"/>
                              </Children>
                            </ButtonWidget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <!-- 滚动条 holder（🔴 必须与 ScrollablePanel **同级**：VerticalScrollbar 里的 `..`
                     指向面板父级再按 Id 找直接子级，放进面板内部 = 路径 null = 滚动整个失效） -->
                <Widget Id="LWN_HeroSelect_RealmScrollbarHolder"
                        WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="470"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        MarginBottom="20" MarginRight="4" DoNotAcceptEvents="true">
                  <Children>
                    <ScrollbarWidget Id="LWN_HeroSelect_RealmScrollbar"
                                     WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                     AlignmentAxis="Vertical" Handle="LWN_HeroSelect_RealmScrollbarHandle"
                                     MaxValue="100" MinValue="0">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2"
                                HorizontalAlignment="Center"
                                Sprite="BlankWhiteSquare_9" Color="#A37434FF" MarginTop="5" MarginBottom="5" AlphaFactor="0.7"
                                DoNotAcceptEvents="true"/>
                        <ImageWidget Id="LWN_HeroSelect_RealmScrollbarHandle"
                                     WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                     MinHeight="15" SuggestedHeight="10" SuggestedWidth="14"
                                     HorizontalAlignment="Center" Brush="SPChatlog.Scrollbar.Handle" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="frame_9" ExtendLeft="14" ExtendTop="14" ExtendRight="14" ExtendBottom="14"
                        IsEnabled="false" DoNotAcceptEvents="true"/>
              </Children>
            </Widget>

            <!-- ② 家族列 -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="380" SuggestedHeight="560"
                    Sprite="StdAssets\Popup\canvas_dark" MarginRight="24" DoNotAcceptEvents="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40"
                            Text="@ClanHeader" Brush="Popup.Title.Text" Brush.TextHorizontalAlignment="Center"
                            Brush.FontSize="24" VerticalAlignment="Top" MarginTop="10"
                            DoNotAcceptEvents="true"/>
                <ScrollablePanel Id="LWN_HeroSelect_HouseScroll"
                                 WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="470"
                                 VerticalAlignment="Bottom" MarginBottom="20" MarginLeft="16" MarginRight="16"
                                 AutoHideScrollBars="true"
                                 ClipRect="LWN_HeroSelect_HouseClip"
                                 InnerPanel="LWN_HeroSelect_HouseClip\LWN_HeroSelect_HouseInner"
                                 VerticalScrollbar="..\LWN_HeroSelect_HouseScrollbarHolder\LWN_HeroSelect_HouseScrollbar">
                  <Children>
                    <Widget Id="LWN_HeroSelect_HouseClip" ClipContents="true"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            DoNotAcceptEvents="true">
                      <Children>
                        <ListPanel Id="LWN_HeroSelect_HouseInner" WidthSizePolicy="StretchToParent"
                                   HeightSizePolicy="CoverChildren"
                                   StackLayout.LayoutMethod="VerticalBottomToTop"
                                   DataSource="{Houses}">
                          <ItemTemplate>
                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                          SuggestedWidth="348" SuggestedHeight="52"
                                          Brush="Test.Button3" MarginTop="8"
                                          Command.Click="ExecutePick">
                              <Children>
                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                            Text="@Name" Brush="MyBrush_18_White" Brush.FontSize="20"
                                            Brush.FontColor="@TextColor"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            DoNotAcceptEvents="true"/>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        Sprite="frame_9" ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                                        IsVisible="@IsSelected" IsEnabled="false" DoNotAcceptEvents="true"/>
                              </Children>
                            </ButtonWidget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <!-- 滚动条 holder（🔴 与 ScrollablePanel 同级，理由同王国列注释） -->
                <Widget Id="LWN_HeroSelect_HouseScrollbarHolder"
                        WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="470"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        MarginBottom="20" MarginRight="4" DoNotAcceptEvents="true">
                  <Children>
                    <ScrollbarWidget Id="LWN_HeroSelect_HouseScrollbar"
                                     WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                     AlignmentAxis="Vertical" Handle="LWN_HeroSelect_HouseScrollbarHandle"
                                     MaxValue="100" MinValue="0">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2"
                                HorizontalAlignment="Center"
                                Sprite="BlankWhiteSquare_9" Color="#A37434FF" MarginTop="5" MarginBottom="5" AlphaFactor="0.7"
                                DoNotAcceptEvents="true"/>
                        <ImageWidget Id="LWN_HeroSelect_HouseScrollbarHandle"
                                     WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                     MinHeight="15" SuggestedHeight="10" SuggestedWidth="14"
                                     HorizontalAlignment="Center" Brush="SPChatlog.Scrollbar.Handle" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="frame_9" ExtendLeft="14" ExtendTop="14" ExtendRight="14" ExtendBottom="14"
                        IsEnabled="false" DoNotAcceptEvents="true"/>
              </Children>
            </Widget>

            <!-- ③ 英雄列（带身份小字：族长/国王/领主） -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="380" SuggestedHeight="560"
                    Sprite="StdAssets\Popup\canvas_dark" DoNotAcceptEvents="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40"
                            Text="@HeroHeader" Brush="Popup.Title.Text" Brush.TextHorizontalAlignment="Center"
                            Brush.FontSize="24" VerticalAlignment="Top" MarginTop="10"
                            DoNotAcceptEvents="true"/>
                <ScrollablePanel Id="LWN_HeroSelect_LordScroll"
                                 WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="470"
                                 VerticalAlignment="Bottom" MarginBottom="20" MarginLeft="16" MarginRight="16"
                                 AutoHideScrollBars="true"
                                 ClipRect="LWN_HeroSelect_LordClip"
                                 InnerPanel="LWN_HeroSelect_LordClip\LWN_HeroSelect_LordInner"
                                 VerticalScrollbar="..\LWN_HeroSelect_LordScrollbarHolder\LWN_HeroSelect_LordScrollbar">
                  <Children>
                    <Widget Id="LWN_HeroSelect_LordClip" ClipContents="true"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            DoNotAcceptEvents="true">
                      <Children>
                        <ListPanel Id="LWN_HeroSelect_LordInner" WidthSizePolicy="StretchToParent"
                                   HeightSizePolicy="CoverChildren"
                                   StackLayout.LayoutMethod="VerticalBottomToTop"
                                   DataSource="{Lords}">
                          <ItemTemplate>
                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                          SuggestedWidth="348" SuggestedHeight="56"
                                          Brush="Test.Button3" MarginTop="8"
                                          Command.Click="ExecutePick">
                              <Children>
                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           DoNotAcceptEvents="true">
                                  <Children>
                                    <!-- 行内小头像（立绘表按 StringId 查；无图 = 不画）
                                         🔴 VM 给的是 `Sprite` **对象**，不是名字串（绑名字给 Sprite= 静默无效） -->
                                    <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                 SuggestedWidth="40" SuggestedHeight="40"
                                                 Sprite="@MiniSprite" IsVisible="@HasMini"
                                                 VerticalAlignment="Center" MarginRight="12"
                                                 DoNotAcceptEvents="true"/>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                Text="@Name" Brush="MyBrush_18_White" Brush.FontSize="20"
                                                Brush.FontColor="@TextColor" VerticalAlignment="Center" MarginRight="14"
                                                DoNotAcceptEvents="true"/>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                Text="@Role" Brush="MyBrush_18_White" Brush.FontSize="16"
                                                VerticalAlignment="Center"
                                                DoNotAcceptEvents="true"/>
                                  </Children>
                                </ListPanel>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        Sprite="frame_9" ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                                        IsVisible="@IsSelected" IsEnabled="false" DoNotAcceptEvents="true"/>
                              </Children>
                            </ButtonWidget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <!-- 滚动条 holder（🔴 与 ScrollablePanel 同级，理由同王国列注释） -->
                <Widget Id="LWN_HeroSelect_LordScrollbarHolder"
                        WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="470"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        MarginBottom="20" MarginRight="4" DoNotAcceptEvents="true">
                  <Children>
                    <ScrollbarWidget Id="LWN_HeroSelect_LordScrollbar"
                                     WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                     AlignmentAxis="Vertical" Handle="LWN_HeroSelect_LordScrollbarHandle"
                                     MaxValue="100" MinValue="0">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2"
                                HorizontalAlignment="Center"
                                Sprite="BlankWhiteSquare_9" Color="#A37434FF" MarginTop="5" MarginBottom="5" AlphaFactor="0.7"
                                DoNotAcceptEvents="true"/>
                        <ImageWidget Id="LWN_HeroSelect_LordScrollbarHandle"
                                     WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                     MinHeight="15" SuggestedHeight="10" SuggestedWidth="14"
                                     HorizontalAlignment="Center" Brush="SPChatlog.Scrollbar.Handle" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="frame_9" ExtendLeft="14" ExtendTop="14" ExtendRight="14" ExtendBottom="14"
                        IsEnabled="false" DoNotAcceptEvents="true"/>
              </Children>
            </Widget>

          </Children>
        </ListPanel>

        <!-- ============ 推荐人列表（推荐模式；版式照太阁5 每行一条大按钮）============ -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="860" SuggestedHeight="620"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Sprite="StdAssets\Popup\canvas_dark" IsVisible="@IsRecommendedMode"
                DoNotAcceptEvents="true">
          <Children>
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                       MarginLeft="16" MarginRight="16" MarginTop="16" MarginBottom="16"
                       StackLayout.LayoutMethod="VerticalBottomToTop"
                       DataSource="{RecommendedItems}">
              <ItemTemplate>
                <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="108"
                              Brush="Test.Button3" MarginTop="8" Command.Click="ExecutePick">
                  <Children>
                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                               StackLayout.LayoutMethod="HorizontalLeftToRight"
                               HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="14"
                               DoNotAcceptEvents="true">
                      <Children>
                        <!-- 头像（🔴 VM 给的是 `Sprite` 对象，不是名字串） -->
                        <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                     SuggestedWidth="84" SuggestedHeight="84"
                                     Sprite="@MiniSprite" IsVisible="@HasMini"
                                     VerticalAlignment="Center" MarginRight="16"
                                     DoNotAcceptEvents="true"/>
                        <!-- 姓名 / 年龄 -->
                        <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="190"
                                   StackLayout.LayoutMethod="VerticalBottomToTop"
                                   VerticalAlignment="Center" MarginRight="16"
                                   DoNotAcceptEvents="true">
                          <Children>
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="@Name" Brush="MyBrush_18_White" Brush.FontSize="24"
                                        Brush.FontColor="@TextColor" DoNotAcceptEvents="true"/>
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="@AgeText" Brush="MyBrush_18_White" Brush.FontSize="16"
                                        MarginTop="2" DoNotAcceptEvents="true"/>
                          </Children>
                        </ListPanel>
                        <!-- 型别标签 -->
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                SuggestedWidth="150" SuggestedHeight="34"
                                Sprite="StdAssets\Popup\canvas_dark"
                                VerticalAlignment="Center" MarginRight="18" DoNotAcceptEvents="true">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        Text="@StoryType" Brush="MyBrush_18_White" Brush.FontSize="16"
                                        Brush.TextHorizontalAlignment="Center" VerticalAlignment="Center"
                                        DoNotAcceptEvents="true"/>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Sprite="frame_9" ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                                    IsEnabled="false" DoNotAcceptEvents="true"/>
                          </Children>
                        </Widget>
                        <!-- 目标描述（两行小字） -->
                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="330"
                                    Text="@StoryGoal" Brush="MyBrush_18_White" Brush.FontSize="15"
                                    VerticalAlignment="Center" DoNotAcceptEvents="true"/>
                      </Children>
                    </ListPanel>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="frame_9" ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                            IsVisible="@IsSelected" IsEnabled="false" DoNotAcceptEvents="true"/>
                  </Children>
                </ButtonWidget>
              </ItemTemplate>
            </ListPanel>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="frame_9" ExtendLeft="14" ExtendTop="14" ExtendRight="14" ExtendBottom="14"
                    IsEnabled="false" DoNotAcceptEvents="true"/>
          </Children>
        </Widget>

        <!-- 底部：返回（🔴 没有「确认」——点人名进详情页，由详情页的 [决定] 落地） -->
        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="56"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="90" MarginBottom="50"
                      Brush="Test.Button3" Command.Click="ExecuteBack">
          <Children>
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                        Text="@BackText" Brush="MyBrush_24" Brush.FontSize="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        DoNotAcceptEvents="true"/>
          </Children>
        </ButtonWidget>

      </Children>
    </Widget>
  </Window>
</Prefab>
