<?xml version="1.0" encoding="utf-8"?>
<!--
  PlaybackDialog.xml —— 剧本演绎对话面板（T7 重制 · 2026-08-31 v3 布局：用户实机三连否决后定稿）
  构图：半透明遮罩（地图退后，Brush 自带 alpha——⚠️ Color 属性不参与渲染（附录坑，纯白屏根源））
  → 底部对话框面板（横排：立绘槽 | 文字区）+ 主角镜像（SpriteMirror）。
  绑定源 = PlaybackDialogVM（Scenario/PlaybackDialogVM.cs）。
-->
<Prefab>
  <Window Id="LWN_PlaybackDialog">
    <!-- 🔴 根 Widget 可点：点击任意处 = 继续（旧 DialogChoice 同款交互；选项出现时 VM.OnClickContinue 自守卫）
         旧版样式参照：继续 = 右下淡色文字提示（#888），非按钮 -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            IsVisible="@IsVisible"
            Command.Click="OnClickContinue">
      <Children>

        <!-- ② 底部对话框面板（全宽 x 360，贴底；🔴 背景全透明 = 无全屏遮罩层——地图完整可见） -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="360"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                DoNotAcceptEvents="true">
          <Children>

            <!-- 面板底（半透明），Brush = Simple.Button.Bg（自带 alpha） -->
            <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                         Brush="Simple.Button.Bg"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         DoNotAcceptEvents="true" />

            <!-- ③ 立绘槽（面板内左侧，缩小 320x480；主角 = 镜像图——SpriteMirror；null = 隐藏） -->
            <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                         SuggestedWidth="320" SuggestedHeight="480"
                         Sprite="@PortraitLeft"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         MarginLeft="48" MarginBottom="8"
                         DoNotAcceptEvents="true"
                         IsVisible="@IsPortraitVisible" />

            <!-- ④ 文字区（面板内右侧：名字 + 正文；右侧留选项列） -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MarginLeft="400" MarginRight="40" MarginTop="16" MarginBottom="16"
                    DoNotAcceptEvents="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44"
                            Text="@SpeakerName"
                            FontSize="30"
                            Brush="Simple.Button.Text"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="10" MarginTop="8"
                            DoNotAcceptEvents="true" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Text="@DialogueContent"
                            FontSize="26"
                            Brush="Simple.Text"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="10" MarginTop="60" MarginRight="10" MarginBottom="16"
                            DoNotAcceptEvents="true" />
              </Children>
            </Widget>

            <!-- ⑤ 选项列（面板右侧竖列；@AreOptionsVisible） -->
            <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    MarginLeft="420" MarginRight="0" MarginTop="0" MarginBottom="16"
                    DoNotAcceptEvents="true"
                    IsVisible="@AreOptionsVisible">
              <Children>
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                           Id="LWN_PlaybackDialog_Options"
                           StackLayout.LayoutMethod="VerticalTopToBottom"
                           DataSource="{OptionList}">
                  <ItemTemplate>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="360" SuggestedHeight="52"
                                  Brush="Simple.Button.Bg"
                                  Command.Click="ExecuteOption"
                                  MarginBottom="10">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Text="@OptionText" Brush="Simple.Button.Text"
                                    Brush.TextHorizontalAlignment="Center"
                                    DoNotAcceptEvents="true"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Children>
                    </ButtonWidget>
                  </ItemTemplate>
                </ListPanel>
              </Children>
            </Widget>

            <!-- ⑥ 继续提示（右下淡色文字，@AreContinueVisible；点击本体 = 根 Widget 任意处） -->
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                        Text="@ContinueHintText"
                        FontSize="22"
                        Brush="Simple.Text"
                        TextColor="#88888888"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        MarginRight="48" MarginBottom="16"
                        DoNotAcceptEvents="true"
                        IsVisible="@AreContinueVisible" />

          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
