<Prefab>
  <Window>
    <!-- 1. 右下角容器 -->
    <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible = "@IsVisible"
            MarginRight="0" MarginBottom="180">
      <Children>

        <!-- 2. 主列表：从下往上排列 (名字在最下，选项在上方) -->
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom"
                   Id="LWN_MainList_InteractArea" LayoutMethod="VerticalBottomToTop">
            <Children>

                 <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    Text="@TargetName" IsVisible="@HasTarget"
                                    Brush="MyBrush_24" MarginRight="0"
                                    TextColor="#FFFFFFFF"
                                    HorizontalAlignment="Center"/>

	       <!-- 装饰线 -->
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="5"
                                Sprite="BlankWhiteSquare_9" Color="#FFFFFF88"  HorizontalAlignment="Right"  MarginTop="10"
                                MarginBottom="5" IsVisible="@HasTarget"
                               />

                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                           DataSource="{InteractionList}"
                           Id="LWN_InteractArea_Items" LayoutMethod="VerticalBottomToTop" StackLayout.LayoutMethod="VerticalBottomToTop"
                           MarginBottom="5" HorizontalAlignment="Right"
                           ItemGap="10">
                    
                    <ItemTemplate>


                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                   LayoutMethod="HorizontalRightToLeft" StackLayout.LayoutMethod="HorizontalRightToLeft" MarginRight="0"
                                   HorizontalAlignment="Right">
                            <Children>


								<!-- 按键提示 (例如 "[F]") -->
                                <!-- 键帽：近白底纹 + 四周边（没蓄力灰白 / 蓄力中绿 / 完成金，Long 玩法）+ 键名。短按项无四边。 -->
                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="30">
                                    <Children>

                                        <!-- 底纹：按按法区分——Short 纯白（无四边）、Long 近白（+四边），玩家一眼看出交互方式（用户拍板 2026-08-06） -->
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="@KeycapColor" />

                                        <!-- 四周边 + 填充（Long 玩法常显；短按项整体 IsVisible=false，RequiresHold 由 PressMode==Long 推导） -->
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@RequiresHold">
                                            <Children>
                                                <!-- 四边灰白底（常显实心，未蓄力时的空白状态）；进度填充 = @SegColor（蓄力中绿→完成金），覆盖灰白边之上
                                                     贴键帽边缘（Margin=0、满宽 30）——盖住近白底纹外缘，近白色只露出在框内中心。
                                                     锚定方向构成顺时针连续闭环：上条 Left+Top(左→右) → 右条 Right+Top(上→下) → 下条 Right+Bottom(右→左) → 左条 Left+Bottom(下→上)（左上→右上→右下→左下→左上，段间无跳变）。
                                                     Gauntlet 双轴独立：每条必须同时显式写 HorizontalAlignment + VerticalAlignment（缺一个轴默认 Left/Top，会全部堆到左上角）。
                                                     填充条 = 绿→金（100% 不透明，声明在边之后渲染在上层），长度绑 VM 每帧算好的像素值（满长 30 = 键帽边长）。 -->
                                                <!-- 上：左→右（贴键帽边缘：盖住近白底纹外缘，近白色只露出在框内中心） -->
                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="3" MarginTop="0" MarginLeft="0" HorizontalAlignment="Left" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="#CCCCCCFF" />
                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@SegFillWidth0" SuggestedHeight="3" MarginTop="0" MarginLeft="0" HorizontalAlignment="Left" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="@SegColor" />
                                                <!-- 右：上→下 -->
                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="3" SuggestedHeight="30" MarginTop="0" MarginRight="0" HorizontalAlignment="Right" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="#CCCCCCFF" />
                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="3" SuggestedHeight="@SegFillHeight1" MarginTop="0" MarginRight="0" HorizontalAlignment="Right" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="@SegColor" />
                                                <!-- 下：右→左 -->
                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="3" MarginRight="0" MarginBottom="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare_9" Color="#CCCCCCFF" />
                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@SegFillWidth2" SuggestedHeight="3" MarginRight="0" MarginBottom="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare_9" Color="@SegColor" />
                                                <!-- 左：下→上 -->
                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="3" SuggestedHeight="30" MarginBottom="0" MarginLeft="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare_9" Color="#CCCCCCFF" />
                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="3" SuggestedHeight="@SegFillHeight3" MarginBottom="0" MarginLeft="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare_9" Color="@SegColor" />
                                            </Children>
                                        </Widget>

                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    Text="@KeyText"
                                                    Brush="MyBrush_24"
                                                    TextColor="#000000FF"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Children>
                                </Widget>
								
                                <!-- 动作名称 (例如 "交谈") -->
                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                            Text="@ActionText"
                                            Brush="MyBrush_24"
                                            TextColor="#DDDDDDFF"
                                            VerticalAlignment="Center"
                                            MarginRight="5"/>

                                

                            </Children>
                        </ListPanel>
						
						   </ItemTemplate>

                </ListPanel>

            </Children>
        </ListPanel>

      </Children>
    </Widget>
  </Window>
</Prefab>