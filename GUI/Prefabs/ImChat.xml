<Prefab>
  <Window Id="LWN">
    <!-- 全屏根 = 轻遮罩 + 点击盾牌：面板外点击关闭面板（微信式）；40% 黑压暗世界聚焦面板（保留情境感知） -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            Sprite="BlankWhiteSquare_9" Color="#00000066"
            Command.Click="ExecuteClose"
            DoNotAcceptEvents="false">
      <Children>

        <!-- 主面板 (1000x640 居中，canvas_dark + frame_9 边框 Extend 18 画在逻辑盒外) -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1000" SuggestedHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Sprite="StdAssets\Popup\canvas_dark"
                DoNotAcceptEvents="true">
          <Children>

            <!-- 标题带（🔴 五轮：改 ListPanel 横向布局——标题 + 正在思考 + 模式区 + 关闭 顺序排布，杜绝普通 Widget 子元素重叠） -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="46"
                    VerticalAlignment="Top"
                    Sprite="BlankWhiteSquare_9" Color="#000000B3"
                    DoNotAcceptEvents="true">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                           DoNotAcceptEvents="true">
                  <Children>
                    <!-- 标题：左对齐金字，撑满剩余空间（后置元素从右侧挤占） -->
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Text="@Title" Brush="Popup.Title.Text" Brush.TextHorizontalAlignment="Left" Brush.FontSize="28"
                                VerticalAlignment="Center" MarginLeft="24"
                                DoNotAcceptEvents="true"/>

                    <!-- 「XX 正在思考回复…」：仅私聊回复在途时显示（🔴 五轮：从输入区移到标题带，群聊不显示） -->
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                Text="@TypingText" Brush="MyBrush_18_White" Brush.FontSize="13" Brush.FontColor="#88CC88FF"
                                VerticalAlignment="Center" MarginLeft="16" MarginRight="16"
                                IsVisible="@IsTypingVisible"
                                DoNotAcceptEvents="true"/>

                    <!-- 模式切换（2026-08-10 终版）：状态文本 + 单按钮并排（ListPanel 防重叠）。
                         左侧 = 当前模式静态文本（「当前：计划模式」）；右侧 = 单个按钮，文本随模式变量切换
                         （「切换到计划」⇄「切换到闲聊」，点击路由由 View 按当前模式决定——Command.Click 固定方法绑定，
                         故用单方法 ExecuteSwitchMode 内部路由）。
                         密令侧模式名随上下文（Mission=计划 / 大地图=计划）；仅密令可用会话显示（IsModeControlVisible）。 -->
                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                               StackLayout.LayoutMethod="HorizontalLeftToRight"
                               VerticalAlignment="Center" MarginLeft="8" MarginRight="8"
                               IsVisible="@IsModeControlVisible">
                      <Children>
                        <!-- 当前模式静态文本（按钮左侧） -->
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    Text="@ModeStatusText" Brush="MyBrush_18_White" Brush.FontSize="14" Brush.FontColor="#C8C8C8FF"
                                    VerticalAlignment="Center"
                                    DoNotAcceptEvents="true"/>
                        <!-- 单个切换按钮：文本随模式变量切换，点击内部路由 -->
                        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="112" SuggestedHeight="32"
                                      Brush="Test.Button3"
                                      Command.Click="ExecuteSwitchMode"
                                      VerticalAlignment="Center" MarginLeft="10">
                          <Children>
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="@SwitchModeButtonText" Brush="MyBrush_18_White" Brush.FontSize="15"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        DoNotAcceptEvents="true"/>
                          </Children>
                        </ButtonWidget>
                      </Children>
                    </ListPanel>

                    <!-- 关闭按钮 -->
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="38" SuggestedHeight="32"
                                  VerticalAlignment="Center" MarginLeft="8" MarginRight="18"
                                  Brush="Popup.CloseButton"
                                  Command.Click="ExecuteClose"/>
                  </Children>
                </ListPanel>
              </Children>
            </Widget>

            <!-- 标题分隔线 -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="23"
                    VerticalAlignment="Top" MarginTop="46"
                    Sprite="StdAssets\Popup\divider"
                    DoNotAcceptEvents="true"/>

            <!-- ══════════ 主体：左栏频道 + 右栏消息流/输入区 ══════════ -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    VerticalAlignment="Top" MarginTop="69"
                    DoNotAcceptEvents="true">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                           DoNotAcceptEvents="true">
                  <Children>

                    <!-- ═══ 左栏 240px：频道/私聊列表 ═══ -->
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="240"
                            DoNotAcceptEvents="true">
                      <Children>
                        <ScrollablePanel Id="ChannelScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                         AutoHideScrollBars="true"
                                         ClipRect="ChannelClip" InnerPanel="ChannelClip\LWN_ImChat_ChannelInner"
                                         VerticalScrollbar="..\ChannelScrollbarHolder\ChannelScrollbar"
                                         MarginLeft="10" MarginRight="18" MarginTop="10" MarginBottom="10">
                          <Children>
                            <Widget Id="ChannelClip" ClipContents="true"
                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    DoNotAcceptEvents="true">
                              <Children>
                                <!-- LWN_ 前缀：双版本布局 swap 补丁兼容（VerticalBottomToTop + 子元素按屏幕从上到下书写） -->
                                <ListPanel Id="LWN_ImChat_ChannelInner" DataSource="{ChannelList}"
                                           WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                           StackLayout.LayoutMethod="VerticalBottomToTop"
                                           DoNotAcceptEvents="true">
                                  <ItemTemplate>
                                    <!-- 分组标题行（频道/私聊，不可点击）与频道行（可点击）互斥 -->
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            DoNotAcceptEvents="true">
                                      <Children>
                                        <!-- 分组标题（2026-08-10：加大字距提亮，区块分隔更醒目） -->
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32"
                                                    Text="@Title" Brush="MyBrush_18_White" Brush.FontSize="16" Brush.FontColor="#FFD75E99"
                                                    Brush.TextHorizontalAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    MarginLeft="14" MarginTop="6" MarginBottom="4"
                                                    IsVisible="@IsGroupHeader"
                                                    DoNotAcceptEvents="true"/>

                                        <!-- 频道/私聊行：两行式（🔴 2026-08-10 UX 修复——标题与预览不再挤同一行：标题+未读在上、预览左对齐在下） -->
                                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="52"
                                                      Brush="ImChat.RowBg"
                                                      IsSelected="@IsSelected"
                                                      Command.Click="ExecuteSelect"
                                                      MarginBottom="4"
                                                      IsVisible="@IsNotGroupHeader">
                                          <Children>
                                            <!-- 第一行：标题（左对齐）+ 未读徽标（右） -->
                                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24"
                                                    VerticalAlignment="Top" MarginLeft="14" MarginRight="12" MarginTop="6"
                                                    DoNotAcceptEvents="true">
                                              <Children>
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                            Text="@Title" Brush="MyBrush_18_White" Brush.FontSize="17" Brush.FontColor="@TitleColor"
                                                            Brush.TextHorizontalAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center" MarginRight="40"
                                                            ClipContents="true"
                                                            DoNotAcceptEvents="true"/>
                                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                            Text="@UnreadText" Brush="MyBrush_18_White" Brush.FontSize="14" Brush.FontColor="#FFD75EFF"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            IsVisible="@HasUnread"
                                                            DoNotAcceptEvents="true"/>
                                              </Children>
                                            </Widget>
                                            <!-- 第二行：最后消息预览（左对齐，微信会话列表语义） -->
                                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="16"
                                                        Text="@Subtitle" Brush="MyBrush_18_White" Brush.FontSize="13" Brush.FontColor="#999999FF"
                                                        Brush.TextHorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom" MarginLeft="14" MarginRight="12" MarginBottom="4"
                                                        ClipContents="true"
                                                        DoNotAcceptEvents="true"/>
                                          </Children>
                                        </ButtonWidget>
                                      </Children>
                                    </Widget>
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </Widget>
                          </Children>
                        </ScrollablePanel>

                        <!-- 左栏滚动条（SPChatlog.Scrollbar.Handle 为 Native 笔刷，全局可用） -->
                        <Widget Id="ChannelScrollbarHolder" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Right" DoNotAcceptEvents="true">
                          <Children>
                            <ScrollbarWidget Id="ChannelScrollbar" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                             AlignmentAxis="Vertical" Handle="ChannelScrollbarHandle"
                                             MaxValue="100" MinValue="0">
                              <Children>
                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2"
                                        HorizontalAlignment="Center"
                                        Sprite="BlankWhiteSquare_9" Color="#A37434FF" MarginTop="5" MarginBottom="5" AlphaFactor="0.7"
                                        DoNotAcceptEvents="true"/>
                                <ImageWidget Id="ChannelScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                             MinHeight="15" SuggestedHeight="10" SuggestedWidth="14"
                                             HorizontalAlignment="Center" Brush="SPChatlog.Scrollbar.Handle" />
                              </Children>
                            </ScrollbarWidget>
                          </Children>
                        </Widget>
                      </Children>
                    </Widget>

                    <!-- 竖向分隔线 -->
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2"
                            Sprite="BlankWhiteSquare_9" Color="#FFFFFF22"
                            DoNotAcceptEvents="true"/>

                    <!-- ═══ 右栏：消息流 + 输入区 ═══ -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            DoNotAcceptEvents="true">
                      <Children>

                        <!-- 消息流（贴底锚定：新消息自然可见，向上翻阅；SPChatLog 同款 ScrollablePanel。
                             🔴 七轮根因：InnerPanel 路径必须与实际 ListPanel Id 完全一致（LWN_ 前缀），
                             路径错 → InnerPanel=null → 引擎滚动更新异常中断，滚动彻底失效（日志 inner=-1 确诊）） -->
                        <ScrollablePanel Id="MessageScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                         AutoHideScrollBars="true"
                                         VerticalAlignment="Bottom" MarginBottom="74"
                                         ClipRect="MessageClip" InnerPanel="MessageClip\LWN_ImChat_MessageInner"
                                         VerticalScrollbar="..\MessageScrollbarHolder\MessageScrollbar">
                          <Children>
                            <Widget Id="MessageClip" ClipContents="true"
                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    MarginLeft="14" MarginRight="26" MarginTop="10" MarginBottom="6"
                                    DoNotAcceptEvents="true">
                              <Children>
                                <ListPanel Id="LWN_ImChat_MessageInner" DataSource="{Messages}"
                                           WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                           VerticalAlignment="Bottom" ClipContents="true"
                                           StackLayout.LayoutMethod="VerticalBottomToTop"
                                           DoNotAcceptEvents="true">
                                  <ItemTemplate>
                                    <!-- 消息行：他人气泡（左）/ 自己气泡（右）/ 系统消息（居中）/ 计划卡片（居中）四分支互斥 -->
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginBottom="6"
                                            DoNotAcceptEvents="true">
                                      <Children>

                                        <!-- 他人：左对齐（名字行在气泡内顶部，被底纹包裹；仅普通文本消息，卡片/系统走独立分支） -->
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="520"
                                                HorizontalAlignment="Left"
                                                IsVisible="@ShowOtherBubble"
                                                DoNotAcceptEvents="true">
                                          <Children>
                                            <!-- 气泡：贴内容。🔴 内部必须用垂直 ListPanel 堆叠（普通 Widget 的子元素全部 Layout 到同一
                                                 rect 会重叠——「文字叠在一起」根因，2026-08-10 三轮修复）；MaxWidth 只放 TextWidget 上 -->
                                            <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                    HorizontalAlignment="Left"
                                                    Sprite="BlankWhiteSquare_9" Color="#FFFFFF1A"
                                                    DoNotAcceptEvents="true">
                                              <Children>
                                                <ListPanel Id="LWN_ImChat_BubbleOther" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                           StackLayout.LayoutMethod="VerticalBottomToTop"
                                                           DoNotAcceptEvents="true">
                                                  <Children>
                                                    <!-- 名字行：气泡内顶部（发送者成员色 + 相对时间），与内容同左缘严格对齐 -->
                                                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                               StackLayout.LayoutMethod="HorizontalLeftToRight"
                                                               HorizontalAlignment="Left"
                                                               MarginLeft="12" MarginTop="8"
                                                               DoNotAcceptEvents="true">
                                                      <Children>
                                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                    Text="@SenderName" Brush="MyBrush_18_White" Brush.FontSize="16" Brush.FontColor="@NameColor"
                                                                    HorizontalAlignment="Left"
                                                                    DoNotAcceptEvents="true"/>
                                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                    Text="@TimeText" Brush="MyBrush_18_White" Brush.FontSize="12" Brush.FontColor="#888888CC"
                                                                    MarginLeft="8" VerticalAlignment="Center"
                                                                    DoNotAcceptEvents="true"/>
                                                      </Children>
                                                    </ListPanel>
                                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                MaxWidth="520"
                                                                Text="@Content" Brush="MyBrush_16_Left" Brush.FontSize="16" Brush.TextHorizontalAlignment="Left"
                                                                WordWrapping="Wrap"
                                                                MarginLeft="12" MarginRight="12" MarginTop="4" MarginBottom="8"
                                                                DoNotAcceptEvents="true"/>
                                                  </Children>
                                                </ListPanel>
                                              </Children>
                                            </Widget>
                                          </Children>
                                        </Widget>

                                        <!-- 自己：右对齐（名字行在气泡内顶部，被底纹包裹；仅普通文本消息） -->
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="520"
                                                HorizontalAlignment="Right"
                                                IsVisible="@ShowSelfBubble"
                                                DoNotAcceptEvents="true">
                                          <Children>
                                            <!-- 气泡：贴内容 + 右对齐；内部垂直 ListPanel 堆叠（同上）；MaxWidth 只放 TextWidget 上 -->
                                            <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                    HorizontalAlignment="Right"
                                                    Sprite="BlankWhiteSquare_9" Color="#3DA53D33"
                                                    DoNotAcceptEvents="true">
                                              <Children>
                                                <ListPanel Id="LWN_ImChat_BubbleSelf" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                           StackLayout.LayoutMethod="VerticalBottomToTop"
                                                           DoNotAcceptEvents="true">
                                                  <Children>
                                                    <!-- 名字行：气泡内顶部右侧（时间 + 名字，名字贴最右），字号与内容统一 -->
                                                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                               StackLayout.LayoutMethod="HorizontalLeftToRight"
                                                               HorizontalAlignment="Right"
                                                               MarginLeft="12" MarginRight="12" MarginTop="8"
                                                               DoNotAcceptEvents="true">
                                                      <Children>
                                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                    Text="@TimeText" Brush="MyBrush_18_White" Brush.FontSize="12" Brush.FontColor="#888888CC"
                                                                    MarginRight="8" VerticalAlignment="Center"
                                                                    DoNotAcceptEvents="true"/>
                                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                    Text="@SenderName" Brush="MyBrush_18_White" Brush.FontSize="16" Brush.FontColor="@NameColor"
                                                                    HorizontalAlignment="Right"
                                                                    DoNotAcceptEvents="true"/>
                                                      </Children>
                                                    </ListPanel>
                                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                MaxWidth="520"
                                                                Text="@Content" Brush="MyBrush_16_Left" Brush.FontSize="16" Brush.TextHorizontalAlignment="Right"
                                                                WordWrapping="Wrap"
                                                                MarginLeft="12" MarginRight="12" MarginTop="4" MarginBottom="8"
                                                                DoNotAcceptEvents="true"/>
                                                  </Children>
                                                </ListPanel>
                                              </Children>
                                            </Widget>
                                          </Children>
                                        </Widget>

                                        <!-- 系统消息：居中灰字 -->
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                    Text="@Content" Brush="MyBrush_18_White" Brush.FontSize="14" Brush.FontColor="#999999FF"
                                                    Brush.TextHorizontalAlignment="Center"
                                                    WordWrapping="Wrap"
                                                    IsVisible="@IsSystem"
                                                    DoNotAcceptEvents="true"/>

                                        <!-- 生成中占位行（🔴 2026-08-12：删进度条，文案与输入栏「正在输入」统一；灰底卡片，卡片上屏/失败时被替换） -->
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="480"
                                                HorizontalAlignment="Center"
                                                Sprite="BlankWhiteSquare_9" Color="#1A1A3A88" MarginTop="2"
                                                IsVisible="@IsGenerating"
                                                DoNotAcceptEvents="true">
                                          <Children>
                                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                        Text="@GenerateText" Brush="MyBrush_16_Left" Brush.FontSize="15" Brush.FontColor="#999999FF"
                                                        WordWrapping="Wrap"
                                                        MarginLeft="14" MarginRight="14" MarginTop="10" MarginBottom="10"
                                                        DoNotAcceptEvents="true"/>
                                          </Children>
                                        </Widget>

                                        <!-- 计划卡片：修改版徽标 + 摘要 + 详情（可展开）+ 同意/拒绝/中止/修改按钮 -->
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="560"
                                                HorizontalAlignment="Center"
                                                Sprite="BlankWhiteSquare_9" Color="#1A1A3AEE" MarginTop="2"
                                                IsVisible="@IsPlanCard"
                                                DoNotAcceptEvents="true">
                                          <Children>
                                            <!-- 修改版徽标（Q2：PlanModifyCount > 0） -->
                                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                        Text="@ModifiedBadgeText" Brush="MyBrush_16_Left" Brush.FontSize="13" Brush.FontColor="#E8C55AFF"
                                                        HorizontalAlignment="Left"
                                                        IsVisible="@IsModifiedPlan"
                                                        MarginLeft="14" MarginTop="8"
                                                        DoNotAcceptEvents="true"/>
                                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                        Text="@PlanSummary" Brush="MyBrush_16_Left" Brush.FontSize="16" Brush.FontColor="#FFE9B0FF"
                                                        WordWrapping="Wrap"
                                                        MarginLeft="14" MarginRight="14" MarginTop="10"
                                                        DoNotAcceptEvents="true"/>
                                            <!-- 详情区（§3.2：C# 确定性渲染的步骤/应急/安全网；默认收起） -->
                                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                        Text="@PlanDetailText" Brush="MyBrush_16_Left" Brush.FontSize="14" Brush.FontColor="#BBBBCCFF"
                                                        WordWrapping="Wrap"
                                                        IsVisible="@IsDetailExpanded"
                                                        MarginLeft="14" MarginRight="14" MarginTop="8"
                                                        DoNotAcceptEvents="true"/>
                                            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                       StackLayout.LayoutMethod="HorizontalLeftToRight"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                       MarginRight="10" MarginBottom="8" MarginTop="8"
                                                       DoNotAcceptEvents="true">
                                              <Children>
                                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="96" SuggestedHeight="34"
                                                              Brush="Test.Button3"
                                                              Command.Click="ExecuteToggleDetail"
                                                              IsVisible="@CanApprove" IsEnabled="@CanToggleDetail" MarginRight="10">
                                                  <Children>
                                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                Text="@DetailToggleText" Brush="MyBrush_18_White" Brush.FontSize="16"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                DoNotAcceptEvents="true"/>
                                                  </Children>
                                                </ButtonWidget>
                                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="96" SuggestedHeight="34"
                                                              Brush="Test.Button3"
                                                              Command.Click="ExecuteApprove"
                                                              IsVisible="@CanApprove" MarginRight="10">
                                                  <Children>
                                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                Text="@ApproveText" Brush="MyBrush_18_White" Brush.FontSize="16"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                DoNotAcceptEvents="true"/>
                                                  </Children>
                                                </ButtonWidget>
                                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="96" SuggestedHeight="34"
                                                              Brush="Test.Button3"
                                                              Command.Click="ExecuteReject"
                                                              IsVisible="@CanReject" MarginRight="10">
                                                  <Children>
                                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                Text="@RejectText" Brush="MyBrush_18_White" Brush.FontSize="16"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                DoNotAcceptEvents="true"/>
                                                  </Children>
                                                </ButtonWidget>
                                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="96" SuggestedHeight="34"
                                                              Brush="Test.Button3"
                                                              Command.Click="ExecuteModify"
                                                              IsVisible="@CanModify" MarginRight="10">
                                                  <Children>
                                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                Text="@ModifyText" Brush="MyBrush_18_White" Brush.FontSize="16"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                DoNotAcceptEvents="true"/>
                                                  </Children>
                                                </ButtonWidget>
                                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="96" SuggestedHeight="34"
                                                              Brush="Test.Button3"
                                                              Command.Click="ExecuteAbort"
                                                              IsVisible="@CanAbort">
                                                  <Children>
                                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                Text="@AbortText" Brush="MyBrush_18_White" Brush.FontSize="16"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                DoNotAcceptEvents="true"/>
                                                  </Children>
                                                </ButtonWidget>
                                              </Children>
                                            </ListPanel>
                                          </Children>
                                        </Widget>

                                        <!-- 🔴 Q4（2026-08-10）：NPC 主动提议（「主公，我想去望风」+ 批准/拒绝按钮 → PlanCard 管线）
                                             🔴 2026-08-11（Q1 重叠修复）：内部必须 ListPanel 垂直堆叠——普通 Widget 的子元素
                                             全部 Layout 到同一 rect（ui.md「贴内容气泡」同坑），名字行与内容文本叠在一起；
                                             现 = 名字行 → 内容 → 按钮 流式占位，卡片在消息流中占据真实行高、把上方气泡顶上去。
                                             Id 带 LWN_ 前缀 → StackLayout swap patch（v1.3.0+）→ 实际 TopToBottom（名字在上）。 -->
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="520"
                                                HorizontalAlignment="Center"
                                                Sprite="BlankWhiteSquare_9" Color="#3DA53D22" MarginTop="2"
                                                IsVisible="@IsProposal"
                                                DoNotAcceptEvents="true">
                                          <Children>
                                            <ListPanel Id="LWN_ImChat_ProposalBody" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                       StackLayout.LayoutMethod="VerticalBottomToTop"
                                                       DoNotAcceptEvents="true">
                                              <Children>
                                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                                                           MarginLeft="14" MarginTop="6"
                                                           DoNotAcceptEvents="true">
                                                  <Children>
                                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                Text="@SenderName" Brush="MyBrush_18_White" Brush.FontSize="16" Brush.FontColor="@NameColor"
                                                                DoNotAcceptEvents="true"/>
                                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                Text="@TimeText" Brush="MyBrush_18_White" Brush.FontSize="12" Brush.FontColor="#888888CC"
                                                                MarginLeft="8" VerticalAlignment="Center"
                                                                DoNotAcceptEvents="true"/>
                                                  </Children>
                                                </ListPanel>
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                            Text="@Content" Brush="MyBrush_16_Left" Brush.FontSize="16" Brush.FontColor="#DDEEDDFF"
                                                            WordWrapping="Wrap"
                                                            MarginLeft="14" MarginRight="14" MarginTop="4"
                                                            DoNotAcceptEvents="true"/>
                                                <!-- 🔴 2026-08-11（Q1 二次修复）：按钮行禁止 VerticalAlignment——
                                                    垂直 ListPanel 堆叠中 VerticalAlignment 与布局方向冲突（按钮被定位到
                                                    父 rect 底部而非流式堆叠位：要么盖在内容上、要么撑出底部空白），
                                                    与气泡（BubbleOther）已验证模式一致：内部子项只留水平对齐。 -->
                                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                                                           HorizontalAlignment="Right"
                                                           MarginRight="10" MarginBottom="4" MarginTop="4"
                                                           DoNotAcceptEvents="true">
                                                  <Children>
                                                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="96" SuggestedHeight="34"
                                                                  Brush="Test.Button3"
                                                                  Command.Click="ExecuteProposeApprove"
                                                                  IsVisible="@CanProposeApprove" MarginRight="10">
                                                      <Children>
                                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                    Text="@ProposeApproveText" Brush="MyBrush_18_White" Brush.FontSize="16"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    DoNotAcceptEvents="true"/>
                                                      </Children>
                                                    </ButtonWidget>
                                                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="96" SuggestedHeight="34"
                                                                  Brush="Test.Button3"
                                                                  Command.Click="ExecuteProposeReject"
                                                                  IsVisible="@CanProposeReject">
                                                      <Children>
                                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                                    Text="@ProposeRejectText" Brush="MyBrush_18_White" Brush.FontSize="16"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    DoNotAcceptEvents="true"/>
                                                      </Children>
                                                    </ButtonWidget>
                                                  </Children>
                                                </ListPanel>
                                              </Children>
                                            </ListPanel>
                                          </Children>
                                        </Widget>

                                      </Children>
                                    </Widget>
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </Widget>
                          </Children>
                        </ScrollablePanel>

                        <!-- 滚动条（🔴 八轮：MarginBottom=74 与消息流同高——滚动条不得伸进输入框区域） -->
                        <Widget Id="MessageScrollbarHolder" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Right" MarginRight="6" MarginBottom="74" DoNotAcceptEvents="true">
                          <Children>
                            <ScrollbarWidget Id="MessageScrollbar" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                             AlignmentAxis="Vertical" Handle="MessageScrollbarHandle"
                                             MaxValue="100" MinValue="0">
                              <Children>
                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2"
                                        HorizontalAlignment="Center"
                                        Sprite="BlankWhiteSquare_9" Color="#A37434FF" MarginTop="5" MarginBottom="5" AlphaFactor="0.7"
                                        DoNotAcceptEvents="true"/>
                                <ImageWidget Id="MessageScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                             MinHeight="15" SuggestedHeight="10" SuggestedWidth="14"
                                             HorizontalAlignment="Center" Brush="SPChatlog.Scrollbar.Handle" />
                              </Children>
                            </ScrollbarWidget>
                          </Children>
                        </Widget>

                        <!-- 「有新消息」提示条（🔴 八轮：翻历史时新消息到达 → 输入区分隔线上方悬浮提示；点击滚底清提示） -->
                        <ButtonWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="30"
                                      HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="78"
                                      Brush="Test.Button3"
                                      Command.Click="ExecuteNewMessageClick"
                                      IsVisible="@HasNewMessageHint">
                          <Children>
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                        Text="@NewMessageHintText" Brush="MyBrush_18_White" Brush.FontSize="14"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" MarginLeft="14" MarginRight="14"
                                        DoNotAcceptEvents="true"/>
                          </Children>
                        </ButtonWidget>

                        <!-- 空会话引导（UI 优化：无消息时居中提示而非空白） -->
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Text="@EmptyHint" Brush="MyBrush_18_White" Brush.FontSize="16" Brush.FontColor="#888888FF"
                                    Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MarginBottom="74"
                                    IsVisible="@IsEmpty"
                                    DoNotAcceptEvents="true"/>

                        <!-- 输入区（🔴 六轮：输入框加宽 48→64px——单行输入更舒适，引擎 EditableTextWidget 不支持自动换行） -->
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="74"
                                VerticalAlignment="Bottom"
                                Sprite="BlankWhiteSquare_9" Color="#00000088"
                                DoNotAcceptEvents="true">
                          <Children>
                            <!-- 分隔线：输入区与消息流的视觉边界 -->
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2"
                                    VerticalAlignment="Top"
                                    Sprite="BlankWhiteSquare_9" Color="#FFFFFF33"
                                    DoNotAcceptEvents="true"/>

                            <!-- 输入框底（🔴 加深：与输入区底色拉开层次；贴顶紧凑布局） -->
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="64"
                                    VerticalAlignment="Bottom" MarginBottom="4" MarginLeft="14" MarginRight="14"
                                    Sprite="BlankWhiteSquare_9" Color="#000000CC"
                                    DoNotAcceptEvents="true">
                              <Children>
                                <EditableTextWidget Id="LWN_ImChat_Input" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    Text="@InputText" DefaultSearchText="@PlaceholderText"
                                                    TextColor="#FFFFFFFF" Brush="MyBrush_16_Left" Brush.FontSize="18"
                                                    MarginLeft="12" MarginRight="100" VerticalAlignment="Center"/>
                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="90" SuggestedHeight="38"
                                              Brush="Test.Button3"
                                              Command.Click="ExecuteSend"
                                              IsEnabled="@CanSend"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="5">
                                  <Children>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                Text="@SendText" Brush="MyBrush_18_White" Brush.FontSize="17"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                DoNotAcceptEvents="true"/>
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </Widget>
                          </Children>
                        </Widget>

                      </Children>
                    </Widget>

                  </Children>
                </ListPanel>
              </Children>
            </Widget>

            <!-- 边框（Inquiry 同款 frame_9 九宫格，Extend 18 画在逻辑盒外，最上层压边） -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="frame_9" ExtendLeft="18" ExtendTop="18" ExtendRight="18" ExtendBottom="18"
                    IsEnabled="false"
                    DoNotAcceptEvents="true"/>

          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
