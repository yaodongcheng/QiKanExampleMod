{
  "id": "okehazama_EFF06E00_159_seg1",
  "form": "menu_dialogue",
  "lines": [
    // T1 對話:(今川義元,功勳家臣)[[大家都到了吧？\n現在有重大的方針要發表……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Agent::template_koushin_kashin_01", "textKey": "LWN_SCN_okehazama_EFF06E00_159_1", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T2 對話:(功勳家臣,今川義元)[[請問是什麼事呢？]],
    {"cmd": "dialogue", "speaker": "Agent::template_koushin_kashin_01", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_2", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T3 對話:(今川義元,今川義元)[[在諸國戰亂之中，將軍家的式微\n真的是慘不忍睹……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_3", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T4 對話:(今川義元,今川義元)[[我們今川家，是原來足利將軍的一門，\n也就是說，本家為副將軍之家世。\n此事，相信大家都知道吧……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_4", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T5 對話:(今川義元,今川義元)[[因此，在幫助足利將軍家的同時，\n也為了讓諸國了解幕府的權威，\n所以我想要上京。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_5", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T6 對話:(功勳家臣,今川義元)[[大人是說……上京嗎？]],
    {"cmd": "dialogue", "speaker": "Agent::template_koushin_kashin_01", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_6", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T7 對話:(今川義元,今川義元)[[沒錯！本家有幸領土廣闊，\n且與武田家及北條家結盟，\n可以說是無後顧之憂……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_7", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T8 對話:(今川義元,今川義元)[[現在，正是以本家實力\n上京並號令天下的大好時機啊。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_8", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T9 對話:(今川氏真,今川義元)[[但是，父親大人……現在足利將軍\n的威信，已如風中殘燭般了……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_9", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T10 對話:(今川氏真,今川義元)[[而且，很有可能在我們上京之前，\n將軍家就先被(三好長慶)般的暴徒\n給滅了也說不定啊。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_10", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T11 對話:(今川義元,今川義元)[[如果真是這樣，那足利家一門的今川氏\n便即刻成為將軍，號令天下！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_11", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T12 對話:(今川氏真,今川義元)[[…………]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_12", "when": "(Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T13 對話:(忍者,德川家康)[[報告！\n駿府的主公大人傳來指令！]],
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_13", "when": "not( (Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto) )"},
    // T14 對話:(德川家康,今川義元)[[什麼，從主公大人那裡……？\n那，內容是？]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_14", "when": "not( (Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto) )"},
    // T15 對話:(忍者,德川家康)[[是！\n主公大人終於決定上京，\n並對領國下達出陣之命！]],
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_15", "when": "not( (Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto) )"},
    // T16 對話:(德川家康,今川義元)[[什麼！……主公大人要上京？]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_16", "when": "not( (Ctx::event_hero) == (Hero::lord_1_imagawa_katsumoto) )"},
    // T17 對話:(人物Ｄ,今川義元)[[但是，主公大人……\n在前方有尾張的(織田信長)。\n用一般的方法大概行不通吧……]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_17", "when": "(Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T18 對話:(今川義元,人物Ｄ)[[怕什麼，不過是(織田信長.姓)的小鬼……\n敢不讓我軍前進，\n就把他幹掉吧。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_159_18", "when": "(Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T19 對話:(人物Ｄ,今川義元)[[可不能輕視他啊，大人。\n雖然謠傳(織田信長.名)是個大呆瓜，\n但那可能只是欺瞞諸國的策略啊。]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_19", "when": "(Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T20 對話:(今川義元,人物Ｄ)[[不過是(織田信長.名)那小子，\n你們幹嘛那麼怕他啊……\n擔心過度了吧。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_159_20", "when": "(Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto)"},
    // T21 對話:(人物Ｄ,今川義元)[[可是……]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_21", "when": "(Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto)"},
    {"cmd": "choice", "options": [{"textKey": "LWN_SCN_okehazama_EFF06E00_159_21_ch0", "text": "堅持上京"}, {"textKey": "LWN_SCN_okehazama_EFF06E00_159_21_ch1", "text": "還是算了"}]},
    // T22 對話:(今川義元,人物Ｄ)[[總而言之，開始著手上京的準備。\n首先打倒那個(織田信長)！\n命(德川家康)擔任先鋒！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_159_22", "when": "and( (Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto), (Ctx::choice) == \"opt0\" )"},
    // T23 對話:(今川義元,人物Ｄ)[[首先打下(織田信長.姓)的<城Ｂ>！\n知道了嗎！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_159_23", "when": "and( (Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto), (Ctx::choice) == \"opt0\", (Ctx::choice) == \"opt1\" )"},
    // T24 對話:(德川家康,今川義元)[[……遵命！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_24", "when": "and( (Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto), (Ctx::choice) == \"opt0\", (Ctx::choice) == \"opt1\" )"},
    // T25 對話:(今川義元,人物Ｄ)[[首先打下(織田信長.姓)的<城Ｂ>！\n傳令下去！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_159_25", "when": "and( (Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto), (Ctx::choice) == \"opt0\", (Ctx::choice) == \"opt0\" )"},
    // T26 對話:(人物Ｄ,今川義元)[[……是！\n屬下會傳達給(德川家康)的！]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_26", "when": "and( (Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto), (Ctx::choice) == \"opt0\", (Ctx::choice) == \"opt0\" )"},
    // T27 旁白:[[就這樣，先鋒隊(德川家康)\n為了搬運兵糧到<城Ｂ>而出陣了……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF06E00_159_27", "when": "and( (Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto), (Ctx::choice) == \"opt0\" )"},
    // T28 對話:(今川義元,人物Ｄ)[[不要輸給(德川家康.名)的先鋒隊！\n本隊也出陣！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_159_28", "when": "and( (Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto), (Ctx::choice) == \"opt0\" )"},
    // T29 對話:(今川義元,人物Ｄ)[[……我明白了。\n既然你都這麼說了，那這次就算了。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_159_29", "when": "and( (Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto), (Ctx::choice) == \"opt1\" )"},
    // T30 對話:(今川義元,人物Ｄ)[[但是，我是絕對不會放棄的。\n視情況進攻(織田信長.姓)，\n知道了嗎！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_159_30", "when": "and( (Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto), (Ctx::choice) == \"opt1\" )"},
    // T31 對話:(人物Ｄ,今川義元)[[……是！]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_31", "when": "and( (Hero::MainHero) == (Hero::lord_1_imagawa_katsumoto), (Ctx::choice) == \"opt1\" )"}
  ]
}