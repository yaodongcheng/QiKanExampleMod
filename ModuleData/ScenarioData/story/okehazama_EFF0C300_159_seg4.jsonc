    // T23 對話:(主人公,寧寧)[[這一次的戰爭，\n想必會成為賭上(織田信長.姓)家命運的一戰吧！\n老實說，勝算實在很小啊！]],,,
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Hero::lord_1_kinoshita_1", "textKey": "LWN_SCN_okehazama_EFF0C300_159_23", "when": "and( not( (Hero::MainHero.settlement) == (Settlement::tk5_city_083) ), not( (Hero::MainHero) == (Hero::lord_1_oda) ), (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null) )"},
    // T24 對話:(主人公,寧寧)[[在下原本打算再多立一點功勞之後，\n就要向(寧寧)小姐你求婚的。]],,,
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Hero::lord_1_kinoshita_1", "textKey": "LWN_SCN_okehazama_EFF0C300_159_24", "when": "and( not( (Hero::MainHero.settlement) == (Settlement::tk5_city_083) ), not( (Hero::MainHero) == (Hero::lord_1_oda) ), (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null) )"},
    // T25 對話:(寧寧,主人公)[[啊！是真的嗎！？]],,,
