{
  "id": "okehazama_EFF0C300_163_seg1",
  "form": "scene",
  "actors": [
    {"heroId": "Hero::lord_1_imagawa_katsumoto", "slot": "throne"},
    {"agentId": "Ctx::hero_b", "slot": "side"},
    {"heroId": "Hero::lord_1_oda", "slot": "side"},
    {"agentId": "Agent::template_ashigaru_01", "slot": "side"},
