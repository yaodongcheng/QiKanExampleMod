  ],
  "lines": [
    // T1 旁白:[[另一邊，(今川義元)則是……]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_163_1"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Hero::lord_1_imagawa_katsumoto,
    {"cmd": "actor_enter", "actor": "Hero::lord_1_imagawa_katsumoto", "slot": "throne"},
    // T2 對話:(今川義元,足輕)[[哦，(德川家康.名)把<據點Ｃ>給攻下來了啊！\n這可是個好的開始啊！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Agent::template_ashigaru_01", "textKey": "LWN_SCN_okehazama_EFF0C300_163_2"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Agent::template_ashigaru_01,
    {"cmd": "actor_enter", "actor": "Agent::template_ashigaru_01", "slot": "side"},
    // T3 對話:(足輕,今川義元)[[主公，附近的村子一個接著一個\n送來了祝賀之禮的酒和米。]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ashigaru_01", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF0C300_163_3"},
    // T4 對話:(今川義元,足輕)[[嗯……\n好吧，全軍止步！！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Agent::template_ashigaru_01", "textKey": "LWN_SCN_okehazama_EFF0C300_163_4"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Ctx::hero_b,
    {"cmd": "actor_enter", "actor": "Ctx::hero_b", "slot": "side"},
    // T5 對話:(人物Ｂ,今川義元)[[主公，怎麼了嗎？\n在這種地方停下來？]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF0C300_163_5"},
    // T6 對話:(今川義元,人物Ｂ)[[稍微休息一下嘛！\n祝賀攻下<據點Ｃ>的酒不是送到了嗎？\n分配下去給士兵們吧！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF0C300_163_6"},
    // T7 對話:(人物Ｂ,今川義元)[[主公！\n停留在這種場所是很危險的！]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF0C300_163_7"},
    // T8 對話:(人物Ｂ,今川義元)[[如果(織田信長.姓)的部隊有設埋伏的話，\n該如何是好呢！]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF0C300_163_8"},
    // T9 對話:(今川義元,人物Ｂ)[[哎呀，沒關係啦！\n士兵們也都很累了啊！\n讓他們休息一下吧！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF0C300_163_9"},
    // T10 對話:(人物Ｂ,今川義元)[[但是……]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF0C300_163_10"},
    // T11 旁白:[[這一天的(今川義元)，\n不知道是因為中了邪，\n還是因為老天已經捨棄他了……]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_163_11"},
    // T12 旁白:[[這個預定之外的休憩才剛開始不久，\n伴隨著強風的豪雨就降了下來。]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_163_12"},
    // T13 旁白:[[受到這場雨幫助的(織田信長)軍，\n毫不費力地就悄悄來到了(今川義元.姓)軍的附近。]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_163_13"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Hero::lord_1_oda,
    {"cmd": "actor_enter", "actor": "Hero::lord_1_oda", "slot": "side"},
    // T14 對話:(織田信長,足輕)[[成了……\n(今川義元.名)這傢伙太大意了！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Agent::template_ashigaru_01", "textKey": "LWN_SCN_okehazama_EFF0C300_163_14"},
    // T15 對話:(織田信長,人物Ｂ)[[雖然我從來沒想到可以活著回去，但\n在這條狹窄的山道上，對方大軍的行動\n會被限制住！有了，我們有勝算了！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF0C300_163_15"},
    // T16 對話:(織田信長,足輕)[[聽好了，悄悄靠近敵軍讓他們混亂！雖說\n是大軍，但只要拆開來就只是烏合之眾罷了。\n之後，全軍就朝(今川義元.名)的本陣前進！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Agent::template_ashigaru_01", "textKey": "LWN_SCN_okehazama_EFF0C300_163_16"},
    // T17 對話:(織田信長,足輕)[[目標只有(今川義元.名)的首級！\n不要去在乎其他敵人！\n上吧！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Agent::template_ashigaru_01", "textKey": "LWN_SCN_okehazama_EFF0C300_163_17"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Hero::lord_1_kinoshita,
    {"cmd": "actor_enter", "actor": "Hero::lord_1_kinoshita", "slot": "side"},
    // T18 自語:[[（我一定要努力立下戰功，\n　然後活著回去讓(寧寧)小姐對我說\n　「我願意」！）]],,,
    {"cmd": "narrator", "speaker": "Hero::lord_1_kinoshita", "textKey": "LWN_SCN_okehazama_EFF0C300_163_18", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null) )"},
    // T19 對話:(今川義元,人物Ｂ)[[怎麼這麼吵啊！\n難道是士兵們喝醉酒了在打架嗎？\n來人啊！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF0C300_163_19"},
    // T20 對話:(人物Ｂ,今川義元)[[主、主公！\n(織田信長.姓)軍對我們發動奇襲了！！]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF0C300_163_20"},
    // T21 對話:(今川義元,人物Ｂ)[[什、你說什麼！\n怎麼會有這種蠢事……！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF0C300_163_21"},
    // T22 對話:(人物Ｂ,足輕)[[可惡，護衛兵們還在做什麼！\n不快來保護主公嗎！]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Agent::template_ashigaru_01", "textKey": "LWN_SCN_okehazama_EFF0C300_163_22"},
    // T23 旁白:[[(織田信長.姓)軍的奇襲，\n可以說是完全成功了。]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_163_23"},
    // T24 旁白:[[在田樂狹間休息的(今川義元.姓)軍，\n因為受限於狹窄的地形，部隊無法順利調度，\n所以陷入大混亂……]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_163_24"},
    // T25 旁白:[[當下有辦法立即做出反應的……\n在兩萬人的大軍之中，也只有一小部份而已……]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_163_25"},
    // T26 對話:(織田信長,人物Ｂ)[[(織田信長)在此！\n尾張的大呆瓜前來拜見\n東海第一弓取的尊容了！！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF0C300_163_26"},
    // 舞台推导：段末收场（05:163 排演对应物）: Hero::lord_1_imagawa_katsumoto,
    {"cmd": "actor_leave", "actor": "Hero::lord_1_imagawa_katsumoto", "slot": "throne"},
    // 舞台推导：段末收场（05:163 排演对应物）: Ctx::hero_b,
    {"cmd": "actor_leave", "actor": "Ctx::hero_b", "slot": "side"},
    // 舞台推导：段末收场（05:163 排演对应物）: Hero::lord_1_oda,
    {"cmd": "actor_leave", "actor": "Hero::lord_1_oda", "slot": "side"},
    // 舞台推导：段末收场（05:163 排演对应物）: Agent::template_ashigaru_01,
    {"cmd": "actor_leave", "actor": "Agent::template_ashigaru_01", "slot": "side"},
    // 舞台推导：段末收场（05:163 排演对应物）: Hero::lord_1_kinoshita,
    {"cmd": "actor_leave", "actor": "Hero::lord_1_kinoshita", "slot": "side"}
  ]
}