  "lines": [
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Hero::lord_1_imagawa_katsumoto,
    {"cmd": "actor_enter", "actor": "Hero::lord_1_imagawa_katsumoto", "slot": "side"},
    // T1 對話:(今川義元,忍者)[[被、被人稱做東海第一弓取\n的我竟然……]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Agent::template_ninja_male_01", "textKey": "LWN_SCN_okehazama_EFF0C300_164_1", "when": "((Army::army_1.result)) == (1)"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Agent::template_ashigaru_01,
    {"cmd": "actor_enter", "actor": "Agent::template_ashigaru_01", "slot": "side"},
    // T2 對話:(足輕,今川義元)[[你就是大將，(今川義元)對吧？\n覺悟吧！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ashigaru_01", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF0C300_164_2", "when": "((Army::army_1.result)) == (1)"},
    // T3 對話:(今川義元,足輕)[[該死的下賤之輩！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Agent::template_ashigaru_01", "textKey": "LWN_SCN_okehazama_EFF0C300_164_3", "when": "((Army::army_1.result)) == (1)"},
    // T4 旁白:[[喀颯！]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_164_4", "when": "((Army::army_1.result)) == (1)"},
    // T5 對話:(今川義元,足輕)[[嗚啊……\n竟然被尾張的呆瓜給……\n遺、遺憾啊！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Agent::template_ashigaru_01", "textKey": "LWN_SCN_okehazama_EFF0C300_164_5", "when": "((Army::army_1.result)) == (1)"},
    // T6 旁白:[[喀颯！]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_164_6", "when": "((Army::army_1.result)) == (1)"},
    // T7 對話:(足輕,主人公)[[殺死敵人的大將(今川義元)了！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ashigaru_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_164_7", "when": "((Army::army_1.result)) == (1)"},
    // T8 旁白:[[人稱東海第一弓取的(今川義元)，\n將守護大名中名門中的名門(今川義元.姓)家\n發揚至足以稱霸駿遠三三國的戰國大名家……]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_164_8", "when": "((Army::army_1.result)) == (1)"},
    // T9 旁白:[[但因遭到了尾張風雲兒(織田信長)之奇襲，\n而殞落在桶狹間。\n享年<ｄ>……]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_164_9", "when": "((Army::army_1.result)) == (1)"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Agent::template_ninja_male_01,
    {"cmd": "actor_enter", "actor": "Agent::template_ninja_male_01", "slot": "side"},
    // T10 對話:(忍者,主人公)[[我方大獲全勝！\n成功殺死敵將(今川義元)了！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_164_10", "when": "((Army::army_1.result)) == (1)"},
    // T11 對話:(忍者,主人公)[[最先交鋒者為服部小平太，\n拿下首級者為毛利新介！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_164_11", "when": "((Army::army_1.result)) == (1)"},
    // T12 對話:(忍者,主人公)[[他們倆人雖然獲得了(今川義元)的配刀，\n但因認為那是自己配不上的好刀，\n所以決定呈獻給主公。]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_164_12", "when": "and( ((Army::army_1.result)) == (1), (Hero::MainHero) == (Hero::lord_1_oda) )"},
    // T13 旁白:[[得到了宗三左文字。]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_164_13", "when": "and( ((Army::army_1.result)) == (1), (Hero::MainHero) == (Hero::lord_1_oda) )"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Hero::MainHero,
    {"cmd": "actor_enter", "actor": "Hero::MainHero", "slot": "throne"},
    // T14 對話:(主人公,忍者)[[嗯，那我就收下了。\n大家幹的很好！]],,,
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_ninja_male_01", "textKey": "LWN_SCN_okehazama_EFF0C300_164_14", "when": "and( ((Army::army_1.result)) == (1), (Hero::MainHero) == (Hero::lord_1_oda) )"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Hero::lord_1_oda,
    {"cmd": "actor_enter", "actor": "Hero::lord_1_oda", "slot": "side"},
    // T15 對話:(織田信長,主人公)[[嗯，為勝利歡呼吧！！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_164_15", "when": "and( ((Army::army_1.result)) == (1), not( (Hero::MainHero) == (Hero::lord_1_oda) ) )"},
    // T16 對話:(足輕,織田信長)[[嘿、嘿、哦～！！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ashigaru_01", "listener": "Hero::lord_1_oda", "textKey": "LWN_SCN_okehazama_EFF0C300_164_16", "when": "and( ((Army::army_1.result)) == (1), not( (Hero::MainHero) == (Hero::lord_1_oda) ) )"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Agent::template_shougun_01,
    {"cmd": "actor_enter", "actor": "Agent::template_shougun_01", "slot": "side"},
    // T17 對話:(備大將,主人公)[[我方部隊完全潰散了！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_shougun_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_164_17", "when": "not( ((Army::army_1.result)) == (1) )"},
    // T18 自語:[[可惡！\n該死的(今川義元.名)！\n就只差一步了說……]],,,
    {"cmd": "narrator", "speaker": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_164_18", "when": "not( ((Army::army_1.result)) == (1) )"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Ctx::hero_c,
    {"cmd": "actor_enter", "actor": "Ctx::hero_c", "slot": "side"},
    // T19 對話:(人物Ｃ,主人公)[[是(織田信長)！！\n別讓他跑了！]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_c", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_164_19", "when": "and( not( ((Army::army_1.result)) == (1) ), (Hero::MainHero) == (Hero::lord_1_oda) )"},
    // T20 對話:(人物Ｃ,主人公)[[是(織田信長.姓)軍的倖存者，\n別讓他跑了！]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_c", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_164_20", "when": "and( not( ((Army::army_1.result)) == (1) ), not( (Hero::MainHero) == (Hero::lord_1_oda) ) )"},
    // T21 旁白:[[喀颯！]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_164_21", "when": "not( ((Army::army_1.result)) == (1) )"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Hero::lord_1_kinoshita,
    {"cmd": "actor_enter", "actor": "Hero::lord_1_kinoshita", "slot": "side"},
    // T22 自語:[[我……我……\n一定要回去才行……\n……(寧寧)小姐……]],,,
    {"cmd": "narrator", "speaker": "Hero::lord_1_kinoshita", "textKey": "LWN_SCN_okehazama_EFF0C300_164_22", "when": "and( not( ((Army::army_1.result)) == (1) ), (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null) )"},
    // T23 自語:[[嗚啊！]],,,
    {"cmd": "narrator", "speaker": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_164_23", "when": "and( not( ((Army::army_1.result)) == (1) ), and( not( (Hero::MainHero) == (Hero::lord_1_oda) ), not( (Hero::MainHero) == (Hero::lord_1_kinoshita) ) ), ((Hero::MainHero.spouse)) == (null) )"},
    // T24 自語:[[嗚咕\n……(主人公妻)，抱歉了……]],,,
    {"cmd": "narrator", "speaker": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_164_24", "when": "and( not( ((Army::army_1.result)) == (1) ), and( not( (Hero::MainHero) == (Hero::lord_1_oda) ), not( (Hero::MainHero) == (Hero::lord_1_kinoshita) ) ), not( ((Hero::MainHero.spouse)) == (null) ) )"},
    // T25 旁白:[[雖然(今川義元.姓)軍受到了(織田信長.姓)軍奇襲，\n但他們很快便收拾了混亂，將對方擊敗。]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_164_25", "when": "not( ((Army::army_1.result)) == (1) )"},
    // T26 旁白:[[(織田信長)所發動的孤注一擲地奇襲攻擊，\n最後以失敗收場……]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_164_26", "when": "not( ((Army::army_1.result)) == (1) )"},
    // T27 旁白:[[在亂戰之中，(織田信長)他\n終究力盡倒下。\n享年<ｄ>。]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_164_27", "when": "and( not( ((Army::army_1.result)) == (1) ), (Hero::MainHero) == (Hero::lord_1_oda) )"},
    // T28 旁白:[[在亂戰之中，\n(織田信長)以下(織田信長.姓)家的大人物們通通戰死。\n(主人公)也隨著主子殉死，享年<ｄ>。]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_164_28", "when": "and( not( ((Army::army_1.result)) == (1) ), and( not( (Hero::MainHero) == (Hero::lord_1_oda) ), not( (Hero::MainHero) == (Hero::lord_1_kinoshita) ) ) )"},
