  ],
  "lines": [
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Hero::lord_1_tokugawa,
    {"cmd": "actor_enter", "actor": "Hero::lord_1_tokugawa", "slot": "side"},
    // T1 對話:(德川家康,主人公)[[見識到三河武士的氣概了吧！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_161_1", "when": "((Army::army_1.result)) == (3)"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Hero::MainHero,
    {"cmd": "actor_enter", "actor": "Hero::MainHero", "slot": "throne"},
    // T2 對話:(主人公,德川家康)[[嗚……主公，真是對不起。\n(主人公.名)要先走一步了！]],,,
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF0C300_161_2", "when": "((Army::army_1.result)) == (3)"},
    // T3 旁白:[[喀嚓！]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_161_3", "when": "((Army::army_1.result)) == (3)"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Agent::template_shougun_01,
    {"cmd": "actor_enter", "actor": "Agent::template_shougun_01", "slot": "side"},
    // T4 對話:(備大將,主人公)[[啊！(主人公.名)大人！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_shougun_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_161_4", "when": "((Army::army_1.result)) == (3)"},
    // T5 旁白:[[於是，\n(主人公)短暫的人生就此結束了……]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_161_5", "when": "((Army::army_1.result)) == (3)"},
    // T6 對話:(備大將,主人公)[[成功了！\n敵軍開始撤退了！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_shougun_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_161_6", "when": "not( ((Army::army_1.result)) == (3) )"},
    // T7 對話:(主人公,備大將)[[嗯！這樣一來也能對主公交代了……]],,,
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_shougun_01", "textKey": "LWN_SCN_okehazama_EFF0C300_161_7", "when": "not( ((Army::army_1.result)) == (3) )"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Agent::template_ninja_male_01,
    {"cmd": "actor_enter", "actor": "Agent::template_ninja_male_01", "slot": "side"},
    // T8 對話:(忍者,主人公)[[報告！\n主公的部隊和(今川義元)的部隊\n在田樂狹間發生了激戰！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_161_8", "when": "not( ((Army::army_1.result)) == (3) )"},
    // T9 對話:(主人公,備大將)[[什麼！結果呢？]],,,
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_shougun_01", "textKey": "LWN_SCN_okehazama_EFF0C300_161_9", "when": "not( ((Army::army_1.result)) == (3) )"},
    // T10 對話:(忍者,主人公)[[是！！我方大獲全勝！\n(今川義元.名)的首級也被取下來了！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_161_10", "when": "not( ((Army::army_1.result)) == (3) )"},
    // T11 對話:(主人公,備大將)[[哦哦！真是值得慶賀！！\n但是，明明是我方處在劣勢，\n卻還能殺死(今川義元.名)，也真是了不起啊！]],,,
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_shougun_01", "textKey": "LWN_SCN_okehazama_EFF0C300_161_11", "when": "not( ((Army::army_1.result)) == (3) )"},
    // T12 對話:(忍者,主人公)[[因為主公發動了奇襲……\n在(今川義元.姓)軍休息的時候向他們發動攻擊。]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_161_12", "when": "not( ((Army::army_1.result)) == (3) )"},
    // T13 對話:(主人公,備大將)[[嗯……真不愧是主公啊！\n這麼一來東邊的威脅就消失了！]],,,
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_shougun_01", "textKey": "LWN_SCN_okehazama_EFF0C300_161_13", "when": "and( not( ((Army::army_1.result)) == (3) ), ((Hero::MainHero.gender)) == (0) )"},
    // T14 對話:(主人公,備大將)[[原來如此，真不愧是主公！\n這麼一來東邊的威脅就消失了！]],,,
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_shougun_01", "textKey": "LWN_SCN_okehazama_EFF0C300_161_14", "when": "and( not( ((Army::army_1.result)) == (3) ), not( ((Hero::MainHero.gender)) == (0) ) )"},
    // T15 旁白:[[在桶狹間以奇襲擊破(今川義元)的(織田信長)，\n從此一躍成為時代的寵兒，揚名於戰國之世。]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_161_15", "when": "not( ((Army::army_1.result)) == (3) )"},
    // T16 旁白:[[令一方面，失去了(今川義元.名)這位英雄的\n(今川義元.姓)家，在新當主(今川氏真.名)的領導下，\n也只能漸漸地邁向沒落一途……]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_161_16", "when": "not( ((Army::army_1.result)) == (3) )"},
    // T17 旁白:[[有如在象徵此一沒落般，\n(德川家康)獨立於三河之地，\n也是不久之後的事了……]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_161_17", "when": "not( ((Army::army_1.result)) == (3) )"},
    // 舞台推导：段末收场（05:163 排演对应物）: Agent::template_ninja_male_01,
    {"cmd": "actor_leave", "actor": "Agent::template_ninja_male_01", "slot": "side"},
    // 舞台推导：段末收场（05:163 排演对应物）: Agent::template_shougun_01,
    {"cmd": "actor_leave", "actor": "Agent::template_shougun_01", "slot": "side"},
    // 舞台推导：段末收场（05:163 排演对应物）: Hero::lord_1_tokugawa,
    {"cmd": "actor_leave", "actor": "Hero::lord_1_tokugawa", "slot": "side"}
  ]
}