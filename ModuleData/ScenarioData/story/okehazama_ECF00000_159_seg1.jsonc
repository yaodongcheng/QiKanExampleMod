{
  "id": "okehazama_ECF00000_159_seg1",
  "form": "menu_dialogue",
  "lines": [
    // T1 對話:(人物Ｄ,主人公)[[大，大事發生了！！\n你已經聽說了嗎？]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_ECF00000_159_1"},
    // T2 對話:(主人公,人物Ｄ)[[到底，是什麼事？]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_ECF00000_159_2", "when": "((Hero::MainHero.gender)) == (1)"},
    // T3 對話:(主人公,人物Ｄ)[[到底，發生什麼事了！？]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_ECF00000_159_3", "when": "not( ((Hero::MainHero.gender)) == (1) )"},
    // T4 對話:(人物Ｄ,主人公)[[那個，(今川義元)大人，\n戰死的事啊！！]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_ECF00000_159_4"},
    // T5 對話:(主人公,人物Ｄ)[[你，你說什麼！！]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_ECF00000_159_5", "when": "((Hero::MainHero.gender)) == (1)"},
    // T6 對話:(主人公,人物Ｄ)[[什，什麼！！]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_ECF00000_159_6", "when": "not( ((Hero::MainHero.gender)) == (1) )"},
    // T7 對話:(人物Ｄ,主人公)[[聽說，(今川義元.姓)大人，為了完成上京，\n而出兵尾張……\n途中，來到了(織田信長.姓)家領地……]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_ECF00000_159_7"},
    // T8 對話:(人物Ｄ,主人公)[[在桶狹間，休憩的時候，\n遭受(織田信長)的奇襲攻擊，\n慘死陣中……]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_ECF00000_159_8"},
    // T9 對話:(主人公,人物Ｄ)[[織田信長……\n說不定是創造新時代的男子漢。]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_ECF00000_159_9", "when": "and( (Hero::MainHero) == (Hero::lord_1_kuki), ((Hero::lord_1_kuki.identity)) != (\"chief\") )"},
    // T10 對話:(主人公,人物Ｄ)[[……怎麼會這樣。\n那個(今川義元.姓)大人被{織田信長.名前}……]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_ECF00000_159_10", "when": "and( not( (Hero::MainHero) == (Hero::lord_1_kuki) ), ((Hero::MainHero.gender)) == (1) )"},
    // T11 對話:(主人公,人物Ｄ)[[……怎麼會這樣。\n那個(今川義元.姓)大人被{織田信長.名前}……]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_ECF00000_159_11", "when": "and( not( (Hero::MainHero) == (Hero::lord_1_kuki) ), not( ((Hero::MainHero.gender)) == (1) ) )"},
    // T12 旁白:[[<年>年<月>月，(今川義元)在\n桶狹間遭受(織田信長)的奇襲，\n被取走了首級……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_ECF00000_159_12"},
    // T13 旁白:[[因為那被稱為東海道第一弓取，\n駿河、遠江、三河大大名的\n戰國英雄(今川義元)的死……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_ECF00000_159_13"},
    // T14 旁白:[[時代有了巨大的變化……\n繼承(今川義元.名)的(今川氏真)，\n沒有超越父親的才幹……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_ECF00000_159_14"},
    // T15 旁白:[[於是，(德川家康)便公然發布宣言，\n從(今川義元.姓)家獨立出來了……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_ECF00000_159_15"}
  ]
}