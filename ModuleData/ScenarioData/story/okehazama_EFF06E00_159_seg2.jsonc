{
  "id": "okehazama_EFF06E00_159_seg2",
  "form": "menu_dialogue",
  "lines": [
    // T32 對話:(今川義元,德川家康)[[而且，說實在的，尾張的<城Ｂ>城\n已倒戈到本家這邊來了。\n因此等於我方在(織田信長.姓)家領地已有城池。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_32", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt1\" )"},
    // T33 對話:(德川家康,忍者)[[什麼！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Agent::template_ninja_male_01", "textKey": "LWN_SCN_okehazama_EFF06E00_159_33", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt1\" )"},
    // T34 對話:(今川義元,德川家康)[[我已即刻命(鵜殿長照)\n入城當城守了……這正是上京的好機會哪。\n你難道不這麼認為嗎？]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_34", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt1\" )"},
    // T35 對話:(德川家康,忍者)[[的確是如此沒錯……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Agent::template_ninja_male_01", "textKey": "LWN_SCN_okehazama_EFF06E00_159_35", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt1\" )"},
    // T36 對話:(今川義元,德川家康)[[好！那麼，命(德川家康.名)\n作為先鋒，將兵糧運送\n至<城Ｂ>去！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_36", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt1\" )"},
    // T37 對話:(今川義元,德川家康)[[想必(織田信長.姓)方也會為了奪回<城Ｂ>\n而攻過來……因此你除了運送兵糧外\n也要救援城方！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_37", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt1\" )"},
    // T38 對話:(德川家康,今川義元)[[……屬下領命。\n屬下立即出陣。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_38", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt1\" )"},
    // T39 對話:(今川義元,德川家康)[[嗯……那我就等你的好消息。\n我所率領的本軍也會隨後跟上的。\n對了，此次如果夠努力的話，\n(德川家康.姓)家的再興我也可以考慮考慮……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_39", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt1\" )"},
    // T40 對話:(德川家康,忍者)[[！！　您說的是真的嗎！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Agent::template_ninja_male_01", "textKey": "LWN_SCN_okehazama_EFF06E00_159_40", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt1\" )"},
    // T41 對話:(今川義元,德川家康)[[我(今川義元)一言既出，\n駟馬難追。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_41", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt1\" )"},
    // T42 對話:(德川家康,德川家康)[[是！真是太感謝您了！\n屬下這就立刻出陣！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_42", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt1\" )"},
    // T43 對話:(忍者,德川家康)[[是！說實話，尾張的<城Ｂ>城\n已倒戈到本家這邊來了。\n這樣我方就有進攻(織田信長.姓)家領地的要害了。]],
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_43", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt0\" )"},
    // T44 對話:(德川家康,忍者)[[什麼！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Agent::template_ninja_male_01", "textKey": "LWN_SCN_okehazama_EFF06E00_159_44", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt0\" )"},
    // T45 對話:(忍者,德川家康)[[主公大人已命(鵜殿長照)大人為城代入城，\n而其也以此為上京的好機會而親自出陣了！]],
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_45", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt0\" )"},
    // T46 對話:(德川家康,忍者)[[嗯。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Agent::template_ninja_male_01", "textKey": "LWN_SCN_okehazama_EFF06E00_159_46", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt0\" )"},
    // T47 對話:(忍者,德川家康)[[另外尚有命令下達，\n他命(德川家康.姓)大人作為先鋒，\n將兵糧運送至<城Ｂ>去！]],
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_47", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt0\" )"},
    // T48 對話:(忍者,德川家康)[[(織田信長.姓)方也為了奪回<城Ｂ>而攻過來了……\n因此希望您能接下救援及運送兵糧之任務啊！]],
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_48", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt0\" )"},
    // T49 對話:(德川家康,忍者)[[嗯嗯……\n但是(織田信長.姓)大人可不是用一般方法就能應付的對手……\n雖說是先鋒，卻是個很重要的角色啊。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Agent::template_ninja_male_01", "textKey": "LWN_SCN_okehazama_EFF06E00_159_49", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt0\" )"},
    // T50 對話:(德川家康,今川義元)[[……我知道了！\n請傳達給主公大人，\n說我會立刻出陣的。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_50", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt0\" )"},
    // T51 對話:(忍者,德川家康)[[遵命！主公大人還說，\n此次如果夠努力的話，\n他也會考慮再興(德川家康.姓)家……]],
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_51", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt0\" )"},
    // T52 對話:(德川家康,忍者)[[！！　是真的嗎！\n聽到了嗎，各位！\n這場戰役絕不能輸！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Agent::template_ninja_male_01", "textKey": "LWN_SCN_okehazama_EFF06E00_159_52", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt0\" )"},
    // T53 對話:(德川家康,德川家康)[[立刻出陣吧！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_53", "when": "and( (Hero::MainHero) == (Hero::lord_1_tokugawa), (Ctx::choice) == \"opt0\" )"},
    // T54 旁白:[[就這樣，先鋒隊(德川家康)\n為了搬運兵糧到<城Ｂ>而出陣了……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF06E00_159_54", "when": "(Hero::MainHero) == (Hero::lord_1_tokugawa)"},
    // T55 對話:(太原雪齋,今川義元)[[但是，主公大人……\n在前方有尾張的(織田信長)。\n用一般的方法大概行不通吧……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_saito_dosan", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_55", "when": "(Hero::MainHero) == (Hero::lord_1_saito_dosan)"},
    // T56 對話:(今川義元,太原雪齋)[[怕什麼，不過是(織田信長.姓)的小鬼……\n敢不讓我軍前進，\n就把他幹掉吧。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_saito_dosan", "textKey": "LWN_SCN_okehazama_EFF06E00_159_56", "when": "(Hero::MainHero) == (Hero::lord_1_saito_dosan)"},
    // T57 對話:(太原雪齋,今川義元)[[可不能輕視他啊，大人。\n雖然謠傳(織田信長.名)是個大呆瓜，\n但那可能只是欺瞞諸國的策略啊。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_saito_dosan", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_57", "when": "(Hero::MainHero) == (Hero::lord_1_saito_dosan)"},
    // T58 對話:(今川義元,太原雪齋)[[不過是(織田信長.名)那小子，\n你們幹嘛那麼怕他啊……\n擔心過度了吧。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_saito_dosan", "textKey": "LWN_SCN_okehazama_EFF06E00_159_58", "when": "(Hero::MainHero) == (Hero::lord_1_saito_dosan)"},
    // T59 對話:(太原雪齋,今川義元)[[可是……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_saito_dosan", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_59", "when": "(Hero::MainHero) == (Hero::lord_1_saito_dosan)"},
    // T60 對話:(今川義元,德川家康)[[總而言之，開始著手上京的準備。\n首先打倒那個(織田信長)！\n命(德川家康)擔任先鋒！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_159_60", "when": "(Hero::MainHero) == (Hero::lord_1_saito_dosan)"},
    // T61 對話:(今川義元,人物Ｄ)[[首先打下(織田信長.姓)的<城Ｂ>！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_159_61", "when": "and( (Hero::MainHero) == (Hero::lord_1_saito_dosan), (Ctx::choice) == \"opt1\" )"},
    // T62 對話:(德川家康,今川義元)[[遵命！\n屬下知道了！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_62", "when": "and( (Hero::MainHero) == (Hero::lord_1_saito_dosan), (Ctx::choice) == \"opt1\" )"},
    // T63 對話:(今川義元,人物Ｄ)[[傳令下去！先打下(織田信長.姓)的<城Ｂ>！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_159_63", "when": "and( (Hero::MainHero) == (Hero::lord_1_saito_dosan), (Ctx::choice) == \"opt0\" )"},
    // T64 對話:(小姓,今川義元)[[遵命！\n屬下立刻去辦！]],
    {"cmd": "dialogue", "speaker": "Agent::template_koshou_01", "listener": "Hero::lord_1_imagawa_katsumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_159_64", "when": "and( (Hero::MainHero) == (Hero::lord_1_saito_dosan), (Ctx::choice) == \"opt0\" )"},
    // T65 旁白:[[就這樣，\n先鋒隊(德川家康)出陣了……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF06E00_159_65", "when": "(Hero::MainHero) == (Hero::lord_1_saito_dosan)"},
    // T66 對話:(今川義元,人物Ｄ)[[不要輸給(德川家康.名)的先鋒隊！\n本隊也出陣！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_imagawa_katsumoto", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_159_66", "when": "(Hero::MainHero) == (Hero::lord_1_saito_dosan)"},
