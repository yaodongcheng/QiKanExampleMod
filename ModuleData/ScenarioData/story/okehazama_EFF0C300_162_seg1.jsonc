{
  "id": "okehazama_EFF0C300_162_seg1",
  "form": "map_dialogue",
  "lines": [
    // T1 對話:(織田信長,主人公)[[全軍止步！！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_162_1"},
    // T2 對話:(人物Ｂ,織田信長)[[主公，怎麼了嗎？]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Hero::lord_1_oda", "textKey": "LWN_SCN_okehazama_EFF0C300_162_2"},
    // T3 對話:(織田信長,人物Ｂ)[[為了祈禱戰勝，\n我要到熱田神宮去參拜！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF0C300_162_3"},
    // T4 對話:(人物Ｃ,人物Ｂ)[[平常都不將神佛放在眼裡的主公，\n竟然會去祈禱戰勝也真是稀奇啊！]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_c", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF0C300_162_4", "when": "((Ctx::hero_c.gender)) == (0)"},
    // T5 對話:(人物Ｃ,人物Ｂ)[[平常都不將神佛放在眼裡的主公，\n竟然會去祈禱戰勝也真是稀奇啊！]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_c", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF0C300_162_5", "when": "not( ((Ctx::hero_c.gender)) == (0) )"},
    // T6 對話:(人物Ｄ,人物Ｃ)[[主公會這麼做，\n表面上是去祈禱戰勝，\n其實是有別的目的在吧！]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Ctx::hero_c", "textKey": "LWN_SCN_okehazama_EFF0C300_162_6", "when": "((Ctx::hero_c.gender)) == (0)"},
    // T7 對話:(人物Ｄ,人物Ｃ)[[主公會這麼做，\n表面上是去祈禱戰勝，\n其實是有別的目的在吧！]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Ctx::hero_c", "textKey": "LWN_SCN_okehazama_EFF0C300_162_7", "when": "not( ((Ctx::hero_c.gender)) == (0) )"},
    // T8 旁白:[[僅以數騎出擊，並持續奔馳了好一段路後，\n(織田信長)在熱田神宮停下馬來，\n很難得的進行了祈禱戰勝的儀式。]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_162_8"},
    // T9 旁白:[[據說在這期間，後續的士兵都趕了上來，\n好不容易湊成了一支像樣的軍隊，\n數量大概有五千人……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_162_9"},
    // T10 對話:(織田信長,僧侶)[[……嗯？\n好像從神像傳來了馬銜的聲音。\n這是吉兆嗎？還是……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Agent::template_souryo_01", "textKey": "LWN_SCN_okehazama_EFF0C300_162_10"},
    // T11 對話:(僧侶,織田信長)[[哦哦，在戰前聽到馬銜之音！\n這可是吉兆啊！]],
    {"cmd": "dialogue", "speaker": "Agent::template_souryo_01", "listener": "Hero::lord_1_oda", "textKey": "LWN_SCN_okehazama_EFF0C300_162_11"},
    // T12 對話:(織田信長,僧侶)[[嗯，吉兆嗎！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Agent::template_souryo_01", "textKey": "LWN_SCN_okehazama_EFF0C300_162_12"},
    // T13 對話:(織田信長,主人公)[[大家聽好了！\n熱田之神賜予了我們祥瑞之氣！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_162_13"},
    // T14 對話:(織田信長,主人公)[[天運是站在我們這一邊的！\n一定要擊潰(今川義元.姓)軍，\n將(今川義元.名)的首級給摘下來啊！！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_162_14"},
    // T15 對話:(足輕,織田信長)[[哦哦～！！]],
    {"cmd": "dialogue", "speaker": "Agent::template_ashigaru_01", "listener": "Hero::lord_1_oda", "textKey": "LWN_SCN_okehazama_EFF0C300_162_15"},
    // T16 對話:(忍者,織田信長)[[報告！<據點Ｃ>在(德川家康)的攻擊下陷落了！]],
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::lord_1_oda", "textKey": "LWN_SCN_okehazama_EFF0C300_162_16"},
    // T17 對話:(忍者,織田信長)[[守將(人物Ｄ)大人\n奮戰之餘仍無法挽回局勢\n被敵軍給殺死了]],
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::lord_1_oda", "textKey": "LWN_SCN_okehazama_EFF0C300_162_17", "when": "((Ctx::hero_d.settlement)) == (Settlement::tk5_city_083)"},
    // T18 對話:(織田信長,忍者)[[……是嗎，(人物Ｄ.名)他死了是嗎……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Agent::template_ninja_male_01", "textKey": "LWN_SCN_okehazama_EFF0C300_162_18", "when": "((Ctx::hero_d.settlement)) == (Settlement::tk5_city_083)"},
    // T19 對話:(織田信長,足輕)[[大家聽好了！！\n這是一場為了(人物Ｄ.名)的弔和戰爭！\n全軍跟好了！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Agent::template_ashigaru_01", "textKey": "LWN_SCN_okehazama_EFF0C300_162_19", "when": "((Ctx::hero_d.settlement)) == (Settlement::tk5_city_083)"},
    // T20 對話:(織田信長,忍者)[[是嗎，<據點Ｃ>陷落了嗎……\n但是，我方的目標就只有(今川義元.名)的首級一個！\n大家跟好了！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Agent::template_ninja_male_01", "textKey": "LWN_SCN_okehazama_EFF0C300_162_20", "when": "not( ((Ctx::hero_d.settlement)) == (Settlement::tk5_city_083) )"}
  ]
}