    // T31 對話:(功勳家臣,織田信長)[[是要固守城池不出，\n還是出城在野外迎敵呢……\n主公，要怎麼做？]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_koushin_kashin_01", "listener": "Hero::lord_1_oda", "textKey": "LWN_SCN_okehazama_EFF0C300_159_31", "when": "not( (Hero::MainHero.settlement) == (Settlement::tk5_city_083) )"},
    // T32 對話:(織田信長,功勳家臣)[[……還沒決定。]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Agent::template_koushin_kashin_01", "textKey": "LWN_SCN_okehazama_EFF0C300_159_32", "when": "not( (Hero::MainHero.settlement) == (Settlement::tk5_city_083) )"},
    // T33 對話:(功勳家臣,織田信長)[[這可不行啊！\n在這樣下去的話，\n(今川義元.姓)軍就要逼近到城下了啊{未知47}！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_koushin_kashin_01", "listener": "Hero::lord_1_oda", "textKey": "LWN_SCN_okehazama_EFF0C300_159_33", "when": "not( (Hero::MainHero.settlement) == (Settlement::tk5_city_083) )"},
    // T34 對話:(織田信長,功勳家臣)[[固守城池的話，沒有援軍根本就沒有勝算。\n無謀地出去迎擊，\n也只是被對方的大軍給淹沒罷了。]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Agent::template_koushin_kashin_01", "textKey": "LWN_SCN_okehazama_EFF0C300_159_34", "when": "not( (Hero::MainHero.settlement) == (Settlement::tk5_city_083) )"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Agent::template_koshou_01,
