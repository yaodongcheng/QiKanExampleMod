    // T10 對話:(德川家康,人物Ｂ)[[什、什麼！！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF06E00_165_10", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Ctx::hero_c,
    {"cmd": "actor_enter", "actor": "Ctx::hero_c", "slot": "side"},
    // T11 對話:(人物Ｃ,德川家康)[[這可不是開玩笑的啊！\n難道……怎麼會有這種事……]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_c", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_165_11", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // 舞台推导：首次发言自动入场（05 纪律 6①）: Hero::lord_1_mizuno_nobumoto,
    {"cmd": "actor_enter", "actor": "Hero::lord_1_mizuno_nobumoto", "slot": "side"},
    // T12 對話:(水野信元,德川家康)[[這是事實！(德川家康.名)大人……\n吾家主公奇襲了(今川義元)，\n而奪取了其性命！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_mizuno_nobumoto", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_165_12", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1), ((Hero::lord_1_mizuno_nobumoto.clan)) == (Clan::clan_oda_1) )"},
    // T13 對話:(德川家康,水野信元)[[叔、叔父大人！？]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Hero::lord_1_mizuno_nobumoto", "textKey": "LWN_SCN_okehazama_EFF06E00_165_13", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1), ((Hero::lord_1_mizuno_nobumoto.clan)) == (Clan::clan_oda_1) )"},
    // T14 旁白:[[(水野信元)是(德川家康)的母親阿大之兄，\n並曾侍奉於(織田信長)的武將……]],,,
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF06E00_165_14", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1), ((Hero::lord_1_mizuno_nobumoto.clan)) == (Clan::clan_oda_1) )"},
    // T15 對話:(忍者,主人公)[[這是事實！！\n取下主公大人首級的是(織田信長.姓)軍的足輕，\n毛利新介與服部小平太兩人！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF06E00_165_15", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1), not( ((Hero::lord_1_mizuno_nobumoto.clan)) == (Clan::clan_oda_1) ) )"},
    // T16 對話:(德川家康,人物Ｂ)[[竟然會有這種事……！\n難道說……]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF06E00_165_16", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // T17 對話:(人物Ｂ,德川家康)[[沒想到(今川義元.姓)的大軍……\n竟然敗給了(織田信長.姓)的小軍隊……]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_165_17", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // T18 對話:(德川家康,人物Ｂ)[[但是……那(織田信長.名)的話，或許辦的到。]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF06E00_165_18", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // T19 對話:(人物Ｃ,德川家康)[[大人！今後該怎麼辦呢……\n總之先回<城Ｂ>嗎？]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_c", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_165_19", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // T20 對話:(德川家康,人物Ｂ)[[不，目的地是……<據點Ｃ>。]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF06E00_165_20", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // T21 對話:(人物Ｂ,德川家康)[[去<城Ｃ>……！？\n可、可是……]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_165_21", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // T22 對話:(德川家康,人物Ｂ)[[主公……不，已故的主公大人曾經說過，\n如果此戰勝利的話，就允許讓(德川家康.姓)家再興。\n我們要履行其承諾。]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF06E00_165_22", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // T23 對話:(德川家康,人物Ｂ)[[而且，現在主公大人已身亡……(今川義元.姓)家應該也還在混亂中\n所以更應該趁此機會，\n將原本屬於我們的城<城Ｃ>給取回來！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF06E00_165_23", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // T24 對話:(人物Ｃ,德川家康)[[真是個好主意！\n回我們的城<城Ｃ>吧！]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_c", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_165_24", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // T25 對話:(德川家康,人物Ｂ)[[既然決定了，那就事不宜遲！\n走吧！]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF06E00_165_25", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
    // T26 對話:(人物Ｂ,德川家康)[[是！！]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_165_26", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1), ((Ctx::hero_b.gender)) == (0) )"},
    // T27 對話:(人物Ｂ,德川家康)[[遵命！！]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_165_27", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1), not( ((Ctx::hero_b.gender)) == (0) ) )"},
    // T28 對話:(水野信元,德川家康)[[(德川家康.名)大人，請您一定要特別小心！\n雖說(今川義元.名)已被打倒，\n但是(今川義元.姓)的勢力依然很強大啊。]],,,
