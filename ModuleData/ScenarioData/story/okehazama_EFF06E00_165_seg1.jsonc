    // T48 對話:(忍者,主人公)[[這是事實！！\n取下主公大人首級的是(織田信長.姓)軍的足輕，\n毛利新介與服部小平太兩人！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_ninja_male_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF06E00_165_48", "when": "and( not( (Variable::last_battle_result) == (\"ended\") ), not( ((Hero::lord_1_mizuno_nobumoto.clan)) == (Clan::clan_oda_1) ) )"},
    // T49 對話:(德川家康,人物Ｂ)[[竟然會有這種事……！\n難道說……]],,,
