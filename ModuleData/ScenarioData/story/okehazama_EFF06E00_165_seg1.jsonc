    // T1 對話:(備大將,德川家康)[[是我方的大勝利！\n敵將陣亡了！]],,,
    {"cmd": "dialogue", "speaker": "Agent::template_shougun_01", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_165_1", "when": "and( (Variable::last_battle_result) == (\"ended\"), ((Army::army_1.result)) == (1) )"},
