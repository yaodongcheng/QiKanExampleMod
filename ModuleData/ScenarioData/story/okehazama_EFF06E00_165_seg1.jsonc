    // T50 對話:(人物Ｂ,德川家康)[[沒想到(今川義元.姓)的大軍……\n竟然敗給了(織田信長.姓)的小軍隊……]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_b", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_165_50", "when": "not( (Variable::last_battle_result) == (\"ended\") )"},
    // T51 對話:(德川家康,人物Ｂ)[[但是……那(織田信長.名)的話，或許辦的到。]],,,
    {"cmd": "dialogue", "speaker": "Hero::lord_1_tokugawa", "listener": "Ctx::hero_b", "textKey": "LWN_SCN_okehazama_EFF06E00_165_51", "when": "not( (Variable::last_battle_result) == (\"ended\") )"},
    // T52 對話:(人物Ｃ,德川家康)[[大人！今後該怎麼辦呢……\n總之先回<城Ｂ>嗎？]],,,
    {"cmd": "dialogue", "speaker": "Ctx::hero_c", "listener": "Hero::lord_1_tokugawa", "textKey": "LWN_SCN_okehazama_EFF06E00_165_52", "when": "not( (Variable::last_battle_result) == (\"ended\") )"},
    // T53 對話:(德川家康,人物Ｂ)[[不，目的地是……<據點Ｃ>。]],,,
