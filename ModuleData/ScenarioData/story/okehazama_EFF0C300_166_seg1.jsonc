{
  "id": "okehazama_EFF0C300_166_seg1",
  "form": "menu_dialogue",
  "lines": [
    // T1 對話:(歸蝶,織田信長)[[歡迎您回來！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kicho", "listener": "Hero::lord_1_oda", "textKey": "LWN_SCN_okehazama_EFF0C300_166_1", "when": "(Hero::MainHero) == (Hero::lord_1_oda)"},
    // T2 對話:(織田信長,歸蝶)[[(歸蝶)，我成功了！殺死(今川義元)了。\n我親手！……把那個(今川義元.名)！\n把(今川義元)給打倒了！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Hero::lord_1_kicho", "textKey": "LWN_SCN_okehazama_EFF0C300_166_2", "when": "(Hero::MainHero) == (Hero::lord_1_oda)"},
    // T3 對話:(歸蝶,織田信長)[[真是恭喜您了！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kicho", "listener": "Hero::lord_1_oda", "textKey": "LWN_SCN_okehazama_EFF0C300_166_3", "when": "(Hero::MainHero) == (Hero::lord_1_oda)"},
    // T4 對話:(織田信長,歸蝶)[[嗯！你的丈夫成為古今無雙的名將了！\n你也算是三生有幸啊！\n哈哈哈……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_oda", "listener": "Hero::lord_1_kicho", "textKey": "LWN_SCN_okehazama_EFF0C300_166_4", "when": "(Hero::MainHero) == (Hero::lord_1_oda)"},
    // T5 對話:(歸蝶,織田信長)[[是的！！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kicho", "listener": "Hero::lord_1_oda", "textKey": "LWN_SCN_okehazama_EFF0C300_166_5", "when": "(Hero::MainHero) == (Hero::lord_1_oda)"},
    // T6 對話:(寧寧,豐臣秀吉)[[(豐臣秀吉.名)大人～！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita_1", "listener": "Hero::lord_1_kinoshita", "textKey": "LWN_SCN_okehazama_EFF0C300_166_6", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T7 對話:(豐臣秀吉,寧寧)[[哦哦，(寧寧)小姐！\n我成功了，我們打勝仗了！！\n大獲全勝啊！！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita", "listener": "Hero::lord_1_kinoshita_1", "textKey": "LWN_SCN_okehazama_EFF0C300_166_7", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T8 對話:(豐臣秀吉,寧寧)[[而且也因為殺死了對方的當主(今川義元.名)。\n所以(今川義元.姓)家應該會有一陣子\n不會再攻過來了。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita", "listener": "Hero::lord_1_kinoshita_1", "textKey": "LWN_SCN_okehazama_EFF0C300_166_8", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T9 對話:(寧寧,豐臣秀吉)[[那、那麼說，(豐臣秀吉.名)大人，\n你都沒事嗎？]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita_1", "listener": "Hero::lord_1_kinoshita", "textKey": "LWN_SCN_okehazama_EFF0C300_166_9", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T10 對話:(豐臣秀吉,寧寧)[[連一點擦傷都沒有！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita", "listener": "Hero::lord_1_kinoshita_1", "textKey": "LWN_SCN_okehazama_EFF0C300_166_10", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T11 對話:(寧寧,豐臣秀吉)[[那真是太好了！\n我好擔心你會不會太勉強自己\n而不幸戰死呢！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita_1", "listener": "Hero::lord_1_kinoshita", "textKey": "LWN_SCN_okehazama_EFF0C300_166_11", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T12 對話:(豐臣秀吉,寧寧)[[話、話說回來，\n關於出陣之前和你說的那件事……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita", "listener": "Hero::lord_1_kinoshita_1", "textKey": "LWN_SCN_okehazama_EFF0C300_166_12", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T13 對話:(寧寧,豐臣秀吉)[[我，已經決定了。]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita_1", "listener": "Hero::lord_1_kinoshita", "textKey": "LWN_SCN_okehazama_EFF0C300_166_13", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T14 對話:(寧寧,豐臣秀吉)[[請讓(寧寧)成為(豐臣秀吉.名)大人的新娘！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita_1", "listener": "Hero::lord_1_kinoshita", "textKey": "LWN_SCN_okehazama_EFF0C300_166_14", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T15 對話:(豐臣秀吉,寧寧)[[你、你是說真的嗎！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita", "listener": "Hero::lord_1_kinoshita_1", "textKey": "LWN_SCN_okehazama_EFF0C300_166_15", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T16 對話:(寧寧,豐臣秀吉)[[是的！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita_1", "listener": "Hero::lord_1_kinoshita", "textKey": "LWN_SCN_okehazama_EFF0C300_166_16", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T17 對話:(豐臣秀吉,寧寧)[[哦哦，這不會是在作夢吧！\n……真、真的嗎]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita", "listener": "Hero::lord_1_kinoshita_1", "textKey": "LWN_SCN_okehazama_EFF0C300_166_17", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T18 對話:(豐臣秀吉,寧寧)[[(寧寧)小姐，請用力捏一下\n在下的臉頰！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita", "listener": "Hero::lord_1_kinoshita_1", "textKey": "LWN_SCN_okehazama_EFF0C300_166_18", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T19 旁白:[[揪！]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF0C300_166_19", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T20 對話:(豐臣秀吉,寧寧)[[好痛啊啊啊……\n太好了，不是在作夢，\n太好了……]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita", "listener": "Hero::lord_1_kinoshita_1", "textKey": "LWN_SCN_okehazama_EFF0C300_166_20", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T21 對話:(寧寧,豐臣秀吉)[[(豐臣秀吉.名)大人你真是的……\n呵呵呵！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita_1", "listener": "Hero::lord_1_kinoshita", "textKey": "LWN_SCN_okehazama_EFF0C300_166_21", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"},
    // T22 對話:(寧寧,豐臣秀吉)[[好了，你一定很累了吧！\n請休息吧！]],
    {"cmd": "dialogue", "speaker": "Hero::lord_1_kinoshita_1", "listener": "Hero::lord_1_kinoshita", "textKey": "LWN_SCN_okehazama_EFF0C300_166_22", "when": "and( (Hero::MainHero) == (Hero::lord_1_kinoshita), ((Hero::MainHero.spouse)) == (null), (Variable::scenario) == (1) )"}
