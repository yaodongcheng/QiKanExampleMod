{
  "id": "okehazama_EFF06E00_171_seg1",
  "form": "menu_dialogue",
  "lines": [
    // T1 對話:(人物Ｄ,主人公)[[{主人公.名前}！！\n大事不好了！！]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF06E00_171_1"},
    // T2 對話:(主人公,人物Ｄ)[[什麼事！？]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_171_2"},
    // T3 對話:(人物Ｄ,主人公)[[主公大人陣亡了！！]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF06E00_171_3"},
    // T4 對話:(主人公,人物Ｄ)[[什、什麼！！]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_171_4", "when": "((Hero::MainHero.gender)) == (0)"},
    // T5 對話:(主人公,人物Ｄ)[[你、你說什麼！？]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_171_5", "when": "not( ((Hero::MainHero.gender)) == (0) )"},
    // T6 對話:(人物Ｄ,主人公)[[主公大人，為了一償上京的宿願，\n前些日子，往尾張方面出陣了……\n在此途中，行經(織田信長.姓)家領地時……]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF06E00_171_6"},
    // T7 對話:(人物Ｄ,主人公)[[軍隊在桶狹間稍作休憩的時候，\n遭到(織田信長)的奇襲攻擊，\n一下子就陣亡了……]],
    {"cmd": "dialogue", "speaker": "Ctx::hero_d", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF06E00_171_7"},
    // T8 對話:(主人公,人物Ｄ)[[……這是怎麼回事。\n(織田信長)他……]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_171_8"},
    // T9 旁白:[[<年>年<月>月，\n(今川義元)在桶狹間遭到(織田信長)的奇襲，\n並被取下了首級……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF06E00_171_9"},
    // T10 旁白:[[被譽為海道第一弓取，\n並成為駿河遠江三河大大名\n的戰國英雄(今川義元)……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF06E00_171_10"},
    // T11 旁白:[[他的死亡使時代產生了極大的變動……\n因為繼承(今川義元.名)衣缽的(今川氏真)，\n並沒有足以超越其父的器量……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF06E00_171_11"},
    // T12 旁白:[[之後，(德川家康)家\n公然地發表脫離(今川義元.姓)家的獨立宣言……]],
    {"cmd": "narrator", "textKey": "LWN_SCN_okehazama_EFF06E00_171_12"},
    // T13 對話:(主人公,人物Ｄ)[[今後，(今川氏真.姓)家\n將會何去何從呢……？]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_171_13", "when": "((Hero::MainHero.gender)) == (0)"},
    // T14 對話:(主人公,人物Ｄ)[[今後，(今川氏真.姓)家\n將會何去何從呢……？]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Ctx::hero_d", "textKey": "LWN_SCN_okehazama_EFF06E00_171_14", "when": "not( ((Hero::MainHero.gender)) == (0) )"}
  ]
}