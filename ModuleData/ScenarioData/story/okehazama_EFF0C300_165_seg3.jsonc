  "lines": [
    // T13 對話:(備大將,主人公)[[(主人公.姓)大人！不久前有一位\n叫做(岡部元信)的(今川氏真.姓)家臣，\n前來請拜見主公。]],
    {"cmd": "dialogue", "speaker": "Agent::template_shougun_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_165_13", "when": "and( (Hero::MainHero.settlement) == (Hero::MainHero.home), not( (Hero::MainHero) == (Hero::lord_1_oda) ) )"},
    // T14 對話:(主人公,備大將)[[(今川氏真.姓)的家臣……\n是為了什麼事前來？]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_shougun_01", "textKey": "LWN_SCN_okehazama_EFF0C300_165_14", "when": "and( (Hero::MainHero.settlement) == (Hero::MainHero.home), not( (Hero::MainHero) == (Hero::lord_1_oda) ) )"},
    // T15 對話:(備大將,主人公)[[(岡部元信.名)大人是來請求我方歸還在上次\n戰爭中所砍下的(今川義元)之首級。]],
    {"cmd": "dialogue", "speaker": "Agent::template_shougun_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_165_15", "when": "and( (Hero::MainHero.settlement) == (Hero::MainHero.home), not( (Hero::MainHero) == (Hero::lord_1_oda) ) )"},
    // T16 對話:(主人公,備大將)[[為了拿回主君的首級，\n而敢支身前來敵方的城池，\n真是值得尊敬的人物啊！]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_shougun_01", "textKey": "LWN_SCN_okehazama_EFF0C300_165_16", "when": "and( (Hero::MainHero.settlement) == (Hero::MainHero.home), not( (Hero::MainHero) == (Hero::lord_1_oda) ) )"},
    // T17 對話:(備大將,主人公)[[(岡部元信.名)大人說如果我方願意歸還首級，\n他便會保護著首級返回<城Ｂ>，\n並將<城Ｃ>奉送給(織田信長.姓)的主公……]],
    {"cmd": "dialogue", "speaker": "Agent::template_shougun_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_165_17", "when": "and( (Hero::MainHero.settlement) == (Hero::MainHero.home), not( (Hero::MainHero) == (Hero::lord_1_oda) ) )"},
    // T18 對話:(備大將,主人公)[[主公便很爽快地答應了他。]],
    {"cmd": "dialogue", "speaker": "Agent::template_shougun_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_165_18", "when": "and( (Hero::MainHero.settlement) == (Hero::MainHero.home), not( (Hero::MainHero) == (Hero::lord_1_oda) ) )"},
    // T19 對話:(主人公,備大將)[[哦，<城Ｃ>竟然可以用一顆首級就換回來啊！]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_shougun_01", "textKey": "LWN_SCN_okehazama_EFF0C300_165_19", "when": "and( (Hero::MainHero.settlement) == (Hero::MainHero.home), not( (Hero::MainHero) == (Hero::lord_1_oda) ), ((Hero::MainHero.gender)) == (0) )"},
    // T20 對話:(主人公,備大將)[[<城Ｃ>竟然用一顆首級就換回來，\n還真是賺到了呀！]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_shougun_01", "textKey": "LWN_SCN_okehazama_EFF0C300_165_20", "when": "and( (Hero::MainHero.settlement) == (Hero::MainHero.home), not( (Hero::MainHero) == (Hero::lord_1_oda) ), not( ((Hero::MainHero.gender)) == (0) ) )"},
    // T21 對話:(備大將,主人公)[[(主人公.姓)大人！\n(今川氏真.姓)的家臣(岡部元信)向主公提出用<城Ｃ>交換\n(今川義元.名)之首級的提議了。]],
    {"cmd": "dialogue", "speaker": "Agent::template_shougun_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_165_21", "when": "not( (Hero::MainHero.settlement) == (Hero::MainHero.home) )"},
    // T22 對話:(主人公,備大將)[[哦……\n結果主公怎麼說？]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_shougun_01", "textKey": "LWN_SCN_okehazama_EFF0C300_165_22", "when": "and( not( (Hero::MainHero.settlement) == (Hero::MainHero.home) ), ((Hero::MainHero.gender)) == (0) )"},
    // T23 對話:(主人公,備大將)[[那麼，主公是怎麼說的？]],
    {"cmd": "dialogue", "speaker": "Hero::MainHero", "listener": "Agent::template_shougun_01", "textKey": "LWN_SCN_okehazama_EFF0C300_165_23", "when": "and( not( (Hero::MainHero.settlement) == (Hero::MainHero.home) ), not( ((Hero::MainHero.gender)) == (0) ) )"},
    // T24 對話:(備大將,主人公)[[是，主公很爽快地\n就答應了他。]],
    {"cmd": "dialogue", "speaker": "Agent::template_shougun_01", "listener": "Hero::MainHero", "textKey": "LWN_SCN_okehazama_EFF0C300_165_24", "when": "not( (Hero::MainHero.settlement) == (Hero::MainHero.home) )"},
