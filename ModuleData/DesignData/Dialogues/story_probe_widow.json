      "NpcActions": [
        "act_conversation_hip_trivial",
        "act_conversation_hip_trivial"
      ]
    },
    {
      "Id": "event_3_join",
      "NpcKey": "LWN_story_event3_join",
      "NpcKeyZh": "（寡妇，对台领班）：抢客抢到我台口来了，还要不要脸？\n（对台领班，寡妇）：街面是官家的，谁有本事谁开锣，你管得着吗？",
      "Transitions": [
        {
          "PlayerKey": "LWN_story_event3_opt_side_widow",
          "PlayerKeyZh": "[帮腔] 台上的角儿凭唱功吃饭，堵人台口算什么本事。",
          "CheckType": "SkillCheck",
          "CheckTag": "rival|charm",
          "NextNodeOnSuccess": "event_3_win",
          "NextNodeOnFail": "event_3_lose"
        },
        {
          "PlayerKey": "LWN_story_event3_opt_ask",
          "PlayerKeyZh": "[插话] 两位因何事当街争执？",
          "NextNodeOnSuccess": "event_3_ask"
        },
        {
          "PlayerKey": "LWN_story_event3_opt_walk",
          "PlayerKeyZh": "[走开] 戏班子的事我不掺和。",
          "NextNodeOnSuccess": ""
        }
      ],
      "NpcActions": [
        "act_conversation_hip_trivial",
        "act_conversation_hip_trivial"
      ]
    },
    {
      "Id": "event_3_ask",
      "NpcKey": "LWN_story_event3_ask",
      "NpcKeyZh": "（对台领班，玩家）：这戏婆霸着城门口唱了三年，我们刚支起台子她就来掀场！\n（寡妇，玩家）：放屁！是码头帮塞你们过来挤兑我的饭碗！",
      "Transitions": [
        {
          "PlayerKey": "LWN_story_event3_opt_side_widow",
          "PlayerKeyZh": "[帮腔] 台上的角儿凭唱功吃饭，堵人台口算什么本事。",
          "CheckType": "SkillCheck",
          "CheckTag": "rival|charm",
          "NextNodeOnSuccess": "event_3_win",
          "NextNodeOnFail": "event_3_lose"
        },
        {
          "PlayerKey": "LWN_story_event3_opt_walk",
          "PlayerKeyZh": "[走开] 戏班子的事我不掺和。",
          "NextNodeOnSuccess": ""
        }
      ],
      "NpcActions": [
        "act_conversation_hip_trivial",
        "act_conversation_hip_trivial"
      ]
    },
    {
      "Id": "event_3_win",
      "NpcKey": "LWN_story_event3_win",
      "NpcKeyZh": "（对台领班，寡妇）：……行，牙尖嘴利，今天这出先让给你。\n（寡妇，玩家）：刚才那两句帮腔漂亮，我记下了。",
      "EnterAction": "PROBE:resolve_event",
      "EnterParam": "3|players|5",
      "Transitions": [
