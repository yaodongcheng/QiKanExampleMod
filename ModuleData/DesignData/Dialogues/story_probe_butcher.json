{
  "Npc": "butcher",
  "EntryOption": "LWN_story_butcher_entry",
  "EntryOptionZh": "[说两句] 这肉新鲜吗？",
  "EntryNode": "butcher_intro",
  "Nodes": [
    {
      "Id": "butcher_intro",
      "NpcKey": "LWN_story_butcher_intro",
      "NpcKeyZh": "（屠户，玩家）：今早刚宰的，新鲜。\n（屠户，玩家）：不买肉就往边上站，别挡着案板。",
      "EnterAction": "PROBE:mark",
      "EnterParam": "met",
      "Transitions": [
        {
          "PlayerKey": "LWN_story_butcher_opt_meat",
          "PlayerKeyZh": "[搭话] 这么大个肉案，就你一个人守着？",
          "Once": "ask_meat",
          "Action": "PROBE:mark",
          "ActionParam": "ask_meat",
          "NextNodeOnSuccess": "butcher_ask_meat"
        },
        {
          "PlayerKey": "LWN_story_butcher_opt_past",
          "PlayerKeyZh": "[打听] 听街坊说，你以前也是码头帮的人？",
          "Once": "ask_past",
          "Action": "PROBE:mark",
          "ActionParam": "ask_past",
          "NextNodeOnSuccess": "butcher_ask_past"
        },
        {
          "PlayerKey": "LWN_story_butcher_opt_sister",
          "PlayerKeyZh": "[打听] 见过一个被码头帮带走的青布姑娘吗？",
