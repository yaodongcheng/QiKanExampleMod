        "act_conversation_closed_trivial",
        "act_conversation_closed_trivial"
      ]
    },
    {
      "Id": "butcher_ask_past",
      "NpcKey": "LWN_story_butcher_ask_past",
      "NpcKeyZh": "（屠户，玩家）：……你听哪个碎嘴子说的？\n（屠户，玩家）：少打听以前的事。",
      "Transitions": [
        {
          "PlayerKey": "LWN_story_butcher_opt_past_more",
          "PlayerKeyZh": "[追问] 我不是码头帮的探子——他们为什么砸你的摊？",
          "Once": "past_more",
          "Action": "PROBE:mark",
          "ActionParam": "past_more",
          "NextNodeOnSuccess": "butcher_ask_past_2"
