      "NpcActions": [
        "act_conversation_closed_negative",
        "act_conversation_closed_trivial"
      ]
    },
    {
      "Id": "butcher_ask_past_2",
      "NpcKey": "LWN_story_butcher_ask_past_2",
      "NpcKeyZh": "（屠户，玩家）：他们逼我去干押活人的脏活，我不干，他们就砸了我的摊子。\n（屠户，玩家）：从那天起我就跟码头帮断了。要我的命可以，要我再干脏活不行。",
      "Transitions": [
        {
          "PlayerKey": "LWN_story_butcher_opt_back",
          "PlayerKeyZh": "[收住] 别的先不问了。",
          "NextNodeOnSuccess": "butcher_hub"
        }
      ],
      "NpcActions": [
        "act_conversation_closed_trivial",
        "act_conversation_closed_trivial"
      ]
    },
    {
      "Id": "butcher_ask_sister",
      "NpcKey": "LWN_story_butcher_ask_sister",
      "NpcKeyZh": "（屠户，玩家）：押人的脏事我早不沾了。\n（屠户，玩家）：不过上个月底半夜，我听见他们押着人往西码头暗仓去了。",
      "Transitions": [
        {
          "PlayerKey": "LWN_story_butcher_opt_sister2",
          "PlayerKeyZh": "[追问] 西码头暗仓那边，还有什么讲究？",
          "Once": "sister_more",
          "Action": "PROBE:mark",
          "ActionParam": "sister_more",
          "NextNodeOnSuccess": "butcher_ask_sister_2"
        },
        {
          "PlayerKey": "LWN_story_butcher_opt_back",
          "PlayerKeyZh": "[收住] 别的先不问了。",
          "NextNodeOnSuccess": "butcher_hub"
        }
      ],
      "NpcActions": [
        "act_conversation_closed_trivial",
        "act_conversation_closed_trivial"
      ]
    },
    {
      "Id": "butcher_ask_sister_2",
      "NpcKey": "LWN_story_butcher_ask_sister_2",
      "NpcKeyZh": "（屠户，玩家）：进那间暗仓的人，没一个能自己走出来。\n（屠户，玩家）：你要去救人，手里没把趁手家伙就是白送命。",
      "Transitions": [
        {
          "PlayerKey": "LWN_story_butcher_opt_back",
          "PlayerKeyZh": "[收住] 别的先不问了。",
          "NextNodeOnSuccess": "butcher_hub"
        }
      ],
      "NpcActions": [
        "act_conversation_closed_trivial",
        "act_conversation_closed_trivial"
      ]
    },
    {
      "Id": "butcher_deal",
      "NpcKey": "LWN_story_butcher_deal",
      "NpcKeyZh": "（屠户，玩家）：想拿家伙、学两手？先替我办件事。\n（屠户，玩家）：收保护费的打手天天来砸摊，让他收手，怎么摆平你自己选。",
      "Transitions": [
        {
          "PlayerKey": "LWN_story_opt_take_job",
          "PlayerKeyZh": "[应下] 这活我接了。",
          "NextNodeOnSuccess": "butcher_quest_accept"
        },
        {
          "PlayerKey": "LWN_story_butcher_opt_why",
          "PlayerKeyZh": "[反问] 你手头有刀有肉，怎么不自己剁了他？",
          "Once": "butcher_why",
          "Action": "PROBE:mark",
          "ActionParam": "butcher_why",
          "NextNodeOnSuccess": "butcher_deal_why"
        },
        {
          "PlayerKey": "LWN_story_butcher_opt_refuse",
          "PlayerKeyZh": "[缓一缓] 我暂时不想替人出头。",
          "NextNodeOnSuccess": "butcher_deal_refuse"
        }
      ],
      "NpcActions": [
        "act_conversation_closed_trivial",
        "act_conversation_closed_trivial"
      ]
    },
    {
      "Id": "butcher_deal_why",
      "NpcKey": "LWN_story_butcher_deal_why",
      "NpcKeyZh": "（屠户，玩家）：我提刀砍了他，码头帮就有借口烧我铺子。\n（屠户，玩家）：你是外乡人，替我出面劝他也好，打服他也好，别闹出人命。",
      "Transitions": [
        {
          "PlayerKey": "LWN_story_opt_take_job",
          "PlayerKeyZh": "[应下] 这活我接了。",
          "NextNodeOnSuccess": "butcher_quest_accept"
        },
        {
          "PlayerKey": "LWN_story_butcher_opt_back",
          "PlayerKeyZh": "[收住] 别的先不问了。",
          "NextNodeOnSuccess": "butcher_hub"
        }
      ],
      "NpcActions": [
        "act_conversation_closed_trivial",
        "act_conversation_closed_trivial"
