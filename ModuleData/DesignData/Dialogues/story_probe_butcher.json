          "Action": "PROBE:mark+clue",
          "ActionParam": "ask_sister;sister_6",
          "NextNodeOnSuccess": "butcher_ask_sister"
        },
        {
          "PlayerKey": "LWN_story_butcher_opt_deal",
          "PlayerKeyZh": "[求门路] 我身上没家伙，能不能借把刀、教我两手？",
          "Requires": "!quest_accepted,!quest_turned,asked:ask_past",
          "NextNodeOnSuccess": "butcher_deal"
        },
        {
          "PlayerKey": "LWN_story_butcher_opt_chat",
          "PlayerKeyZh": "[叙旧] 今天的肉看着不错。",
          "Requires": "quest_turned",
          "NextNodeOnSuccess": "butcher_chat"
