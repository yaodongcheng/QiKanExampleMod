    {
      "Id": "butcher_ask_meat",
      "NpcKey": "LWN_story_butcher_ask_meat",
      "NpcKeyZh": "（屠户，玩家）：以前有个徒弟帮衬，上个月让码头帮吓跑了。\n（屠户，玩家）：现在就我一把刀、一张案板，谁来也不让。",
      "Transitions": [
        {
          "PlayerKey": "LWN_story_butcher_opt_back",
          "PlayerKeyZh": "[收住] 别的先不问了。",
          "NextNodeOnSuccess": "butcher_hub"
        }
