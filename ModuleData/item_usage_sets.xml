		<guards>
			<guard
				style="right"
				action="act_guard_bow" />
			<guard
				style="none" />
		</guards>
	</item_usage_set>
	<item_usage_set
		id="grapple_hook">
		<idles>
			<idle
				action="act_grapple_idle"
				is_left_stance="False"
				require_free_left_hand="False" />
		</idles>
		<usages>
			<usage
				style="attack_any"
				reload_action="act_grapple_reload"
				reload_crouched_action="act_grapple_reload"
				ready_action="act_grapple_ground_ready"
				release_action="act_grapple_ground_release"
				ready_continue_ranged_action="act_grapple_ground_hold"
				ready_continue_shake_action="act_grapple_ground_hold"
