				required_mount_action="act_horse_idle_3" />
			<rider_idle
				mount_id="horse"
				pace="1"
				action="act_rider_idle_bow_4"
				require_free_left_hand="True"
				required_mount_action="act_horse_idle_4" />
			<rider_idle
				mount_id="horse"
				pace="1"
				action="act_rider_stand_bow_1"
				require_free_left_hand="True"
				required_mount_action="act_horse_stand_1" />
			<rider_idle
				mount_id="horse"
				pace="1"
				action="act_rider_stand_bow_2"
				require_free_left_hand="True"
				required_mount_action="act_horse_stand_2" />
			<rider_idle
				mount_id="horse"
				pace="1"
				action="act_rider_stand_bow_3"
				require_free_left_hand="True"
				required_mount_action="act_horse_stand_3" />
			<rider_idle
				mount_id="horse"
				pace="1"
				action="act_rider_stand_bow_4"
				require_free_left_hand="True"
				required_mount_action="act_horse_stand_4" />
			<rider_idle
				mount_id="camel"
				pace="1"
				action="act_camel_rider_idle_bow_1"
				require_free_left_hand="True"
				required_mount_action="act_camel_idle_1" />
			<rider_idle
				mount_id="camel"
				pace="1"
				action="act_camel_rider_idle_bow_2"
				require_free_left_hand="True"
				required_mount_action="act_camel_idle_2" />
			<rider_idle
				mount_id="camel"
				pace="1"
				action="act_camel_rider_idle_bow_3"
				require_free_left_hand="True"
				required_mount_action="act_camel_idle_3" />
			<rider_idle
				mount_id="camel"
				pace="1"
				action="act_camel_rider_idle_bow_4"
				require_free_left_hand="True"
				required_mount_action="act_camel_idle_4" />
			<rider_idle
				mount_id="camel"
				pace="1"
				action="act_camel_rider_idle_bow_5"
				require_free_left_hand="True"
				required_mount_action="act_camel_idle_5" />
			<rider_idle
				mount_id="camel"
				pace="1"
				action="act_camel_rider_stand_bow_1"
				require_free_left_hand="True"
				required_mount_action="act_camel_stand_1" />
			<rider_idle
				mount_id="camel"
				pace="1"
				action="act_camel_rider_stand_bow_2"
				require_free_left_hand="True"
				required_mount_action="act_camel_stand_2" />
			<rider_idle
				mount_id="camel"
				pace="1"
				action="act_camel_rider_stand_bow_3"
				require_free_left_hand="True"
				required_mount_action="act_camel_stand_3" />
			<rider_idle
				mount_id="camel"
				pace="1"
				action="act_camel_rider_stand_bow_4"
				require_free_left_hand="True"
				required_mount_action="act_camel_stand_4" />
			<rider_idle
				mount_id="camel"
				pace="1"
				action="act_camel_rider_stand_bow_5"
				require_free_left_hand="True"
				required_mount_action="act_camel_stand_5" />
			<rider_idle
				mount_id="horse"
				pace="0"
				action="act_rider_stand_bow_pace_0"
				require_free_left_hand="True" />
			<rider_idle
				mount_id="horse"
				pace="1"
				action="act_rider_stand_bow_pace_1"
				require_free_left_hand="True" />
			<rider_idle
				mount_id="horse"
				pace="2"
				action="act_rider_stand_bow_pace_2"
				require_free_left_hand="True" />
			<rider_idle
				mount_id="horse"
				pace="3"
				action="act_rider_stand_bow_pace_3"
				require_free_left_hand="True" />
			<rider_idle
				mount_id="horse"
				pace="4"
				action="act_rider_stand_bow_pace_4"
				require_free_left_hand="True" />
			<rider_idle
				mount_id="horse"
				pace="5"
				action="act_rider_stand_bow_pace_5"
				require_free_left_hand="True" />
			<rider_idle
				mount_id="camel"
				pace="0"
				action="act_camel_rider_stand_bow_pace_0"
				require_free_left_hand="True" />
			<rider_idle
				mount_id="camel"
				pace="1"
				action="act_camel_rider_stand_bow_pace_1"
				require_free_left_hand="True" />
			<rider_idle
				mount_id="camel"
				pace="2"
				action="act_camel_rider_stand_bow_pace_2"
				require_free_left_hand="True" />
