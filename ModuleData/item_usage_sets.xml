				require_free_left_hand="False"
				strike_type="thrust" />
			<usage
				style="attack_any"
				reload_action="act_reload_bow_right_horseback"
				ready_action="act_ready_bow_horseback"
				release_action="act_release_bow_horseback"
				ready_continue_ranged_action="act_ready_continue_bow_horseback"
				ready_continue_shake_action="act_ready_continue_bow_shake_horseback"
				is_mounted="True"
				require_free_left_hand="False"
				strike_type="thrust" />
		</usages>
	</item_usage_set>
</item_usage_sets>
