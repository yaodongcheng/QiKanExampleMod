				mount_id="camel"
				pace="3"
				action="act_camel_rider_stand_bow_pace_3"
				require_free_left_hand="True" />
			<rider_idle
				mount_id="camel"
				pace="4"
				action="act_camel_rider_stand_bow_pace_4"
				require_free_left_hand="True" />
