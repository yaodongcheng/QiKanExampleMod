  <!-- ── 版本检测 + 累积阈值宏 ──
    每台电脑只装一个版本，编译时自动检测 Version.xml：
      v1.2.12 → MB2_V1212
      v1.3.x  → MB2_GE_130
      v1.4.x  → MB2_GE_130 + MB2_GE_140
      v1.5.x  → MB2_GE_130 + MB2_GE_140 + MB2_GE_150

    GE = "Greater or Equal"。每个 GE 宏表示『从这个版本开始可用』。
    代码中按阈值从高到低写分支：#if MB2_GE_150 / #elif MB2_GE_140 / #elif MB2_GE_130 / #else。
    🔴 MB2_V1212 是【精确匹配】v1.2.12（判定 = Version.xml.Contains('v1.2.12')，非累积）——
       语义 = "v1.2.12 机器专用分支"；#else 分支即 "≤ v1.2.12"（v1.2.12 是支持的最低版本）。
    🔴 2026-08-23：开发机已升级 v1.5.1（Latest），编译验证 1.5.x 与 1.4.x API 签名一致，
       MB2_GE_150 已自动定义但尚无代码分支使用（后续发现 1.5.x 独有差异时直接加 #if MB2_GE_150 即可）。

    新增版本时（如 v1.6.0）：
    1. 加 <MB2_IsV16x> 侦测
    2. 所有现有 GE_* 的 Or 链上追加 '$(MB2_IsV16x)' == 'true'
    3. 加 MB2_GE_160 的 DefineConstants
  ── -->
  <PropertyGroup>
    <MB2_VersionFile>$(MB2_PATH)\bin\Win64_Shipping_Client\Version.xml</MB2_VersionFile>
    <MB2_VersionFileContent Condition="Exists('$(MB2_VersionFile)')">$([System.IO.File]::ReadAllText('$(MB2_VersionFile)'))</MB2_VersionFileContent>
    <!-- 版本系列侦测（精确到 minor） -->
    <MB2_IsV12x Condition="$(MB2_VersionFileContent.Contains('v1.2.'))">true</MB2_IsV12x>
    <MB2_IsV13x Condition="$(MB2_VersionFileContent.Contains('v1.3.'))">true</MB2_IsV13x>
    <MB2_IsV14x Condition="$(MB2_VersionFileContent.Contains('v1.4.'))">true</MB2_IsV14x>
    <MB2_IsV15x Condition="$(MB2_VersionFileContent.Contains('v1.5.'))">true</MB2_IsV15x>
  </PropertyGroup>
  <!-- 公共版本宏（Debug / Release 共享；各配置 DefineConstants 引用 $(MB2_VersionDefines)） -->
  <PropertyGroup>
    <MB2_VersionDefines>
    </MB2_VersionDefines>
    <MB2_VersionDefines Condition="$(MB2_VersionFileContent.Contains('v1.2.12'))">$(MB2_VersionDefines);MB2_V1212</MB2_VersionDefines>
    <!-- MB2_GE_130: v1.3.x 或更高 -->
    <MB2_VersionDefines Condition="'$(MB2_IsV13x)' == 'true' Or '$(MB2_IsV14x)' == 'true' Or '$(MB2_IsV15x)' == 'true'">$(MB2_VersionDefines);MB2_GE_130</MB2_VersionDefines>
    <!-- MB2_GE_140: v1.4.x 或更高 -->
    <MB2_VersionDefines Condition="'$(MB2_IsV14x)' == 'true' Or '$(MB2_IsV15x)' == 'true'">$(MB2_VersionDefines);MB2_GE_140</MB2_VersionDefines>
    <!-- MB2_GE_150: v1.5.x 或更高（2026-08-23 开发机升级 v1.5.1：编译验证 1.5.x 与 1.4.x 签名一致，尚无代码分支使用） -->
    <MB2_VersionDefines Condition="'$(MB2_IsV15x)' == 'true'">$(MB2_VersionDefines);MB2_GE_150</MB2_VersionDefines>
  </PropertyGroup>
  <!-- Debug：自动检测 -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(MB2_PATH)\Modules\LivingWorldNpcs\bin\Win64_Shipping_Client\</OutputPath>
    <!-- 🔴 _RGL_KEEP_ASSERTS：启用 MBDebug.RenderDebug* 调试绘制通道（NavMeshDebugMissionView 用）。
         官方这些方法全带 [Conditional("_RGL_KEEP_ASSERTS")]，不定义此符号 = 调用点被编译器静默剥离
         （代码编译通过但画面什么都不显示，2026-09-10 NavMesh 调试可视化实锤）。 -->
    <DefineConstants>DEBUG;TRACE;_RGL_KEEP_ASSERTS;$(MB2_VersionDefines)</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>3</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <!-- Release：同上，去掉 DEBUG -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE;_RGL_KEEP_ASSERTS;$(MB2_VersionDefines)</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
