  <!-- ── 自动检测游戏版本：读 Version.xml ──
    定义精确版本宏：MB2_V1212 / MB2_V146 / ...
    代码用 #if !MB2_V1212 判断"比 1.2.12 新"，用 #if MB2_V146 判断"恰好 1.4.6"
    新增版本时加一行 DefineConstants 即可。
  ── -->
  <PropertyGroup>
    <MB2_VersionFile>$(MB2_PATH)\bin\Win64_Shipping_Client\Version.xml</MB2_VersionFile>
    <MB2_VersionFileContent Condition="Exists('$(MB2_VersionFile)')">$([System.IO.File]::ReadAllText('$(MB2_VersionFile)'))</MB2_VersionFileContent>
  </PropertyGroup>
  <!-- Debug：自动检测 -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(MB2_PATH)\Modules\LivingWorldNpcs\bin\Win64_Shipping_Client\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <!-- 精确版本宏：按 Version.xml 中的版本号定义（新增版本时在这里加一行） -->
    <DefineConstants Condition="$(MB2_VersionFileContent.Contains('v1.2.12'))">$(DefineConstants);MB2_V1212</DefineConstants>
    <DefineConstants Condition="$(MB2_VersionFileContent.Contains('v1.4.6'))">$(DefineConstants);MB2_V146</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>3</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <!-- Release：同上，去掉 DEBUG -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="$(MB2_VersionFileContent.Contains('v1.2.12'))">$(DefineConstants);MB2_V1212</DefineConstants>
    <DefineConstants Condition="$(MB2_VersionFileContent.Contains('v1.4.6'))">$(DefineConstants);MB2_V146</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!-- Debug_v1.2.12：手动兜底，强制 v1.2.12 模式 -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug_v1.2.12|AnyCPU' ">
