    <MB2_CORE_REF>$(MB2_PATH)\bin\Win64_Shipping_Client</MB2_CORE_REF>
    <MB2_SANDBOX_REF>$(MB2_PATH)\Modules\SandBox\bin\Win64_Shipping_Client</MB2_SANDBOX_REF>
    <MB2_NATIVE_REF>$(MB2_PATH)\Modules\Native\bin\Win64_Shipping_Client</MB2_NATIVE_REF>
