				<transform position="0.000, 0.000, 1.700" rotation_euler="0.000, 0.000, 0.000"/>
				<components>
					<particle_system_instanced_component>
						<effect_ref base_effect="{F317DD65-3109-423C-BA33-9BE17DEE34BB}"/>
					</particle_system_instanced_component>
				</components>
			</game_entity>
			<game_entity name="rasengan_core" old_prefab_name="" mobility="1">
